+;; Suss patch: expand only in the macro (Clojure) phase; stock ClojureScript
+;; otherwise analyzes this macro body as runtime code.
+#?(:clj
+ (defmacro when-var-exists [var-sym & body]
+   (let [cljs? (some? (:ns &env))
+         exists? (boolean (if cljs?
+                            ((resolve 'cljs.analyzer.api/resolve) &env var-sym)
+                            (resolve var-sym)))]
+     (if exists?
+       `(do
+          ~@body)
+       `(println "SKIP -" '~var-sym)))))
 
