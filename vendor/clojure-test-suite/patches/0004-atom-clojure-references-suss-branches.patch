# https://mozilla.org/MPL/2.0/. Adapts jank-lang/clojure-test-suite for the Suss harness:
# :suss branches select Clojure's assertions for atom options (#30), which reject
# a non-map :meta and validate the initial value, and check atoms with Suss's
# atom type, (type (atom nil)), where the suite names clojure.lang.Atom (#334).
# Until #335 the row holding the ratio 111/7 uses the string from the :cljs
# branch: evaluating the ratio throws before the row's inner assertion runs,
# which would misalign every assertion in test-atom.
--- a/test/clojure/core_test/atom.cljc
+++ b/test/clojure/core_test/atom.cljc
@@ -9,7 +9,8 @@
       (let [nil-atm  (atom nil)
             nil-atm2 (atom nil nil nil)
             nil-atm3 (apply atom (take 11 (repeat nil)))]
-        #?(:cljs (is (every? #(satisfies? cljs.core/IAtom %) [nil-atm nil-atm2 nil-atm3]))
+        #?(:suss (is (every? #(instance? (type (atom nil)) %) [nil-atm nil-atm2 nil-atm3]))
+           :cljs (is (every? #(satisfies? cljs.core/IAtom %) [nil-atm nil-atm2 nil-atm3]))
            :clj (is (every? (partial instance? clojure.lang.Atom) [nil-atm nil-atm2 nil-atm3])))
         (is (every? nil? (map deref [nil-atm nil-atm2 nil-atm3])))))
 
@@ -27,13 +28,16 @@
         (is (= {:a "a"} (meta (atom nil :meta (array-map :a "a"))))))
       (when-var-exists clojure.core/hash-map
         (is (= {:a "a"} (meta (atom nil :meta (hash-map :a "a"))))))
-      #?(:lpy (is (= 5 (meta (atom nil :meta 5))))
+      #?(:suss (is (p/thrown? (atom nil :meta 5)))
+         :lpy (is (= 5 (meta (atom nil :meta 5))))
          :cljs (is (= 5 (meta (atom nil :meta 5))))
          :default (is (p/thrown? (atom nil :meta 5))))
-      #?(:lpy (is (= #{} (meta (atom nil :meta #{}))))
+      #?(:suss (is (p/thrown? (atom nil :meta #{})))
+         :lpy (is (= #{} (meta (atom nil :meta #{}))))
          :cljs (is (= #{} (meta (atom nil :meta #{}))))
          :default (is (p/thrown? (atom nil :meta #{}))))
-      #?(:lpy (is (= [] (meta (atom nil :meta (vector)))))
+      #?(:suss (is (p/thrown? (atom nil :meta (vector))))
+         :lpy (is (= [] (meta (atom nil :meta (vector)))))
          :cljs (is (= [] (meta (atom nil :meta (vector)))))
          :default (is (p/thrown? (atom nil :meta (vector))))))
 
@@ -73,21 +77,25 @@
           (is (= 3 (deref atm)))))
 
       (testing "always-falsey validator can't initialize atom"
-        #?(:cljs (testing "Broken but current behavior due to CLJS-3447"
+        #?(:suss (is (p/thrown? (atom {} :validator (constantly nil))))
+           :cljs (testing "Broken but current behavior due to CLJS-3447"
                    ;; FIXME when https://clojure.atlassian.net/browse/CLJS-3447 is fixed
                    (is (= {} (deref (atom {} :validator (constantly nil))))))
            :default (is (p/thrown? (atom {} :validator (constantly nil)))))
-        #?(:cljs (testing "Broken but current behavior due to CLJS-3447"
+        #?(:suss (is (p/thrown? (atom {} :validator (constantly false))))
+           :cljs (testing "Broken but current behavior due to CLJS-3447"
                    ;; FIXME when https://clojure.atlassian.net/browse/CLJS-3447 is fixed
                    (is (= {} (deref (atom {} :validator (constantly false))))))
            :default (is (p/thrown? (atom {} :validator (constantly false)))))
-        #?(:cljs (testing "Broken but current behavior due to CLJS-3447"
+        #?(:suss (is (p/thrown? (atom {} :validator #(when true (throw (ex-info "boom" {}))))))
+           :cljs (testing "Broken but current behavior due to CLJS-3447"
                    ;; FIXME when https://clojure.atlassian.net/browse/CLJS-3447 is fixed
                    (is (= {} (deref (atom {} :validator #(when true (throw (ex-info "boom" {}))))))))
            :default (is (p/thrown? (atom {} :validator #(when true (throw (ex-info "boom" {}))))))))
 
       (testing "conditional validators are obeyed at creation, swap! and reset!"
-        #?(:cljs (testing "Broken but current behavior due to CLJS-3447"
+        #?(:suss (is (p/thrown? (atom #{} :validator (fn [v] (some string? v)))))
+           :cljs (testing "Broken but current behavior due to CLJS-3447"
                    ;; FIXME when https://clojure.atlassian.net/browse/CLJS-3447 is fixed
                    (is (= #{} (deref (atom #{} :validator (fn [v] (some string? v)))))))
            :default (is (p/thrown? (atom #{} :validator (fn [v] (some string? v))))))
@@ -122,15 +130,15 @@
     (testing "atom accepts all values"
       (are [v] (let [the-atom (atom v)]
                  (and (= v (deref the-atom))
-                      #?(:cljs (is (satisfies? cljs.core/IAtom the-atom))
+                      #?(:suss (is (instance? (type (atom nil)) the-atom))
+                         :cljs (is (satisfies? cljs.core/IAtom the-atom))
