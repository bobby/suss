package suss:lang;

/// Core Suss types shared across components
interface types {
    /// Source location span
    record span {
        start: u32,
        end: u32,
    }

    /// Arbitrary precision integer (two's complement, little-endian bytes)
    record bigint {
        bytes: list<u8>,
        negative: bool,
    }

    /// Exact ratio of two bigints
    record ratio {
        numer: bigint,
        denom: bigint,
    }

    /// Numeric values
    variant number {
        integer(bigint),
        ratio(ratio),
        float(f64),
    }

    /// Interned symbol ID (index into symbol table)
    type symbol-id = u32;

    /// Interned keyword ID (index into keyword table)
    type keyword-id = u32;

    /// Parse error with recovery hints
    record parse-error {
        message: string,
        span: span,
        expected: list<string>,
    }

    /// Runtime error during evaluation
    record eval-error {
        message: string,
        backtrace: list<string>,
    }

    /// S-expression resource - an opaque handle to an AST node
    /// Owned by the reader component, can be borrowed by evaluator
    resource sexp {
        /// Get a string representation of this s-expression
        to-string: func() -> string;

        /// Check if this is nil
        is-nil: func() -> bool;

        /// Check if this is truthy (not nil or false)
        is-truthy: func() -> bool;
    }
}
