;; Original portable numeric-Date storage, not copied upstream source.
;; Internal bootstrap construction accepts numeric milliseconds only; calendar,
;; timezone/string parsing, reader instants and full Inst semantics remain pending.
(deftype BootstrapDate [milliseconds]
  Object
  (valueOf [_] milliseconds))
(def date-from-ms
  (fn [milliseconds]
    (BootstrapDate. (suss.bootstrap/f64-time-clip milliseconds))))

