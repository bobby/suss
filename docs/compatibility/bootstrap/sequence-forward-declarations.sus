;; Original loader declarations for retained source's mutual references.
;; Pending helpers remain uninitialized and fail if invoked; no fake implementations.
(declare List EmptyList Cons IndexedSeq seq first rest next prim-seq array-seq cons count
  counted? list? sequential? accumulating-seq-count empty-ordered-hash
  Reduced reduced reduced? ensure-reduced unreduced deref iterable? iter-reduce reduce
  pr-str* -indexOf -lastIndexOf equiv-sequential = hash-ordered-coll seq-reduce
  array-reduce IndexedSeqIterator RSeq indexed? neg? linear-traversal-nth nth str_ type type->str MetaFn apply with-meta meta Symbol Keyword hash-symbol hash-keyword get -write)


;; Original portable numeric-Date storage, not copied upstream source.
;; Internal bootstrap construction accepts numeric milliseconds only; calendar,
;; timezone/string parsing, reader instants and full Inst semantics remain pending.
(deftype BootstrapDate [milliseconds]
  Object
  (valueOf [_] milliseconds))
(def date-from-ms
  (fn [milliseconds]
    (BootstrapDate. (suss.bootstrap/f64-time-clip milliseconds))))

(declare PersistentVector MapEntry TransientVector tv-editable-root tv-editable-tail chunked-seq integer? js-mod)

(declare array-copy tv-ensure-editable tv-push-tail tv-pop-tail unchecked-editable-array-for transient persistent! conj!)
