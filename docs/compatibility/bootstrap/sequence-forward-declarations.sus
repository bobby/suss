;; Original GC-owned UTF-16 storage for the retained printer's string writes.
;; This is not an implementation of Closure's general interop StringBuffer API.
;; The writer retains its actual buffer result, not an atom or a host-side ID.
(deftype BootstrapStringBuffer [^:mutable contents]
  Object
  (append [this text]
    (set! (.-contents this) (suss.bootstrap/concat-string contents text))
    this)
  (toString [_] contents))

