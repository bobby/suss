;; Original Suss WIT integer foundations, not extracted upstream source.
;; Exact storage uses two unsigned 32-bit words in the existing nominal ABI.
;; Decimal parsing never converts the complete integer through binary64.
(deftype WitSigned64 [high low])
(deftype WitUnsigned64 [high low])
(def wit-valid-word?
  (let [number? number?]
    (fn [word]
    (if (number? word)
      (if (<= 0 word)
        (if (<= word 4294967295)
          (== word (suss.bootstrap/f64-floor word)) false) false) false))))
(def wit-checked-words
  (let [signed-class WitSigned64 unsigned-class WitUnsigned64 valid-word wit-valid-word?]
    (fn [value]
      (if (if (instance? signed-class value) true (instance? unsigned-class value))
        (let [high (.-high value) low (.-low value)]
          (if (if (valid-word high) (valid-word low) false)
            (array high low)
            (throw (suss.bootstrap/error "Invalid exact integer 64-bit word storage"))))
        (throw (suss.bootstrap/error "Expected exact integer 64-bit wrapper"))))))
(def wit-parse-words
  (fn [text signed]
    (if (string? text)
      (let [length (count text)]
        (if (zero? length)
          (throw (suss.bootstrap/error "Expected decimal string for exact integer 64-bit constructor"))
          (let [negative (== (.charCodeAt text 0) 45)
                first (if negative 1 0)]
            (if (if negative (if signed false true) false)
              (throw (suss.bootstrap/error "Unsigned 64-bit constructor rejects negative input"))
              (if (== first length)
                (throw (suss.bootstrap/error "Expected decimal digits for exact integer 64-bit constructor"))
                (loop [index first high 0 low 0]
                  (if (< index length)
                    (let [digit (- (.charCodeAt text index) 48)]
                      (if (if (<= 0 digit) (<= digit 9) false)
                        (let [wide-low (+ (* low 10) digit)
                              carry (suss.bootstrap/f64-floor (/ wide-low 4294967296))
                              next-low (- wide-low (* carry 4294967296))
                              next-high (+ (* high 10) carry)]
                          (if (> next-high 4294967295)
                            (throw (suss.bootstrap/error "Exact integer 64-bit decimal input out of range"))
                            (recur (inc index) next-high next-low)))
                        (throw (suss.bootstrap/error "Invalid decimal digit for exact integer 64-bit constructor"))))
                    (if signed
                      (if negative
                        (if (if (< high 2147483648) true
                              (if (== high 2147483648) (zero? low) false))
                          (if (if (zero? high) (zero? low) false)
                            (array 0 0)
                            (if (zero? low)
                              (array (- 4294967296 high) 0)
                              (array (- 4294967295 high) (- 4294967296 low))))
                          (throw (suss.bootstrap/error "Signed 64-bit decimal input out of range")))
                        (if (< high 2147483648) (array high low)
                          (throw (suss.bootstrap/error "Signed 64-bit decimal input out of range"))))
                      (array high low)))))))))
      (throw (suss.bootstrap/error "Expected decimal string for exact integer 64-bit constructor")))))
(def wit-s64
  (let [class WitSigned64 parse wit-parse-words get aget]
    (fn [text]
      (let [words (parse text true)]
        (new class (get words 0) (get words 1))))))
(def wit-u64
  (let [class WitUnsigned64 parse wit-parse-words get aget]
    (fn [text]
      (let [words (parse text false)]
        (new class (get words 0) (get words 1))))))
(def wit-s64? (let [class WitSigned64] (fn [value] (instance? class value))))
(def wit-u64? (let [class WitUnsigned64] (fn [value] (instance? class value))))
(def wit-to-number
  (let [signed-class WitSigned64 checked wit-checked-words get aget]
    (fn [value]
      (let [words (checked value) high (get words 0) low (get words 1)
            negative (if (instance? signed-class value) (>= high 2147483648) false)
            magnitude-high (if negative
                             (if (zero? low) (- 4294967296 high) (- 4294967295 high)) high)
            magnitude-low (if negative (if (zero? low) 0 (- 4294967296 low)) low)]
        (if (< magnitude-high 2097152)
          (let [number (+ (* magnitude-high 4294967296) magnitude-low)]
            (if negative (- number) number))
          (throw (suss.bootstrap/error "Exact integer 64-bit wit-to-number exceeds safe binary64 integer range")))))))

;; Original Suss UTF-16 storage helper for keyword's fixed slash split only.
;; Every empty/trailing part is retained. This is not general JS String.split.
(def ^:private keyword-name-parts
  (fn [text]
    (let [parts (array) length (count text)]
      (loop [index 0 start 0]
        (if (< index length)
          (if (== (.charCodeAt text index) 47)
            (do (.push parts (suss.bootstrap/string-slice text start index))
                (recur (inc index) (inc index)))
            (recur (inc index) start))
          (do (.push parts (suss.bootstrap/string-slice text start length)) parts))))))

;; Original Suss adaptation: read the source closure's owned UTF16 label.
(def ^:private pr-function-name (fn [function] (suss.bootstrap/function-name function)))

;; Original Suss adaptation of java.lang.Object/toString, which records inherit
;; in Clojure: the class label, "@" and the unsigned 32-bit hash in lower-case
;; hexadecimal. Suss's hash replaces the JVM hashCode (#285).
(def ^:private object-string
  (fn [label value]
    (loop [n (unsigned-bit-shift-right (hash value) 0) digits ""]
      (let [low (- n (* 16 (quot n 16)))
            digits (suss.bootstrap/concat-string
                     (suss.bootstrap/string-slice "0123456789abcdef" low (inc low)) digits)
            n (quot n 16)]
        (if (zero? n)
          (suss.bootstrap/concat-string label (suss.bootstrap/concat-string "@" digits))
          (recur n digits))))))

;; Copyright The Closure Library Authors.
;; SPDX-License-Identifier: Apache-2.0
;; Adapted from the complete goog/string/stringbuffer.js retained beside this
;; file. Native owned storage replaces the Closure prototype buffer slot.
;; All constructor and method branches remain; this is not JS prototype interop.
(def bootstrap-buffer-to-array to-array)
(deftype BootstrapStringBuffer [^:mutable buffer_]
  Object
  (set [this & values]
    (let [args (bootstrap-buffer-to-array values) s (aget args 0)]
      (set! buffer_ (suss.bootstrap/value-add "" s))
      (aget (array) 0)))
  (append [this & values]
    (let [args (bootstrap-buffer-to-array values)
          old buffer_
          first-value (aget args 0)
          converted (suss.bootstrap/coerce-string first-value)]
      (set! buffer_ (suss.bootstrap/value-add old converted))
      (if (suss.bootstrap/nil? (aget args 1))
        nil
        (loop [i 1]
          (if (< i (alength args))
            (let [old buffer_ value (aget args i)]
              (set! buffer_ (suss.bootstrap/value-add old value))
              (recur (inc i)))
            nil)))
      this))
  (clear [this & ignored]
    (set! buffer_ "")
    (aget (array) 0))
  (getLength [this & ignored] (.-length buffer_))
  (toString [this & ignored] buffer_))
(def bootstrap-string-buffer
  (fn [& values]
    (let [args (bootstrap-buffer-to-array values) sb (BootstrapStringBuffer. "")]
      (if (suss.bootstrap/nil? (aget args 0))
        nil
        (.apply (.-append sb) sb args))
      sb)))

;; Original Suss implementation of runtime namespaces (#309), following
;; clojure.lang.Namespace and clojure.core's namespace functions. The compiler
;; publishes each namespace's scope here: aliases, refers, excluded core names
;; and declarations, per phase. Values are data, not Vars. Name sets are kept
;; as space-padded strings (symbol names contain no spaces) and searched for
;; " name ", so publishing a definition appends text instead of building sets.
(def ^:private padded-names
  (fn [text] (suss.bootstrap/concat-string " " (suss.bootstrap/concat-string text " "))))
(def ^:private names-contain?
  (fn [names name] (<= 0 (suss.bootstrap/string-index-of names (padded-names name)))))
(deftype Namespace [name ^:mutable aliases ^:mutable macro-aliases ^:mutable refers
                    ^:mutable macro-refers ^:mutable excluded ^:mutable bootstrap-macros
                    ^:mutable reader-names ^:mutable declared]
  Object
  (toString [_] (str name))
  (publish [this scope text]
    (if (nil? scope)
      nil
      (do (set! aliases (:aliases scope))
          (set! macro-aliases (:macro-aliases scope))
          (set! refers (:refers scope))
          (set! macro-refers (:macro-refers scope))
          (set! excluded (padded-names (:excluded scope)))
          (set! bootstrap-macros (padded-names (get scope :bootstrap-macros "")))
          (set! reader-names (padded-names (get scope :reader-names "")))))
    (if (nil? text)
      nil
      (set! declared (suss.bootstrap/concat-string declared (suss.bootstrap/concat-string text " "))))
    this)
  (aliasTarget [_ alias]
    (let [target (get aliases alias)] (if (nil? target) (get macro-aliases alias) target)))
  (aliasMap [_] aliases)
  (referMap [_] refers)
  (referred [_ sym] (get refers sym))
  (macroReferred [_ sym] (get macro-refers sym))
  (declares [_ text] (names-contain? declared text))
  (excludes [_ text] (names-contain? excluded text))
  (coreMacro [_ text]
    (if (names-contain? bootstrap-macros text) true (names-contain? reader-names text)))
  IEquiv
  (-equiv [this other] (identical? this other))
  IHash
  (-hash [this] (suss.bootstrap/identity-uid this))
  IPrintWithWriter
  (-pr-writer [this writer opts]
    (let [label (object-string "" this)]
      (-write writer (str "#object[suss.core.Namespace 0x"
                          (suss.bootstrap/string-slice label 1 (.-length label))
                          " \"" name "\"]")))))
;; Programs have few namespaces, and a scan comparing name strings costs far
;; less than hashing a symbol, so every fragment can afford to publish.
(def ^:private namespace-registry (array))
(def ^:private registered-namespace
  (fn [name]
    (let [text (.-str name) length (alength namespace-registry)]
      (loop [index 0]
        (if (< index length)
          (let [ns (aget namespace-registry index)]
            (if (= text (.-str (.-name ns))) ns (recur (inc index))))
          nil)))))
(def ^:private intern-namespace
  (fn [name]
    (if (symbol? name)
      (let [found (registered-namespace name)]
        (if (nil? found)
          (let [created (Namespace. name {} {} {} {} " " " " " " " ")]
            (.push namespace-registry created)
            created)
          found))
      (throw (suss.bootstrap/error "Namespace name must be a symbol")))))
;; Called by compiled fragments: replace the namespace's scope when given and
;; add newly declared names. Returns the namespace.
(def ^:private publish-namespace!
  (fn [name scope declared] (.publish (intern-namespace name) scope declared)))
(def ^{:dynamic true
       :doc "A suss.core.Namespace object representing the current namespace."}
  *ns* (intern-namespace 'suss.core))
;; The macro host sets *ns*'s root to the namespace being compiled before it
;; calls a macro, as Clojure's compiler binds *ns* while it loads (#309). It
;; keeps the namespace objects intern-namespace returns.
(def ^:private enter-macro-namespace!
  (fn [ns] (set! *ns* ns) nil))
(def find-ns
  (fn [sym] (if (symbol? sym) (registered-namespace sym) nil)))
(def the-ns
  (fn [x]
    (if (instance? Namespace x)
      x
      (let [found (find-ns x)]
        (if (nil? found)
          (throw (ex-info (str "No namespace: " x " found") {}))
          found)))))
(def ns-name
  (fn [ns] (.-name (the-ns ns))))
(def all-ns
  (fn [] (seq (aclone namespace-registry))))
(def ns-aliases
  (fn [ns]
    (reduce-kv (fn [m alias target] (assoc m alias (intern-namespace target)))
               {} (.aliasMap (the-ns ns)))))
;; Clojure maps each referred symbol to its Var. Suss has no runtime Vars, so
;; the value is the fully qualified symbol the name refers to.
(def ns-refers
  (fn [ns] (.referMap (the-ns ns))))
;; The compiler's syntax-quote symbol resolution (syntax_quote.rs `resolve`),
;; against *ns*. suss.core resolves to cljs.core, as the compiler writes it.
(def ^:private reader-core-namespace
  (fn [namespace] (if (if (= namespace "suss.core") true (= namespace "clojure.core")) "cljs.core" namespace)))
(def ^:private reader-resolve-symbol
  (fn [sym]
    (let [ns *ns*
          name (.-name sym)
          namespace (.-ns sym)]
      (if (nil? namespace)
        (if (<= 0 (suss.bootstrap/string-index-of name "."))
          sym
          (let [excluded (.excludes ns name)
                referred (.referred ns sym)]
            (if (some? referred)
              (symbol (reader-core-namespace (.-ns referred)) (.-name referred))
              (if (.declares ns name)
                (symbol (str (.-name ns)) name)
                (if (if excluded false (.declares (intern-namespace 'suss.core) name))
                  (symbol "cljs.core" name)
                  (let [macro-referred (.macroReferred ns sym)]
                    (if (some? macro-referred)
                      (symbol (reader-core-namespace (.-ns macro-referred)) (.-name macro-referred))
                      (if (if excluded false (.coreMacro (intern-namespace 'suss.core) name))
                        (symbol "cljs.core" name)
                        (symbol (str (.-name ns)) name)))))))))
        (let [target (.aliasTarget ns (symbol namespace))]
          (symbol (reader-core-namespace (if (nil? target) namespace (str target))) name))))))
