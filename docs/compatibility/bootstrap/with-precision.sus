;; Clojure 1.12.6 clojure.core/with-precision adaptation. Rich Hickey;
;; Eclipse Public License 1.0. See runtime/core-import/LICENSE and
;; docs/compatibility/bootstrap/clojure-decimal-context.json for source hashes.
;; Preserve lexical body evaluation and the ordinary dynamic Var binding.
;; Replace Java MathContext/RoundingMode construction with immutable native GC
;; fields and the complete eight-mode table; no Java dependency is shipped.
;   Copyright (c) Rich Hickey. All rights reserved.
;   The use and distribution terms for this software are covered by the
;   Eclipse Public License 1.0 (http://opensource.org/licenses/eclipse-1.0.php)
;   which can be found in the file epl-v10.html at the root of this distribution.
;   By using this software in any fashion, you are agreeing to be bound by
;   the terms of this license.
;   You must not remove this notice, or any other, from this software.
(defmacro with-precision [precision & body]
  (let [explicit? (= (first body) :rounding)
        modes {'UP 0 'DOWN 1 'CEILING 2 'FLOOR 3 'HALF_UP 4
               'HALF_DOWN 5 'HALF_EVEN 6 'UNNECESSARY 7}
        rounding (if explicit? (get modes (second body)) nil)
        expressions (if explicit? (next (next body)) body)]
    (if (and explicit? (nil? rounding)) (throw (ex-info "Invalid rounding mode" {})) nil)
    `(binding [*math-context* (suss.bootstrap/math-context-new ~precision ~rounding)]
       ~@expressions)))
