;; core.sus - Suss core library
;;
;; This file is automatically loaded before user code (per Clojure semantics).
;; Contains protocol definitions and implementations for built-in types.

(ns suss.core)

;; ============================================================
;; Protocol Definitions
;;
;; Type hints: ^i32 for methods returning raw i32 (count, hash, equiv)
;;             ^eqref for methods returning boxed values (default)
;; ============================================================

(defprotocol ICounted
  "Protocol for countable collections."
  (^i32 -count [coll]))

(defprotocol IIndexed
  "Protocol for indexed random access."
  (-nth [coll n] [coll n not-found]))

(defprotocol ISeq
  "Protocol for sequential access."
  (-first [coll])
  (-rest [coll]))

(defprotocol ISeqable
  "Protocol for conversion to seq."
  (-seq [coll]))

(defprotocol ILookup
  "Protocol for key-based lookup."
  (-lookup [coll key] [coll key not-found]))

(defprotocol IAssociative
  "Protocol for associative structures."
  (-assoc [coll key val])
  (^i32 -contains-key [coll key]))

(defprotocol ICollection
  "Protocol for adding elements."
  (-conj [coll o]))

(defprotocol IEquiv
  "Protocol for equality testing."
  (^i32 -equiv [x y]))

(defprotocol IHash
  "Protocol for hashing."
  (^i32 -hash [o]))

(defprotocol IFn
  "Protocol for invocable objects.
   Allows collections to be used as functions for lookup."
  (-invoke [coll k] [coll k not-found]))

;; ============================================================
;; Helper Functions for Vector Trie Operations
;; ============================================================

(defn tail-off
  "Calculate the start index of the tail array for a vector.
   For vectors with < 32 elements, tail starts at 0.
   For larger vectors, tail starts at the last 32-aligned boundary."
  [cnt]
  (if (< cnt 32)
    0
    (bit-shift-left (unsigned-bit-shift-right (- cnt 1) 5) 5)))

(defn array-for
  "Get the leaf array containing the element at index i.
   Traverses from root down through 32-way trie levels."
  [pv i]
  (let [cnt (.-cnt pv)
        tail (.-tail pv)]
    (if (>= i (tail-off cnt))
      ;; Element is in the tail
      tail
      ;; Element is in the tree - traverse down
      (loop [node (.-root pv)
             level (.-shift pv)]
        (if (> level 0)
          (recur (aget node (bit-and (unsigned-bit-shift-right i level) 31))
                 (- level 5))
          node)))))

(defn new-path
  "Create a path of trie nodes from the given level down to the leaf node.
   Each level creates a 32-slot array with the child at index 0."
  [level node]
  (if (= level 0)
    node
    (let [ret (make-array 32)]
      (aset ret 0 (new-path (- level 5) node))
      ret)))

(defn push-tail
  "Push a tail node into the tree, growing it if necessary.
   Returns the new root node."
  [pv level parent tailnode]
  (let [subidx (bit-and (unsigned-bit-shift-right (- (.-cnt pv) 1) level) 31)
        ret (aclone parent)]
    (if (= level 5)
      ;; At the deepest internal level - insert tailnode directly
      (do (aset ret subidx tailnode) ret)
      ;; Higher level - recurse down
      (let [child (aget parent subidx)]
        (if (nil? child)
          ;; No child exists - create new path
          (do (aset ret subidx (new-path (- level 5) tailnode)) ret)
          ;; Child exists - recurse into it
          (do (aset ret subidx (push-tail pv (- level 5) child tailnode)) ret))))))

;; ============================================================
;; HAMT Helper Functions (for maps and sets)
;; ============================================================

(defn hamt-mask
  "Extract 5 bits from hash at the given shift level (0, 5, 10, ...)."
  [hash shift]
  (bit-and (unsigned-bit-shift-right hash shift) 31))

(defn hamt-bitpos
  "Calculate bit position for a hash value at a given shift level."
  [hash shift]
  (bit-shift-left 1 (hamt-mask hash shift)))

(defn hamt-index
  "Calculate index into the array for a given bitmap and bit position.
   Uses population count to find how many entries precede this position."
  [bitmap bit]
  (bit-count (bit-and bitmap (- bit 1))))

;; ============================================================
;; Core Collection Types (dynamically assigned GC type indices)
;; ============================================================
;; These types get GC indices starting at NUM_GC_TYPES (19).
;; The compiler no longer has hardcoded struct layouts for collections.

;; Cons cell for lists
;; Note: _marker field distinguishes Cons from other 2-field types (MapEntry)
;; due to WASM GC structural typing
(deftype Cons [first rest ^i32 _marker])

;; Persistent Vector (32-way trie with tail optimization)
(deftype PersistentVector [^i32 cnt ^i32 shift root tail])

;; Persistent Map (HAMT)
(deftype PersistentMap [^i32 map-cnt map-root])

;; Persistent Set (HAMT with marker for structural distinction)
(deftype PersistentSet [^i32 set-cnt set-root ^i32 _marker])

;; Sentinel type for distinguishing "key not found" from "key exists with nil value"
(deftype NotFound [])

;; ============================================================
;; HAMT Node Types (for maps and sets)
;; ============================================================
;; Field names are prefixed to disambiguate when accessed via .-field
;; since multiple types have fields named "arr" and "cnt".

(deftype BitmapIndexedNode [^i32 bitmap bin-arr])
(deftype ArrayNode [^i32 an-cnt an-arr])
(deftype HashCollisionNode [^i32 hash ^i32 hcn-cnt hcn-arr])

;; ============================================================
;; HAMT Node Traversal Functions
;; ============================================================

;; Forward declarations for mutual recursion
;; (inode-find is called by bin-find and an-find)

(defn bin-find
  "BitmapIndexedNode lookup.
   arr layout: [key0, val0, key1, val1, ..., nil, child, ...]
   If key-or-nil is nil, val-or-node is a child node to recurse into."
  [node shift hash key not-found]
  (let [bit (hamt-bitpos hash shift)
        bitmap (.-bitmap node)]
    (if (= (bit-and bitmap bit) 0)
      ;; Bit not set - key not found
      not-found
      ;; Bit set - look up in array
      (let [idx (hamt-index bitmap bit)
            arr (.-bin-arr node)
            key-or-nil (aget arr (* 2 idx))
            val-or-node (aget arr (+ (* 2 idx) 1))]
        (if (nil? key-or-nil)
          ;; key-or-nil is nil means val-or-node is a child node
          (inode-find val-or-node (+ shift 5) hash key not-found)
          ;; key-or-nil is a key - check if it matches
          (if (= key key-or-nil)
            val-or-node
            not-found))))))

(defn an-find
  "ArrayNode lookup.
   arr layout: 32 slots, direct indexing by (mask hash shift).
   Each slot is either nil or a child node."
  [node shift hash key not-found]
  (let [idx (hamt-mask hash shift)
        arr (.-an-arr node)
        child (aget arr idx)]
    (if (nil? child)
      not-found
      (inode-find child (+ shift 5) hash key not-found))))

(defn hcn-find
  "HashCollisionNode lookup.
   arr layout: [key0, val0, key1, val1, ...] - linear scan."
  [node hash key not-found]
  (let [cnt (.-hcn-cnt node)
        arr (.-hcn-arr node)]
    (loop [i 0]
      (if (>= i cnt)
        not-found
        (if (= key (aget arr (* 2 i)))
          (aget arr (+ (* 2 i) 1))
          (recur (+ i 1)))))))

(defn inode-find
  "Type-dispatching lookup for any HAMT node type."
  [node shift hash key not-found]
  (cond
    (nil? node) not-found
    (instance? BitmapIndexedNode node) (bin-find node shift hash key not-found)
    (instance? ArrayNode node) (an-find node shift hash key not-found)
    (instance? HashCollisionNode node) (hcn-find node hash key not-found)
    :else not-found))

;; ============================================================
;; User-Facing Collection Functions
;; ============================================================

(defn cons
  "Returns a new seq with x as the first element and coll as the rest."
  [x coll]
  (->Cons x coll 0))

(defn hash
  "Returns a hash code for x.
   For integers, returns the value itself.
   For nil, returns 0. For true/false, returns fixed values."
  [x]
  ;; Simple implementation: just use the value as-is for integers
  ;; This works because our integers are already small enough to hash
  (cond
    (nil? x) 0
    (= x true) 1231
    (= x false) 1237
    :else x))  ;; For integers, use the value as hash

;; ============================================================
;; HAMT Assoc Functions
;; ============================================================

(defn bin-assoc
  "Associate a key-value pair into a BitmapIndexedNode.
   Returns a new node with the entry added or updated."
  [node shift hash key val]
  (let [bit (hamt-bitpos hash shift)
        bitmap (.-bitmap node)
        arr (.-bin-arr node)
        idx (hamt-index bitmap bit)]
    (if (not= 0 (bit-and bitmap bit))
      ;; Bit is set - key might already exist
      (let [key-or-nil (aget arr (* 2 idx))
            val-or-node (aget arr (+ (* 2 idx) 1))]
        (if (nil? key-or-nil)
          ;; Subtree - recurse into child node
          (let [new-child (inode-assoc val-or-node (+ shift 5) hash key val)
                new-arr (aclone arr)]
            (aset new-arr (+ (* 2 idx) 1) new-child)
            (->BitmapIndexedNode bitmap new-arr))
          ;; Leaf entry
          (if (= key key-or-nil)
            ;; Same key - update value
            (let [new-arr (aclone arr)]
              (aset new-arr (+ (* 2 idx) 1) val)
              (->BitmapIndexedNode bitmap new-arr))
            ;; Hash collision or different key at this slot
            ;; Create a new subtree with both entries
            (let [new-child (create-node (+ shift 5) key-or-nil val-or-node hash key val)
                  new-arr (aclone arr)]
              (aset new-arr (* 2 idx) nil)  ;; Mark as subtree
              (aset new-arr (+ (* 2 idx) 1) new-child)
              (->BitmapIndexedNode bitmap new-arr)))))
      ;; Bit is not set - add new entry
      (let [n (bit-count bitmap)
            new-arr (make-array (* 2 (+ n 1)))]
        ;; Copy entries before new slot
        (acopy new-arr 0 arr 0 (* 2 idx))
        ;; Insert new key-value
        (aset new-arr (* 2 idx) key)
        (aset new-arr (+ (* 2 idx) 1) val)
        ;; Copy entries after new slot
        (acopy new-arr (* 2 (+ idx 1)) arr (* 2 idx) (* 2 (- n idx)))
        (->BitmapIndexedNode (bit-or bitmap bit) new-arr)))))

(defn an-assoc
  "ArrayNode assoc - 32-slot direct indexing.
   Each slot is either nil or a child node."
  [node shift hash key val]
  (let [idx (hamt-mask hash shift)
        arr (.-an-arr node)
        child (aget arr idx)
        new-child (inode-assoc child (+ shift 5) hash key val)
        new-arr (aclone arr)
        cnt (.-an-cnt node)
        new-cnt (if (and (nil? child) (not (nil? new-child)))
                  (+ cnt 1)
                  cnt)]
    (aset new-arr idx new-child)
    (->ArrayNode new-cnt new-arr)))

(defn hcn-assoc
  "HashCollisionNode assoc - linear scan for matching key.
   All entries have the same hash value."
  [node hash key val]
  (let [cnt (.-hcn-cnt node)
        arr (.-hcn-arr node)]
    ;; Search for existing key
    (loop [i 0]
      (if (>= i cnt)
        ;; Key not found - add new entry
        (let [new-arr (make-array (* 2 (+ cnt 1)))]
          (acopy new-arr 0 arr 0 (* 2 cnt))
          (aset new-arr (* 2 cnt) key)
          (aset new-arr (+ (* 2 cnt) 1) val)
          (->HashCollisionNode hash (+ cnt 1) new-arr))
        ;; Check if key matches
        (if (= key (aget arr (* 2 i)))
          ;; Update existing value
          (let [new-arr (aclone arr)]
            (aset new-arr (+ (* 2 i) 1) val)
            (->HashCollisionNode hash cnt new-arr))
          (recur (+ i 1)))))))

(defn create-node
  "Create a node containing two key-value pairs.
   If hashes differ at this level: BitmapIndexedNode with both.
   If hashes are identical: HashCollisionNode."
  [shift key1 val1 key2hash key2 val2]
  (let [key1hash (hash key1)]
    (if (= key1hash key2hash)
      ;; Same hash - create HashCollisionNode
      (let [arr (make-array 4)]
        (aset arr 0 key1)
        (aset arr 1 val1)
        (aset arr 2 key2)
        (aset arr 3 val2)
        (->HashCollisionNode key1hash 2 arr))
      ;; Different hashes - create BitmapIndexedNode
      (let [bit1 (hamt-bitpos key1hash shift)
            bit2 (hamt-bitpos key2hash shift)]
        (if (= bit1 bit2)
          ;; Same bit position - recurse deeper
          (let [child (create-node (+ shift 5) key1 val1 key2hash key2 val2)
                arr (make-array 2)]
            (aset arr 0 nil)  ;; nil key marks subtree
            (aset arr 1 child)
            (->BitmapIndexedNode bit1 arr))
          ;; Different bit positions - two entries
          (let [arr (make-array 4)]
            (if (< (hamt-index (bit-or bit1 bit2) bit1)
                   (hamt-index (bit-or bit1 bit2) bit2))
              (do (aset arr 0 key1) (aset arr 1 val1)
                  (aset arr 2 key2) (aset arr 3 val2))
              (do (aset arr 0 key2) (aset arr 1 val2)
                  (aset arr 2 key1) (aset arr 3 val1)))
            (->BitmapIndexedNode (bit-or bit1 bit2) arr)))))))

(defn inode-assoc
  "Type-dispatching assoc for any HAMT node type.
   Handles nil (empty), BitmapIndexedNode, ArrayNode, HashCollisionNode."
  [node shift hash key val]
  (cond
    (nil? node)
    ;; Empty - create single-entry BitmapIndexedNode
    (let [bit (hamt-bitpos hash shift)
          arr (make-array 2)]
      (aset arr 0 key)
      (aset arr 1 val)
      (->BitmapIndexedNode bit arr))

    (instance? BitmapIndexedNode node)
    (bin-assoc node shift hash key val)

    (instance? ArrayNode node)
    (an-assoc node shift hash key val)

    (instance? HashCollisionNode node)
    (hcn-assoc node hash key val)

    :else node))

;; ============================================================
;; HAMT Dissoc Functions
;; ============================================================

(defn remove-pair
  "Remove key-value pair at index i from array.
   Returns new array with 2 fewer elements."
  [arr i]
  (let [len (alength arr)
        new-arr (make-array (- len 2))]
    ;; Copy entries before removed pair
    (acopy new-arr 0 arr 0 (* 2 i))
    ;; Copy entries after removed pair
    (acopy new-arr (* 2 i) arr (* 2 (+ i 1)) (- len (* 2 (+ i 1))))
    new-arr))

(defn hcn-find-index
  "Find index of key in HashCollisionNode array.
   Returns the key index (0, 1, 2, ...) or -1 if not found."
  [arr cnt key]
  (loop [i 0]
    (if (>= i cnt)
      -1
      (if (= key (aget arr (* 2 i)))
        i
        (recur (+ i 1))))))

(defn bin-dissoc
  "Remove a key from a BitmapIndexedNode.
   Returns new node, or nil if this was the only entry.
   NOTE: Caller should verify key exists before calling (can't compare node refs)."
  [node shift hash key]
  (let [bit (hamt-bitpos hash shift)
        bitmap (.-bitmap node)]
    (if (= (bit-and bitmap bit) 0)
      ;; Bit not set - key not found
      node
      ;; Bit set - look up entry
      (let [idx (hamt-index bitmap bit)
            arr (.-bin-arr node)
            key-or-nil (aget arr (* 2 idx))
            val-or-node (aget arr (+ (* 2 idx) 1))]
        (if (nil? key-or-nil)
          ;; Subtree - recurse into child
          (let [n (inode-dissoc val-or-node (+ shift 5) hash key)]
            (cond
              ;; Child shrunk but not nil - update reference
              (not (nil? n))
              (let [new-arr (aclone arr)]
                (aset new-arr (+ (* 2 idx) 1) n)
                (->BitmapIndexedNode bitmap new-arr))
              ;; Child became nil - remove this entry
              (= bitmap bit) nil  ;; Was the only entry
              :else (->BitmapIndexedNode (bit-xor bitmap bit) (remove-pair arr idx))))
          ;; Leaf entry - check if key matches
          (if (= key key-or-nil)
            ;; Key matches - remove it
            (if (= bitmap bit)
              nil  ;; Was the only entry
              (->BitmapIndexedNode (bit-xor bitmap bit) (remove-pair arr idx)))
            ;; Key doesn't match - not found
            node))))))

(defn an-dissoc
  "Remove a key from an ArrayNode.
   Returns new node, or nil if empty after removal.
   NOTE: Caller should verify key exists before calling (can't compare node refs)."
  [node shift hash key]
  (let [idx (hamt-mask hash shift)
        arr (.-an-arr node)
        child (aget arr idx)]
    (if (nil? child)
      ;; No child at this index - not found
      node
      ;; Recurse into child
      (let [n (inode-dissoc child (+ shift 5) hash key)
            cnt (.-an-cnt node)]
        (cond
          ;; Child became nil - decrement count
          (nil? n)
          (if (= cnt 1)
            nil  ;; Was the only child
            (let [new-arr (aclone arr)]
              (aset new-arr idx nil)
              (->ArrayNode (- cnt 1) new-arr)))
          ;; Child shrunk but not nil - update reference
          :else
          (let [new-arr (aclone arr)]
            (aset new-arr idx n)
            (->ArrayNode cnt new-arr)))))))

(defn hcn-dissoc
  "Remove a key from a HashCollisionNode.
   Returns new node, or nil if this was the only entry."
  [node hash key]
  (let [cnt (.-hcn-cnt node)
        arr (.-hcn-arr node)
        idx (hcn-find-index arr cnt key)]
    (cond
      ;; Key not found
      (= idx -1) node
      ;; Only one entry - return nil
      (= cnt 1) nil
      ;; Multiple entries - remove this one
      :else (->HashCollisionNode hash (- cnt 1) (remove-pair arr idx)))))

(defn inode-dissoc
  "Type-dispatching dissoc for any HAMT node type."
  [node shift hash key]
  (cond
    (nil? node) nil

    (instance? BitmapIndexedNode node)
    (bin-dissoc node shift hash key)

    (instance? ArrayNode node)
    (an-dissoc node shift hash key)

    (instance? HashCollisionNode node)
    (hcn-dissoc node hash key)

    :else node))

;; ============================================================
;; User-Facing Dissoc/Disj Functions
;; ============================================================

(defn dissoc1
  "Dissoc[iate] a single key. Returns a new map without the mapping for key."
  [m key]
  (if (nil? m)
    nil
    (let [root (.-map-root m)
          cnt (.-map-cnt m)
          h (hash key)]
      (if (nil? root)
        m  ;; Empty map, nothing to remove
        ;; Check if key exists first, then remove
        (if (nil? (inode-find root 0 h key nil))
          m  ;; Key not found, return unchanged
          (let [new-root (inode-dissoc root 0 h key)]
            (if (nil? new-root)
              (->PersistentMap 0 nil)  ;; Map is now empty
              (->PersistentMap (- cnt 1) new-root))))))))

(defn dissoc
  "Dissoc[iate]. Returns a new map without the mappings for the given keys. Variadic."
  [m & ks]
  (let [len (count ks)]
    (loop [m m i 0]
      (if (< i len)
        (recur (dissoc1 m (nth ks i)) (+ i 1))
        m))))

(defn disj
  "Disj[oin]. Returns a new set without key."
  [s key]
  (if (nil? s)
    nil
    (let [root (.-set-root s)
          cnt (.-set-cnt s)
          h (hash key)]
      (if (nil? root)
        s  ;; Empty set, nothing to remove
        ;; Check if key exists first, then remove
        (if (nil? (inode-find root 0 h key nil))
          s  ;; Key not found, return unchanged
          (let [new-root (inode-dissoc root 0 h key)]
            (if (nil? new-root)
              (->PersistentSet 0 nil 0)  ;; Set is now empty
              (->PersistentSet (- cnt 1) new-root 0))))))))

;; ============================================================
;; HAMT Traversal for ISeqable
;; ============================================================

(defn -collect-bin-map-entries
  "Collect MapEntry pairs from BitmapIndexedNode into array."
  [node arr idx]
  (let [n (bit-count (.-bitmap node))
        bin-arr (.-bin-arr node)]
    (loop [i 0 cur idx]
      (if (>= i n)
        cur
        (let [k (aget bin-arr (* 2 i))
              v (aget bin-arr (+ (* 2 i) 1))]
          (if (nil? k)
            ;; Child node - recurse
            (recur (+ i 1) (-collect-map-entries v arr cur))
            ;; Leaf entry
            (do (aset arr cur (->MapEntry k v))
                (recur (+ i 1) (+ cur 1)))))))))

(defn -collect-an-map-entries
  "Collect MapEntry pairs from ArrayNode into array."
  [node arr idx]
  (let [an-arr (.-an-arr node)]
    (loop [i 0 cur idx]
      (if (>= i 32)
        cur
        (let [child (aget an-arr i)]
          (if (nil? child)
            (recur (+ i 1) cur)
            (recur (+ i 1) (-collect-map-entries child arr cur))))))))

(defn -collect-hcn-map-entries
  "Collect MapEntry pairs from HashCollisionNode into array."
  [node arr idx]
  (let [hcn-arr (.-hcn-arr node)
        n (alength hcn-arr)]
    (loop [i 0 cur idx]
      (if (>= i n)
        cur
        (do (aset arr cur (->MapEntry (aget hcn-arr i) (aget hcn-arr (+ i 1))))
            (recur (+ i 2) (+ cur 1)))))))

(defn -collect-map-entries
  "Collect all MapEntry pairs from a HAMT node into array."
  [node arr idx]
  (cond
    (nil? node) idx
    (instance? BitmapIndexedNode node) (-collect-bin-map-entries node arr idx)
    (instance? ArrayNode node) (-collect-an-map-entries node arr idx)
    (instance? HashCollisionNode node) (-collect-hcn-map-entries node arr idx)
    :else idx))

(defn -collect-bin-set-entries
  "Collect keys from BitmapIndexedNode into array (for sets)."
  [node arr idx]
  (let [n (bit-count (.-bitmap node))
        bin-arr (.-bin-arr node)]
    (loop [i 0 cur idx]
      (if (>= i n)
        cur
        (let [k (aget bin-arr (* 2 i))
              v (aget bin-arr (+ (* 2 i) 1))]
          (if (nil? k)
            ;; Child node - recurse
            (recur (+ i 1) (-collect-set-entries v arr cur))
            ;; Leaf entry - only store key (in sets key=value)
            (do (aset arr cur k)
                (recur (+ i 1) (+ cur 1)))))))))

(defn -collect-an-set-entries
  "Collect keys from ArrayNode into array (for sets)."
  [node arr idx]
  (let [an-arr (.-an-arr node)]
    (loop [i 0 cur idx]
      (if (>= i 32)
        cur
        (let [child (aget an-arr i)]
          (if (nil? child)
            (recur (+ i 1) cur)
            (recur (+ i 1) (-collect-set-entries child arr cur))))))))

(defn -collect-hcn-set-entries
  "Collect keys from HashCollisionNode into array (for sets)."
  [node arr idx]
  (let [hcn-arr (.-hcn-arr node)
        n (alength hcn-arr)]
    (loop [i 0 cur idx]
      (if (>= i n)
        cur
        (do (aset arr cur (aget hcn-arr i))
            (recur (+ i 2) (+ cur 1)))))))

(defn -collect-set-entries
  "Collect all keys from a HAMT node into array (for sets)."
  [node arr idx]
  (cond
    (nil? node) idx
    (instance? BitmapIndexedNode node) (-collect-bin-set-entries node arr idx)
    (instance? ArrayNode node) (-collect-an-set-entries node arr idx)
    (instance? HashCollisionNode node) (-collect-hcn-set-entries node arr idx)
    :else idx))

;; ============================================================
;; Protocol Implementations
;; ============================================================

(extend-type Cons
  ISeqable
  (-seq [c] c)  ;; Cons is already a seq

  ISeq
  (-first [c] (.-first c))
  (-rest [c] (.-rest c))

  IIndexed
  (-nth [c idx]
    (loop [coll c i idx]
      (if (= i 0)
        (.-first coll)
        (recur (.-rest coll) (- i 1)))))

  ICounted
  (-count [c]
    (loop [coll c cnt 0]
      (if (nil? coll)
        cnt
        (recur (.-rest coll) (+ cnt 1)))))

  ICollection
  (-conj [c item] (->Cons item c 0)))  ;; Add to front like cons

(extend-type PersistentVector
  IIndexed
  (-nth [v idx]
    (aget (array-for v idx) (bit-and idx 31)))

  ISeqable
  (-seq [v]
    (if (= 0 (.-cnt v))
      nil
      ;; Build array from vector elements for IndexedSeq
      (let [n (.-cnt v)
            arr (make-array n)]
        (loop [i 0]
          (if (< i n)
            (do (aset arr i (-nth v i))
                (recur (+ i 1)))
            (->IndexedSeq arr 0))))))

  ISeq
  (-first [v]
    (if (> (.-cnt v) 0)
      (-nth v 0)
      nil))
  (-rest [v]
    (if (<= (.-cnt v) 1)
      []  ;; Return empty vector for empty or single-element vectors
      ;; Build IndexedSeq starting at index 1
      (let [n (- (.-cnt v) 1)
            arr (make-array n)]
        (loop [i 0]
          (if (< i n)
            (do (aset arr i (-nth v (+ i 1)))
                (recur (+ i 1)))
            (->IndexedSeq arr 0))))))

  ICounted
  (-count [v] (.-cnt v)))

(defn -vec-conj-overflow
  "Handle root overflow: grow tree with new level"
  [cnt shift root tail val]
  (let [new-tail (make-array 1)
        new-root (make-array 32)]
    (aset new-tail 0 val)
    (aset new-root 0 root)
    (aset new-root 1 (new-path shift tail))
    (->PersistentVector (+ cnt 1) (+ shift 5) new-root new-tail)))

(defn -vec-conj-push
  "Handle tail push: push old tail into trie"
  [v cnt shift root tail val]
  (let [new-tail (make-array 1)
        new-root (if (nil? root)
                   (new-path shift tail)
                   (push-tail v shift root tail))]
    (aset new-tail 0 val)
    (->PersistentVector (+ cnt 1) shift new-root new-tail)))

(extend-type PersistentVector
  ICollection
  (-conj [v val]
    (let [cnt (.-cnt v)
          shift (.-shift v)
          root (.-root v)
          tail (.-tail v)
          tail-len (- cnt (tail-off cnt))]
      (if (< tail-len 32)
        ;; Room in tail: create larger tail with new element
        (let [new-tail (make-array (+ tail-len 1))]
          (acopy new-tail 0 tail 0 tail-len)
          (aset new-tail tail-len val)
          (->PersistentVector (+ cnt 1) shift root new-tail))
        ;; Tail full: push into trie
        (if (> (unsigned-bit-shift-right cnt 5) (bit-shift-left 1 shift))
          ;; Root overflow
          (-vec-conj-overflow cnt shift root tail val)
          ;; No overflow
          (-vec-conj-push v cnt shift root tail val))))))

;; Vector assoc helper: update a node at the given level
(defn -vec-do-assoc
  "Update element at index in a tree node."
  [level node idx val]
  (if (= level 0)
    ;; Leaf level: clone and update
    (let [new-node (aclone node)]
      (aset new-node (bit-and idx 31) val)
      new-node)
    ;; Internal node: recurse down
    (let [subidx (bit-and (unsigned-bit-shift-right idx level) 31)
          new-node (aclone node)]
      (aset new-node subidx (-vec-do-assoc (- level 5) (aget node subidx) idx val))
      new-node)))

(extend-type PersistentVector
  IAssociative
  (-assoc [v idx val]
    (let [cnt (.-cnt v)
          shift (.-shift v)
          root (.-root v)
          tail (.-tail v)]
      ;; Bounds check
      (if (>= idx cnt)
        v  ;; Out of bounds - return unchanged (could throw)
        (if (>= idx (tail-off cnt))
          ;; Index is in tail: clone and update tail
          (let [tail-idx (bit-and idx 31)
                new-tail (aclone tail)]
            (aset new-tail tail-idx val)
            (->PersistentVector cnt shift root new-tail))
          ;; Index is in tree: update tree node
          (->PersistentVector cnt shift (-vec-do-assoc shift root idx val) tail))))))

(extend-type PersistentMap
  ILookup
  (-lookup [m key]
    (let [root (.-map-root m)]
      (if (nil? root)
        nil
        (let [sentinel (->NotFound)
              result (inode-find root 0 (hash key) key sentinel)]
          (if (instance? NotFound result)
            nil
            result)))))

  ICounted
  (-count [m] (.-map-cnt m))

  IAssociative
  (-assoc [m key val]
    (let [root (.-map-root m)
          cnt (.-map-cnt m)
          h (hash key)]
      (if (nil? root)
        ;; Empty map: create BitmapIndexedNode with single entry [key, val]
        (let [arr (make-array 2)]
          (aset arr 0 key)
          (aset arr 1 val)
          (->PersistentMap (+ cnt 1) (->BitmapIndexedNode (hamt-bitpos h 0) arr)))
        ;; Non-empty: check if key already exists
        (let [sentinel (->NotFound)
              existing (inode-find root 0 h key sentinel)]
          (if (instance? NotFound existing)
            ;; Key doesn't exist - add and increment count
            (->PersistentMap (+ cnt 1) (inode-assoc root 0 h key val))
            ;; Key exists - update without incrementing count
            (->PersistentMap cnt (inode-assoc root 0 h key val)))))))

  ISeqable
  (-seq [m]
    (if (= 0 (.-map-cnt m))
      nil
      (let [arr (make-array (.-map-cnt m))]
        (-collect-map-entries (.-map-root m) arr 0)
        (->IndexedSeq arr 0)))))

(extend-type PersistentSet
  ILookup
  (-lookup [s key]
    (let [root (.-set-root s)]
      (if (nil? root)
        nil
        (let [sentinel (->NotFound)
              result (inode-find root 0 (hash key) key sentinel)]
          (if (instance? NotFound result)
            nil
            result)))))

  ICounted
  (-count [s] (.-set-cnt s))

  ICollection
  (-conj [s val]
    (let [root (.-set-root s)
          cnt (.-set-cnt s)
          h (hash val)]
      (if (nil? root)
        ;; Empty set: create BitmapIndexedNode with single entry [val, val]
        (let [arr (make-array 2)]
          (aset arr 0 val)
          (aset arr 1 val)
          (->PersistentSet (+ cnt 1) (->BitmapIndexedNode (hamt-bitpos h 0) arr) 0))
        ;; Non-empty: check if value already exists
        (let [sentinel (->NotFound)
              existing (inode-find root 0 h val sentinel)]
          (if (instance? NotFound existing)
            ;; New value - add it and increment count
            (->PersistentSet (+ cnt 1) (inode-assoc root 0 h val val) 0)
            ;; Already exists - return unchanged set
            s)))))

  ISeqable
  (-seq [s]
    (if (= 0 (.-set-cnt s))
      nil
      (let [arr (make-array (.-set-cnt s))]
        (-collect-set-entries (.-set-root s) arr 0)
        (->IndexedSeq arr 0)))))

;; ============================================================
;; IFn Protocol Implementations
;;
;; Allows collections to be used as functions for lookup.
;; (#{1 2 3} 2) => 2
;; ({:a 1} :a) => 1
;; ([10 20 30] 1) => 20
;; ============================================================

(extend-type PersistentVector
  IFn
  (-invoke [coll k] (nth coll k))
  (-invoke [coll k not-found] (nth coll k not-found)))

(extend-type PersistentMap
  IFn
  (-invoke [coll k] (-lookup coll k))
  (-invoke [coll k not-found] (-lookup coll k not-found)))

(extend-type PersistentSet
  IFn
  (-invoke [coll k] (-lookup coll k))
  (-invoke [coll k not-found] (-lookup coll k not-found)))

;; ============================================================
;; IndexedSeq - A sequence view over an array
;;
;; IndexedSeq wraps an array and provides sequence access starting
;; from a given index. This is used for vector iteration and other
;; indexed collection sequences.
;; ============================================================

(deftype IndexedSeq [arr ^i32 i])

(extend-type IndexedSeq
  ISeqable
  (-seq [iseq]
    (if (< (.-i iseq) (alength (.-arr iseq)))
      iseq
      nil))

  ISeq
  (-first [iseq] (aget (.-arr iseq) (.-i iseq)))
  (-rest [iseq]
    (let [next-i (+ (.-i iseq) 1)]
      (if (< next-i (alength (.-arr iseq)))
        (->IndexedSeq (.-arr iseq) next-i)
        ())))

  ICounted
  (-count [iseq] (- (alength (.-arr iseq)) (.-i iseq))))

;; ============================================================
;; User-Facing Sequence Functions
;;
;; These are the primary functions users interact with for sequence
;; operations. They delegate to protocol methods.
;; ============================================================

(defn seq
  "Returns a seq on the collection. If empty, returns nil."
  [coll]
  (if (nil? coll)
    nil
    (-seq coll)))

(defn first
  "Returns the first element of coll. Returns nil if empty."
  [coll]
  (if (nil? coll)
    nil
    (let [s (seq coll)]
      (if (nil? s)
        nil
        (-first s)))))

(defn rest
  "Returns the rest of coll after first. Returns empty seq if empty."
  [coll]
  (if (nil? coll)
    []  ;; Return empty vector for nil
    (let [s (seq coll)]
      (if (nil? s)
        []  ;; Return empty vector for empty collection
        (-rest s)))))

(defn next
  "Returns the next element of coll. Like (seq (rest coll))."
  [coll]
  (if (nil? coll)
    nil
    (let [s (seq coll)]
      (if (nil? s)
        nil
        (seq (-rest s))))))

(defn conj
  "Adds items to collection. For vectors, adds to end. For sets, adds to set.
   For lists, adds to front (like cons). Variadic."
  [coll & items]
  (let [len (count items)]
    (loop [c coll i 0]
      (if (< i len)
        (recur (-conj c (nth items i)) (+ i 1))
        c))))

(defn assoc
  "Associates key/value pairs with a map or vector. Variadic."
  [m & kvs]
  (let [len (count kvs)]
    (loop [m m i 0]
      (if (< i len)
        (recur (-assoc m (nth kvs i) (nth kvs (+ i 1))) (+ i 2))
        m))))

(defn peek
  "Returns the last element of a vector, or first element of a list/seq.
   Returns nil for empty collections."
  [coll]
  (cond
    (nil? coll) nil
    (instance? PersistentVector coll)
    (let [cnt (.-cnt coll)]
      (if (= cnt 0)
        nil
        (let [tail (.-tail coll)
              tail-len (- cnt (tail-off cnt))]
          (aget tail (- tail-len 1)))))
    ;; For lists/seqs, peek returns first element
    :else (first coll)))

(defn -vec-pop-tail
  "Pop tail from vector trie. Returns the new root array after removing last leaf."
  [v level node]
  (let [subidx (bit-and (unsigned-bit-shift-right (- (.-cnt v) 2) level) 31)]
    (if (> level 5)
      ;; Not at leaf level yet - recurse
      (let [new-child (-vec-pop-tail v (- level 5) (aget node subidx))]
        (if (nil? new-child)
          (if (= subidx 0)
            nil  ;; This subtree is now empty
            ;; Copy array without the last child
            (let [new-node (make-array subidx)]
              (acopy new-node 0 node 0 subidx)
              new-node))
          ;; Copy array with updated child
          (let [new-node (make-array (+ subidx 1))]
            (acopy new-node 0 node 0 subidx)
            (aset new-node subidx new-child)
            new-node)))
      ;; At leaf level
      (if (= subidx 0)
        nil  ;; This is the only leaf, remove it
        ;; Copy array without the last element
        (let [new-node (make-array subidx)]
          (acopy new-node 0 node 0 subidx)
          new-node)))))

(defn pop
  "Returns a new vector without the last element.
   Throws error if called on empty vector."
  [coll]
  (cond
    (nil? coll) nil
    (instance? PersistentVector coll)
    (let [cnt (.-cnt coll)]
      (cond
        (= cnt 0) nil  ;; Empty vector - return nil
        (= cnt 1) []   ;; Single element - return empty vector
        :else
        (let [tail (.-tail coll)
              tail-len (- cnt (tail-off cnt))]
          (if (> tail-len 1)
            ;; Just shrink the tail
            (let [new-tail (make-array (- tail-len 1))]
              (acopy new-tail 0 tail 0 (- tail-len 1))
              (->PersistentVector (- cnt 1) (.-shift coll) (.-root coll) new-tail))
            ;; Tail has 1 element - need to get new tail from trie
            (let [root (.-root coll)
                  shift (.-shift coll)
                  new-tail (array-for coll (- cnt 2))  ;; Get the leaf that will become new tail
                  new-root (-vec-pop-tail coll shift root)]
              (if (nil? new-root)
                ;; Root is now nil, we're back to a tail-only vector
                (->PersistentVector (- cnt 1) 5 nil new-tail)
                ;; Check if we should reduce tree height
                (if (> shift 5)
                  (if (nil? (aget new-root 1))
                    (->PersistentVector (- cnt 1) (- shift 5) (aget new-root 0) new-tail)
                    (->PersistentVector (- cnt 1) shift new-root new-tail))
                  (->PersistentVector (- cnt 1) shift new-root new-tail))))))))
    ;; For lists/seqs, pop returns rest
    :else (rest coll)))

;; ============================================================
;; Equality - Structural comparison for collections
;;
;; Following ClojureScript semantics:
;; - nil = nil
;; - identical references are equal
;; - collections use structural comparison via -equiv protocol
;; ============================================================

(defn -equiv-sequential
  "Compare two sequential collections element by element.
   Assumes both are sequential and non-nil."
  [x y]
  (let [cx (count x)
        cy (count y)]
    (if (not (= cx cy))
      false
      (loop [xs (seq x) ys (seq y)]
        (cond
          (nil? xs) true  ;; Both exhausted = equal
          (suss-equals (first xs) (first ys)) (recur (next xs) (next ys))
          :else false)))))

(defn -equiv-map
  "Compare two maps for equality.
   Two maps are equal if they have the same keys with equal values."
  [x y]
  (let [cx (count x)
        cy (count y)]
    (if (not (= cx cy))
      false
      ;; Check each entry in x exists in y with same value
      (loop [entries (seq x)]
        (if (nil? entries)
          true
          (let [entry (first entries)
                k (key entry)
                vx (val entry)]
            (if (contains? y k)
              (let [vy (get y k)]
                (if (suss-equals vx vy)
                  (recur (next entries))
                  false))
              false)))))))

(defn -equiv-set
  "Compare two sets for equality.
   Two sets are equal if they have the same elements."
  [x y]
  (let [cx (count x)
        cy (count y)]
    (if (not (= cx cy))
      false
      ;; Check each element in x exists in y
      (loop [entries (seq x)]
        (if (nil? entries)
          true
          (let [elem (first entries)]
            (if (contains? y elem)
              (recur (next entries))
              false)))))))

(defn suss-equals
  "Structural equality comparison.
   Returns true if x equals y using value semantics."
  [x y]
  (cond
    ;; nil checks
    (nil? x) (nil? y)
    (nil? y) false
    ;; Reference equality (fast path)
    (identical? x y) true
    ;; Vector equality
    (instance? PersistentVector x)
    (if (instance? PersistentVector y)
      (-equiv-sequential x y)
      false)
    ;; Map equality
    (instance? PersistentMap x)
    (if (instance? PersistentMap y)
      (-equiv-map x y)
      false)
    ;; Set equality
    (instance? PersistentSet x)
    (if (instance? PersistentSet y)
      (-equiv-set x y)
      false)
    ;; Cons/List equality
    (instance? Cons x)
    (if (instance? Cons y)
      (-equiv-sequential x y)
      false)
    ;; IndexedSeq equality
    (instance? IndexedSeq x)
    (if (instance? IndexedSeq y)
      (-equiv-sequential x y)
      false)
    ;; Fallback to primitive equality (handles keywords, symbols, numbers, etc.)
    ;; Uses prim-eq which compares keywords by name_idx, not reference
    :else (prim-eq x y)))

;; ============================================================
;; MapEntry - Key-value pair for map iteration
;;
;; MapEntry wraps a key and value from a map, allowing iteration
;; over maps as sequences of entries.
;; ============================================================

(deftype MapEntry [key val])

(extend-type MapEntry
  ICounted
  (-count [e] 2)

  IIndexed
  (-nth [e n]
    (cond (= n 0) (.-key e)
          (= n 1) (.-val e)
          :else nil))

  ISeqable
  (-seq [e]
    ;; MapEntry as a 2-element seq
    (let [arr (make-array 2)]
      (aset arr 0 (.-key e))
      (aset arr 1 (.-val e))
      (->IndexedSeq arr 0))))

(defn key
  "Returns the key of a map entry."
  [e]
  (.-key e))

(defn val
  "Returns the value of a map entry."
  [e]
  (.-val e))

;; ============================================================
;; LazySeq - Lazily-evaluated sequence
;;
;; LazySeq wraps a thunk (zero-arg function) that produces a sequence.
;; The thunk is evaluated on first access and the result is cached.
;; This enables lazy evaluation for map, filter, take, etc.
;; ============================================================

(deftype LazySeq [^:mutable fn ^:mutable s])

(defn -lazy-seq-realize
  "Evaluate thunk and cache result. Internal use."
  [ls]
  (when-not (nil? (.-fn ls))
    (set! (.-s ls) ((.-fn ls)))
    (set! (.-fn ls) nil))
  (.-s ls))

(extend-type LazySeq
  ISeqable
  (-seq [ls]
    (let [realized (-lazy-seq-realize ls)]
      (if (nil? realized)
        nil
        (seq realized))))

  ISeq
  (-first [ls]
    (let [s (seq ls)]
      (if (nil? s) nil (first s))))
  (-rest [ls]
    (let [s (seq ls)]
      (if (nil? s) nil (rest s))))

  ICounted
  (-count [ls]
    (let [s (seq ls)]
      (if (nil? s)
        0
        (loop [coll s cnt 0]
          (if (nil? coll)
            cnt
            (recur (next coll) (+ cnt 1))))))))

(defmacro lazy-seq
  "Returns a lazy sequence that will evaluate body when needed."
  [& body]
  (list '->LazySeq (cons 'fn (cons [] body)) nil))

;; ============================================================
;; Numeric Helpers
;; ============================================================

(defn inc
  "Returns a number one greater than n."
  [n]
  (+ n 1))

(defn dec
  "Returns a number one less than n."
  [n]
  (- n 1))

(defn pos?
  "Returns true if n is greater than zero."
  [n]
  (> n 0))

(defn neg?
  "Returns true if n is less than zero."
  [n]
  (< n 0))

(defn zero?
  "Returns true if n is zero."
  [n]
  (= n 0))

(defn min*
  "Returns the least of the arguments. First-class fn version for use with apply."
  [& args]
  (let [len (count args)]
    (if (= len 1)
      (nth args 0)
      (loop [i 1 result (nth args 0)]
        (if (< i len)
          (let [x (nth args i)]
            (recur (+ i 1) (if (< x result) x result)))
          result)))))

(defn max*
  "Returns the greatest of the arguments. First-class fn version for use with apply."
  [& args]
  (let [len (count args)]
    (if (= len 1)
      (nth args 0)
      (loop [i 1 result (nth args 0)]
        (if (< i len)
          (let [x (nth args i)]
            (recur (+ i 1) (if (> x result) x result)))
          result)))))

(defn min-coll
  "Returns the minimum element of a collection. Works with any seqable."
  [coll]
  (let [s (seq coll)]
    (if (nil? s)
      nil
      (loop [xs (rest s) result (first s)]
        (if (nil? xs)
          result
          (let [x (first xs)
                new-result (if (< x result) x result)]
            (recur (next xs) new-result)))))))

(defn max-coll
  "Returns the maximum element of a collection. Works with any seqable."
  [coll]
  (let [s (seq coll)]
    (if (nil? s)
      nil
      (loop [xs (rest s) result (first s)]
        (if (nil? xs)
          result
          (let [x (first xs)
                new-result (if (> x result) x result)]
            (recur (next xs) new-result)))))))

(defn not=
  "Returns true if any argument is not equal to the first."
  [& args]
  (let [len (count args)]
    (if (< len 2)
      false
      (let [first-val (nth args 0)]
        (loop [i 1]
          (if (< i len)
            (if (= first-val (nth args i))
              (recur (+ i 1))
              true)
            false))))))

(defn mod
  "Floored modulus. Result has same sign as divisor (Clojure semantics).
   Unlike rem, (mod -10 3) returns 2, not -1."
  [a b]
  (let [r (rem a b)]
    (rem (+ r b) b)))

(defn even?
  "Returns true if n is even."
  [n]
  (= 0 (rem n 2)))

(defn odd?
  "Returns true if n is odd."
  [n]
  (not (even? n)))

;; ============================================================
;; Higher-Order Sequence Functions
;; ============================================================

(defn map
  "Returns a lazy sequence of applying f to each element of coll."
  [f coll]
  (lazy-seq
    (let [s (seq coll)]
      (if (nil? s)
        nil
        (cons (f (-first s)) (map f (-rest s)))))))

(defn filter
  "Returns a lazy sequence of elements where (pred elem) is truthy."
  [pred coll]
  (lazy-seq
    (let [s (seq coll)]
      (if (nil? s)
        nil
        (let [fst (-first s)
              rst (-rest s)]
          (if (pred fst)
            (cons fst (filter pred rst))
            (filter pred rst)))))))

(defn remove
  "Returns a lazy sequence of elements where (pred elem) is falsy."
  [pred coll]
  (filter (fn [x] (not (pred x))) coll))

(defn some
  "Returns the first truthy value of (pred x) for any x in coll, else nil."
  [pred coll]
  (let [s (seq coll)]
    (if (nil? s)
      nil
      (let [val (pred (-first s))]
        (if val
          val
          (some pred (-rest s)))))))

(defn every?
  "Returns true if (pred x) is truthy for every x in coll, else false."
  [pred coll]
  (let [s (seq coll)]
    (if (nil? s)
      true
      (if (pred (-first s))
        (every? pred (-rest s))
        false))))

(defn not-any?
  "Returns true if (pred x) is falsy for every x in coll, else false."
  [pred coll]
  (not (some pred coll)))

(defn take
  "Returns a lazy sequence of the first n elements of coll."
  [n coll]
  (lazy-seq
    (if (pos? n)
      (let [s (seq coll)]
        (if (nil? s)
          nil
          (cons (-first s) (take (dec n) (-rest s)))))
      nil)))

(defn drop
  "Returns a lazy sequence of all but the first n elements of coll."
  [n coll]
  (if (pos? n)
    (let [s (seq coll)]
      (if (nil? s)
        nil
        (drop (dec n) (-rest s))))
    coll))

(defn take-while
  "Returns a lazy sequence of elements while (pred elem) is truthy."
  [pred coll]
  (lazy-seq
    (let [s (seq coll)]
      (if (nil? s)
        nil
        (let [fst (-first s)]
          (if (pred fst)
            (cons fst (take-while pred (-rest s)))
            nil))))))

(defn drop-while
  "Returns a lazy sequence dropping elements while (pred elem) is truthy."
  [pred coll]
  (let [s (seq coll)]
    (if (nil? s)
      nil
      (if (pred (-first s))
        (drop-while pred (-rest s))
        s))))

(defn reduce
  "Reduces coll using f with init as initial value."
  [f init coll]
  (loop [acc init s (seq coll)]
    (if s
      (recur (f acc (first s)) (next s))
      acc)))

(defn frequencies
  "Returns a map from distinct items in coll to the number of times they appear."
  [coll]
  (reduce (fn [counts x]
            (assoc counts x (inc (get counts x 0))))
          {}
          coll))

(defn group-by
  "Returns a map of the elements of coll keyed by the result of f on each element.
   Uses transients for efficient batch construction."
  [f coll]
  (persistent!
    (reduce (fn [ret x]
              (let [k (f x)]
                (assoc! ret k (conj (get ret k []) x))))
            (transient {})
            coll)))

(defn iterate
  "Returns a lazy sequence of x, (f x), (f (f x)), etc."
  [f x]
  (cons x (lazy-seq (iterate f (f x)))))

(defn repeat
  "Returns a lazy infinite sequence of x."
  [x]
  (cons x (lazy-seq (repeat x))))

(defn repeatedly
  "Returns a lazy sequence of calling f (presumably for side effects)."
  [f]
  (lazy-seq (cons (f) (repeatedly f))))

(defn -range-step
  "Internal: range with start, end, and step."
  [start end step]
  (lazy-seq
    (if (if (pos? step)
          (< start end)
          (> start end))
      (cons start (-range-step (+ start step) end step))
      nil)))

(defn range
  "Returns a lazy sequence of numbers.
   (range end) - 0 to end-1
   (range start end) - start to end-1
   (range start end step) - start, start+step, ... up to (but not including) end"
  [& args]
  (let [len (count args)]
    (cond
      (= len 1) (-range-step 0 (nth args 0) 1)
      (= len 2) (-range-step (nth args 0) (nth args 1) 1)
      (= len 3) (-range-step (nth args 0) (nth args 1) (nth args 2))
      :else nil)))

(defn concat2
  "Returns a lazy sequence concatenating two collections."
  [coll1 coll2]
  (lazy-seq
    (let [s1 (seq coll1)]
      (if (nil? s1)
        (seq coll2)
        (cons (-first s1) (concat2 (-rest s1) coll2))))))

(defn mapcat
  "Returns a lazy sequence of concatenating (map f coll)."
  [f coll]
  (lazy-seq
    (let [s (seq coll)]
      (if (nil? s)
        nil
        (concat2 (f (-first s)) (mapcat f (-rest s)))))))

;; ============================================================
;; Predicate Functions
;; ============================================================

(defn empty?
  "Returns true if coll has no items."
  [coll]
  (if (nil? coll)
    true
    (let [s (seq coll)]
      (nil? s))))

(defn not-empty
  "Returns coll if not empty, nil otherwise."
  [coll]
  (if (empty? coll) nil coll))

;; ============================================================
;; Sequence Search Functions
;; ============================================================

(defn some
  "Returns first logical true value of (pred x) for any x in coll."
  [pred coll]
  (let [s (seq coll)]
    (if (nil? s)
      nil
      (let [result (pred (-first s))]
        (if result
          result
          (some pred (-rest s)))))))

(defn every?
  "Returns true if (pred x) is logical true for every x in coll."
  [pred coll]
  (let [s (seq coll)]
    (if (nil? s)
      true
      (if (pred (-first s))
        (every? pred (-rest s))
        false))))

(defn not-any?
  "Returns false if (pred x) is logical true for any x in coll."
  [pred coll]
  (not (some pred coll)))

(defn not-every?
  "Returns true if (pred x) is logical false for some x in coll."
  [pred coll]
  (not (every? pred coll)))

;; ============================================================
;; Function Combinators
;; ============================================================

(defn identity
  "Returns its argument."
  [x]
  x)

(defn constantly
  "Returns a function that always returns val."
  [val]
  (fn [& args] val))

(defn complement
  "Returns a function that returns the opposite truth value of f."
  [f]
  (fn [& args] (not (apply f args))))

(defn partial
  "Takes a function f and fewer than the normal arguments to f, and
   returns a fn that takes a variable number of additional args. When
   called, the returned function calls f with args + additional args."
  [f & args]
  (fn [& more] (apply f (reduce conj args more))))

(defn comp
  "Takes two functions and returns a fn that is the composition
   of those fns. The returned fn takes a variable number of args,
   applies the rightmost fn to the args, then applies the left fn
   to the result."
  [f g]
  (fn [& args] (f (apply g args))))

(defn juxt
  "Takes two functions and returns a fn that is the juxtaposition
   of those fns. The returned fn takes a variable number of args, and
   returns a vector containing the result of applying each fn to the
   args."
  [f g]
  (fn [& args] [(apply f args) (apply g args)]))

;; ============================================================
;; Collection Utilities
;; ============================================================

(defn into
  "Returns a new coll with items from xs conj'd onto to.
   Uses transients for vectors, maps, and sets for better performance."
  [to xs]
  (if (or (instance? PersistentVector to)
          (instance? PersistentMap to)
          (instance? PersistentSet to))
    ;; Use transients for editable collections
    (persistent!
      (reduce (fn [acc x] (conj! acc x))
              (transient to)
              xs))
    ;; Fallback for other collections (cons, etc.)
    (reduce (fn [acc x] (conj acc x)) to xs)))

(defn vec
  "Coerces coll to a (potentially empty) vector.
   If coll is already a vector, returns it unchanged.
   Uses transients for efficient batch construction."
  [coll]
  (if (instance? PersistentVector coll)
    coll
    (persistent!
      (reduce (fn [acc x] (conj! acc x))
              (transient [])
              coll))))

(defn vector
  "Creates a new vector containing the args.
   Uses transients for efficient batch construction."
  [& args]
  (let [len (count args)]
    (if (= len 0)
      []
      (persistent!
        (loop [v (transient []) i 0]
          (if (< i len)
            (recur (conj! v (nth args i)) (+ i 1))
            v))))))

(defn mapv
  "Returns a vector of applying f to each element of coll.
   Uses transients for efficient batch construction."
  [f coll]
  (persistent!
    (reduce (fn [v o] (conj! v (f o)))
            (transient [])
            coll)))

(defn filterv
  "Returns a vector of the items in coll for which (pred item) returns true.
   Uses transients for efficient batch construction."
  [pred coll]
  (persistent!
    (reduce (fn [v o] (if (pred o) (conj! v o) v))
            (transient [])
            coll)))

(defn hash-map
  "Creates a new hash-map from alternating key-value pairs.
   Uses transients for efficient batch construction."
  [& kvs]
  (let [len (count kvs)]
    (if (= len 0)
      {}
      (persistent!
        (loop [m (transient {}) i 0]
          (if (< i len)
            (recur (assoc! m (nth kvs i) (nth kvs (+ i 1))) (+ i 2))
            m))))))

(defn hash-set
  "Creates a new hash-set containing the args.
   Uses transients for efficient batch construction."
  [& args]
  (let [len (count args)]
    (if (= len 0)
      #{}
      (persistent!
        (loop [s (transient #{}) i 0]
          (if (< i len)
            (recur (conj! s (nth args i)) (+ i 1))
            s))))))

(defn set
  "Returns a set containing the elements of coll.
   Uses transients for efficient batch construction."
  [coll]
  (persistent!
    (reduce (fn [acc x] (conj! acc x))
            (transient #{})
            coll)))

(defn frequencies
  "Returns a map from distinct items in coll to the number of times they appear.
   Uses transients for efficient batch construction."
  [coll]
  (persistent!
    (reduce (fn [counts x]
              (let [cnt (get counts x 0)]
                (assoc! counts x (+ cnt 1))))
            (transient {})
            coll)))

(defmacro concat
  "Returns a lazy seq of the concatenation of collections.
  Variadic: (concat) (concat x) (concat x y) (concat x y z) etc."
  [& colls]
  (if (empty? colls)
    nil
    (if (empty? (rest colls))
      (list 'seq (first colls))
      (list 'concat2 (first colls) (cons 'concat (rest colls))))))

;; ============================================================
;; Utility Functions
;; ============================================================

(defn second
  "Returns the second element of coll."
  [coll]
  (first (rest coll)))

(defn last
  "Returns the last element of coll (linear time)."
  [coll]
  (let [s (seq coll)]
    (if (nil? s)
      nil
      (let [n (next s)]
        (if (nil? n)
          (first s)
          (last n))))))

(defn butlast
  "Returns all but the last element of coll (linear time)."
  [coll]
  (loop [result [] s (seq coll)]
    (if (nil? s)
      nil
      (let [n (next s)]
        (if (nil? n)
          (seq result)
          (recur (conj result (first s)) n))))))

(defn reverse
  "Returns a seq of the items in coll in reverse order."
  [coll]
  (reduce (fn [acc x] (cons x acc)) () coll))

(defn -distinct-step
  "Internal helper for distinct."
  [xs seen]
  (lazy-seq
    (let [s (seq xs)]
      (if (nil? s)
        nil
        (let [f (-first s)
              h (hash f)]
          (if (contains? seen h)
            (-distinct-step (-rest s) seen)
            (cons f (-distinct-step (-rest s) (conj seen h)))))))))

(defn distinct
  "Returns a lazy sequence of distinct elements from coll."
  [coll]
  (-distinct-step coll #{}))

;; Printing Infrastructure

(defprotocol IWriter
  (-write [writer s])
  (-flush [writer]))

(deftype StringBuffer [^:mutable sb-arr ^:mutable ^i32 sb-len ^:mutable ^i32 sb-cap])

(defn string-buffer [n]
  (->StringBuffer (make-string n) 0 n))

(defn -sb-ensure-capacity [sb needed]
  (let [current-len (.-sb-len sb)
        current-cap (.-sb-cap sb)
        required (+ current-len needed)]
    (when (> required current-cap)
      (let [new-cap (if (> (* 2 current-cap) required) (* 2 current-cap) required)
            new-arr (make-string new-cap)
            old-arr (.-sb-arr sb)]
        (scopy new-arr 0 old-arr 0 current-len)
        (set! (.-sb-arr sb) new-arr)
        (set! (.-sb-cap sb) new-cap)))))

(defn -sb-append-str [sb s]
  (let [slen (alength s)]
    (when (> slen 0)
      (-sb-ensure-capacity sb slen)
      (let [arr (.-sb-arr sb)
            len (.-sb-len sb)]
        (scopy arr len s 0 slen)
        (set! (.-sb-len sb) (+ len slen))))))

(defn -sb->str [sb]
  (let [len (.-sb-len sb)
        result (make-string len)
        arr (.-sb-arr sb)]
    (scopy result 0 arr 0 len)
    result))

(deftype StringBufferWriter [sb])

(extend-type StringBufferWriter
  IWriter
  (-write [w s] (-sb-append-str (.-sb w) s) nil)
  (-flush [w] nil))

(defn string-buffer-writer [capacity]
  (->StringBufferWriter (string-buffer capacity)))

(defn int->str [n]
  (if (= n 0)
    "0"
    (let [is-neg (< n 0)
          abs-n (if is-neg (- 0 n) n)
          buf (make-string 21)]
      (loop [num abs-n pos 20]
        (if (= num 0)
          (let [start (if is-neg (do (sset buf pos 45) pos) (+ pos 1))
                len (- 21 start)
                result (make-string len)]
            (scopy result 0 buf start len)
            result)
          (let [digit (rem num 10)
                char-code (+ 48 digit)]
            (sset buf pos char-code)
            (recur (quot num 10) (- pos 1))))))))

(defn float->str [n]
  (int->str (f64->i64 n)))

(defprotocol IPrintWithWriter
  (-pr-writer [obj writer opts]))

(defn pr-sequential-writer [writer print-one begin sep end opts coll]
  (-write writer begin)
  (when-let [s (seq coll)]
    (print-one (first s) writer opts)
    (loop [xs (next s)]
      (when xs
        (-write writer sep)
        (print-one (first xs) writer opts)
        (recur (next xs)))))
  (-write writer end))

(defn pr-writer [obj writer opts]
  (cond
    ;; Primitive types handled inline (not protocol-dispatched)
    (nil? obj) (-write writer "nil")
    (= obj true) (-write writer "true")
    (= obj false) (-write writer "false")
    (int? obj) (-write writer (int->str obj))
    (float? obj) (-write writer (float->str obj))
    (string? obj) (-write writer obj)
    (keyword? obj) (do
                     (-write writer ":")
                     (when-let [ns (namespace obj)]
                       (-write writer ns)
                       (-write writer "/"))
                     (-write writer (name obj)))
    (symbol? obj) (do
                    (when-let [ns (namespace obj)]
                      (-write writer ns)
                      (-write writer "/"))
                    (-write writer (name obj)))
    ;; Collection types use IPrintWithWriter protocol dispatch
    (instance? PersistentVector obj) (-pr-writer obj writer opts)
    (instance? Cons obj) (-pr-writer obj writer opts)
    (instance? IndexedSeq obj) (-pr-writer obj writer opts)
    (instance? LazySeq obj) (-pr-writer obj writer opts)
    (instance? PersistentMap obj) (-pr-writer obj writer opts)
    (instance? PersistentSet obj) (-pr-writer obj writer opts)
    (instance? MapEntry obj) (-pr-writer obj writer opts)
    :else (-write writer "<object>")))

(defn pr-str
  "Returns a string representation of obj in a readable form."
  [obj]
  (let [sb (string-buffer 64)
        w (->StringBufferWriter sb)]
    (pr-writer obj w {:readably true})
    (-sb->str sb)))

;; ============================================================
;; IPrintWithWriter Implementations
;; These extend-type declarations must come after pr-writer is defined
;; since they reference pr-writer and pr-sequential-writer.
;; ============================================================

(extend-type PersistentVector
  IPrintWithWriter
  (-pr-writer [v writer opts]
    (pr-sequential-writer writer pr-writer "[" " " "]" opts v)))

(extend-type Cons
  IPrintWithWriter
  (-pr-writer [c writer opts]
    (pr-sequential-writer writer pr-writer "(" " " ")" opts c)))

(extend-type IndexedSeq
  IPrintWithWriter
  (-pr-writer [iseq writer opts]
    (pr-sequential-writer writer pr-writer "(" " " ")" opts iseq)))

(extend-type LazySeq
  IPrintWithWriter
  (-pr-writer [lseq writer opts]
    (pr-sequential-writer writer pr-writer "(" " " ")" opts lseq)))

(extend-type PersistentMap
  IPrintWithWriter
  (-pr-writer [m writer opts]
    (-write writer "{")
    (when-let [s (seq m)]
      (pr-writer (key (first s)) writer opts)
      (-write writer " ")
      (pr-writer (val (first s)) writer opts)
      (loop [xs (next s)]
        (when xs
          (-write writer ", ")
          (pr-writer (key (first xs)) writer opts)
          (-write writer " ")
          (pr-writer (val (first xs)) writer opts)
          (recur (next xs)))))
    (-write writer "}")))

(extend-type PersistentSet
  IPrintWithWriter
  (-pr-writer [s writer opts]
    (-write writer "#{")
    (when-let [sq (seq s)]
      (pr-writer (first sq) writer opts)
      (loop [xs (next sq)]
        (when xs
          (-write writer " ")
          (pr-writer (first xs) writer opts)
          (recur (next xs)))))
    (-write writer "}")))

(extend-type MapEntry
  IPrintWithWriter
  (-pr-writer [e writer opts]
    (-write writer "[")
    (pr-writer (key e) writer opts)
    (-write writer " ")
    (pr-writer (val e) writer opts)
    (-write writer "]")))

;; ============================================================
;; UTF-8 String Infrastructure
;; ============================================================

(defn -utf8-continuation-byte?
  "Returns true if b is a UTF-8 continuation byte (10xxxxxx)."
  [b]
  (= 128 (bit-and b 192)))

(defn -utf8-lead-byte-length
  "Returns the number of bytes in a UTF-8 sequence starting with lead byte b."
  [b]
  (let [ub (if (< b 0) (+ b 256) b)]
    (cond
      (< ub 128) 1
      (< ub 192) 1
      (< ub 224) 2
      (< ub 240) 3
      (< ub 248) 4
      :else 1)))

(defn string-length
  "Returns the number of UTF-8 codepoints in string s."
  [s]
  (if (nil? s)
    0
    (let [len (alength s)]
      (loop [byte-idx 0 cnt 0]
        (if (>= byte-idx len)
          cnt
          (let [b (sget s byte-idx)
                ub (if (< b 0) (+ b 256) b)
                byte-len (-utf8-lead-byte-length ub)]
            (recur (+ byte-idx byte-len) (+ cnt 1))))))))

(defn -utf8-codepoint-to-byte-idx
  "Convert a codepoint index to byte index in string s."
  [s codepoint-idx]
  (let [len (alength s)]
    (loop [byte-idx 0 cp-idx 0]
      (cond
        (= cp-idx codepoint-idx) byte-idx
        (>= byte-idx len) -1
        :else
        (let [b (sget s byte-idx)
              ub (if (< b 0) (+ b 256) b)
              byte-len (-utf8-lead-byte-length ub)]
          (recur (+ byte-idx byte-len) (+ cp-idx 1)))))))

;; Helper to convert signed byte to unsigned
(defn -unsigned-byte [b]
  (if (< b 0) (+ b 256) b))

;; Decode just the codepoint value (not a pair)
(defn -utf8-decode-codepoint-value
  "Decode UTF-8 codepoint starting at byte index idx. Returns codepoint integer."
  [s idx]
  (let [len (alength s)
        b0 (sget s idx)
        ub0 (-unsigned-byte b0)]
    (cond
      ;; ASCII
      (< ub0 128) ub0
      ;; 2-byte
      (and (< ub0 224) (>= ub0 192) (< (+ idx 1) len))
      (let [ub1 (-unsigned-byte (sget s (+ idx 1)))]
        (bit-or (bit-shift-left (bit-and ub0 31) 6)
                (bit-and ub1 63)))
      ;; 3-byte
      (and (< ub0 240) (>= ub0 224) (< (+ idx 2) len))
      (let [ub1 (-unsigned-byte (sget s (+ idx 1)))
            ub2 (-unsigned-byte (sget s (+ idx 2)))]
        (bit-or (bit-or (bit-shift-left (bit-and ub0 15) 12)
                        (bit-shift-left (bit-and ub1 63) 6))
                (bit-and ub2 63)))
      ;; 4-byte
      (and (< ub0 248) (>= ub0 240) (< (+ idx 3) len))
      (let [ub1 (-unsigned-byte (sget s (+ idx 1)))
            ub2 (-unsigned-byte (sget s (+ idx 2)))
            ub3 (-unsigned-byte (sget s (+ idx 3)))]
        (bit-or (bit-or (bit-or (bit-shift-left (bit-and ub0 7) 18)
                                (bit-shift-left (bit-and ub1 63) 12))
                        (bit-shift-left (bit-and ub2 63) 6))
                (bit-and ub3 63)))
      ;; Invalid
      :else 65533)))

(defn char-at
  "Returns the Unicode codepoint at index idx (0-indexed by codepoint, not byte).
   Returns nil if idx is out of bounds."
  [s idx]
  (if (or (nil? s) (< idx 0))
    nil
    (let [byte-idx (-utf8-codepoint-to-byte-idx s idx)]
      (if (< byte-idx 0)
        nil
        (-utf8-decode-codepoint-value s byte-idx)))))

(defn subs
  "Returns the substring of s from start (inclusive) to end (exclusive).
   Indices are codepoint positions, not byte positions."
  [s start & args]
  (if (or (nil? s) (< start 0))
    ""
    (let [end (if (> (count args) 0)
                (nth args 0)
                (string-length s))
          start-byte (-utf8-codepoint-to-byte-idx s start)
          end-byte (-utf8-codepoint-to-byte-idx s end)]
      (cond
        (< start-byte 0) ""
        (< end-byte 0)
        ;; end is past the string, use full remaining length
        (let [len (- (alength s) start-byte)
              result (make-string len)]
          (scopy result 0 s start-byte len)
          result)
        (< end start) ""
        :else
        (let [len (- end-byte start-byte)
              result (make-string len)]
          (scopy result 0 s start-byte len)
          result)))))

;; ============================================================
;; Runtime String Concatenation
;; ============================================================

(defn -str-append-value
  "Append a value to a StringBuffer, converting to string as needed."
  [sb v]
  (cond
    (nil? v) nil  ;; nil contributes nothing to str
    (string? v) (-sb-append-str sb v)
    (int? v) (-sb-append-str sb (int->str v))
    (float? v) (-sb-append-str sb (float->str v))
    (keyword? v) (do
                   (-sb-append-str sb ":")
                   (when-let [ns (namespace v)]
                     (-sb-append-str sb ns)
                     (-sb-append-str sb "/"))
                   (-sb-append-str sb (name v)))
    (symbol? v) (do
                  (when-let [ns (namespace v)]
                    (-sb-append-str sb ns)
                    (-sb-append-str sb "/"))
                  (-sb-append-str sb (name v)))
    :else (-sb-append-str sb (pr-str v))))

(defn str
  "Concatenates values into a string. nil values are ignored."
  [& args]
  (let [len (count args)]
    (if (= len 0)
      ""
      (if (= len 1)
        ;; Single arg - optimize common case
        (let [v (nth args 0)]
          (cond
            (nil? v) ""
            (string? v) v
            (int? v) (int->str v)
            (float? v) (float->str v)
            :else
            (let [sb (string-buffer 32)]
              (-str-append-value sb v)
              (-sb->str sb))))
        ;; Multiple args
        (let [sb (string-buffer 64)]
          (loop [i 0]
            (when (< i len)
              (-str-append-value sb (nth args i))
              (recur (+ i 1))))
          (-sb->str sb))))))

;; ============================================================
;; String Predicates and Search
;; ============================================================

(defn -whitespace?
  "Returns true if byte b is ASCII whitespace (space, tab, newline, carriage return)."
  [b]
  (let [ub (-unsigned-byte b)]
    (or (= ub 32) (= ub 9) (= ub 10) (= ub 13))))

(defn blank?
  "True if s is nil, empty, or contains only whitespace."
  [s]
  (if (nil? s)
    true
    (let [len (alength s)]
      (if (= len 0)
        true
        (loop [i 0]
          (if (>= i len)
            true
            (if (-whitespace? (sget s i))
              (recur (+ i 1))
              false)))))))

(defn -bytes-equal?
  "Compare two byte sequences for equality. Returns true if s1[off1..off1+len] equals s2[off2..off2+len]."
  [s1 off1 s2 off2 len]
  (loop [i 0]
    (if (>= i len)
      true
      (if (= (sget s1 (+ off1 i)) (sget s2 (+ off2 i)))
        (recur (+ i 1))
        false))))

(defn starts-with?
  "True if s starts with substr."
  [s substr]
  (if (or (nil? s) (nil? substr))
    false
    (let [s-len (alength s)
          sub-len (alength substr)]
      (if (> sub-len s-len)
        false
        (-bytes-equal? s 0 substr 0 sub-len)))))

(defn ends-with?
  "True if s ends with substr."
  [s substr]
  (if (or (nil? s) (nil? substr))
    false
    (let [s-len (alength s)
          sub-len (alength substr)]
      (if (> sub-len s-len)
        false
        (-bytes-equal? s (- s-len sub-len) substr 0 sub-len)))))

(defn index-of
  "Returns the index of the first occurrence of substr in s, or -1 if not found.
   Optional from-index specifies the starting position for the search."
  [s substr & args]
  (if (or (nil? s) (nil? substr))
    -1
    (let [s-len (alength s)
          sub-len (alength substr)
          from (if (> (count args) 0) (nth args 0) 0)]
      (if (= sub-len 0)
        from
        (if (or (< from 0) (> sub-len s-len))
          -1
          (let [max-idx (- s-len sub-len)]
            (loop [i from]
              (if (> i max-idx)
                -1
                (if (-bytes-equal? s i substr 0 sub-len)
                  i
                  (recur (+ i 1)))))))))))

(defn last-index-of
  "Returns the index of the last occurrence of substr in s, or -1 if not found.
   Optional from-index specifies the starting position for the backward search."
  [s substr & args]
  (if (or (nil? s) (nil? substr))
    -1
    (let [s-len (alength s)
          sub-len (alength substr)
          max-idx (- s-len sub-len)
          from (if (> (count args) 0)
                 (min (nth args 0) max-idx)
                 max-idx)]
      (if (= sub-len 0)
        from
        (if (or (< from 0) (> sub-len s-len))
          -1
          (loop [i from]
            (if (< i 0)
              -1
              (if (-bytes-equal? s i substr 0 sub-len)
                i
                (recur (- i 1))))))))))

(defn includes?
  "True if s includes substr anywhere within it."
  [s substr]
  (>= (index-of s substr) 0))

;; ============================================================
;; String Transformation
;; ============================================================

(defn triml
  "Removes whitespace from the left side of string."
  [s]
  (if (or (nil? s) (= (alength s) 0))
    ""
    (let [len (alength s)]
      (loop [i 0]
        (if (>= i len)
          ""
          (if (-whitespace? (sget s i))
            (recur (+ i 1))
            (let [new-len (- len i)
                  result (make-string new-len)]
              (scopy result 0 s i new-len)
              result)))))))

(defn trimr
  "Removes whitespace from the right side of string."
  [s]
  (if (or (nil? s) (= (alength s) 0))
    ""
    (let [len (alength s)]
      (loop [i (- len 1)]
        (if (< i 0)
          ""
          (if (-whitespace? (sget s i))
            (recur (- i 1))
            (let [new-len (+ i 1)
                  result (make-string new-len)]
              (scopy result 0 s 0 new-len)
              result)))))))

(defn trim
  "Removes whitespace from both ends of string."
  [s]
  (triml (trimr s)))

(defn -ascii-upper-byte
  "Convert ASCII lowercase byte to uppercase. Other bytes unchanged."
  [b]
  (let [ub (-unsigned-byte b)]
    (if (and (>= ub 97) (<= ub 122))
      (- ub 32)
      b)))

(defn -ascii-lower-byte
  "Convert ASCII uppercase byte to lowercase. Other bytes unchanged."
  [b]
  (let [ub (-unsigned-byte b)]
    (if (and (>= ub 65) (<= ub 90))
      (+ ub 32)
      b)))

(defn upper-case
  "Converts string to all upper-case (ASCII characters only)."
  [s]
  (if (or (nil? s) (= (alength s) 0))
    ""
    (let [len (alength s)
          result (make-string len)]
      (loop [i 0]
        (if (>= i len)
          result
          (do
            (sset result i (-ascii-upper-byte (sget s i)))
            (recur (+ i 1))))))))

(defn lower-case
  "Converts string to all lower-case (ASCII characters only)."
  [s]
  (if (or (nil? s) (= (alength s) 0))
    ""
    (let [len (alength s)
          result (make-string len)]
      (loop [i 0]
        (if (>= i len)
          result
          (do
            (sset result i (-ascii-lower-byte (sget s i)))
            (recur (+ i 1))))))))

(defn join
  "Returns a string of all elements in coll, separated by sep.
   If called with one arg, uses no separator."
  [sep-or-coll & args]
  (if (= (count args) 0)
    ;; Single arg - it's a collection, no separator
    (let [coll sep-or-coll
          sb (string-buffer 64)]
      (loop [s (seq coll) first? true]
        (if s
          (do
            (-str-append-value sb (first s))
            (recur (next s) false))
          (-sb->str sb))))
    ;; Two args - separator and collection
    (let [sep sep-or-coll
          coll (nth args 0)
          sb (string-buffer 64)]
      (loop [s (seq coll) first? true]
        (if s
          (do
            (when (not first?)
              (-sb-append-str sb sep))
            (-str-append-value sb (first s))
            (recur (next s) false))
          (-sb->str sb))))))

(defn split
  "Splits string on a string delimiter. Returns a vector of strings."
  [s delim]
  (if (or (nil? s) (nil? delim))
    []
    (let [s-len (alength s)
          d-len (alength delim)]
      (if (= d-len 0)
        [s]
        (loop [start 0 result []]
          (let [idx (index-of s delim start)]
            (if (< idx 0)
              ;; No more delimiters - add remaining
              (if (>= start s-len)
                result
                (let [remain-len (- s-len start)
                      remain (make-string remain-len)]
                  (scopy remain 0 s start remain-len)
                  (conj result remain)))
              ;; Found delimiter - extract part before it
              (let [part-len (- idx start)
                    part (make-string part-len)]
                (scopy part 0 s start part-len)
                (recur (+ idx d-len) (conj result part))))))))))

;; ============================================================
;; Nested Data Structure Functions
;; ============================================================

(defn get-in
  "Returns the value in a nested associative structure, where ks is a sequence
   of keys. Returns nil if any key is not present, or not-found if supplied."
  [m ks & args]
  (let [not-found (if (> (count args) 0) (nth args 0) nil)]
    (loop [curr m keys (seq ks)]
      (if keys
        (if (nil? curr)
          not-found
          (let [k (first keys)
                nxt (get curr k)]
            (recur nxt (next keys))))
        curr))))

(defn assoc-in
  "Associates a value in a nested associative structure, where ks is a
   sequence of keys and v is the new value. Creates new structures if needed."
  [m ks v]
  (let [s (seq ks)]
    (if (nil? s)
      v
      (let [k (first s)
            rest-ks (next s)]
        (if (nil? rest-ks)
          (assoc m k v)
          (assoc m k (assoc-in (get m k) rest-ks v)))))))

(defn update
  "Updates a value in an associative structure by applying f to the current value.
   Supports up to 3 extra arguments to f."
  [m k f & args]
  (let [old (get m k)
        n (count args)]
    (cond
      (= n 0) (assoc m k (f old))
      (= n 1) (assoc m k (f old (nth args 0)))
      (= n 2) (assoc m k (f old (nth args 0) (nth args 1)))
      :else (assoc m k (f old (nth args 0) (nth args 1) (nth args 2))))))

(defn update-in
  "Updates a value in a nested associative structure by applying f
   at the location specified by ks."
  [m ks f]
  (let [s (seq ks)]
    (if (nil? s)
      (f m)
      (let [k (first s)
            rest-ks (next s)]
        (if (nil? rest-ks)
          (assoc m k (f (get m k)))
          (assoc m k (update-in (get m k) rest-ks f)))))))

(defn -merge-map-into
  "Merge entries from m2 into m1."
  [m1 m2]
  (if (nil? m2)
    m1
    (reduce (fn [acc entry]
              (assoc acc (key entry) (val entry)))
            m1
            (seq m2))))

(defn merge
  "Returns a map that is the merge of the maps. Nil maps are skipped.
   Later values override earlier ones for duplicate keys."
  [& maps]
  (let [n (count maps)]
    (loop [i 0 result {}]
      (if (>= i n)
        result
        (recur (+ i 1) (-merge-map-into result (nth maps i)))))))

(defn -merge-with-map-into
  "Merge entries from m2 into m1, using f to combine duplicate keys."
  [f m1 m2]
  (if (nil? m2)
    m1
    (reduce (fn [acc entry]
              (let [k (key entry)
                    v (val entry)
                    existing (get acc k)]
                (if (nil? existing)
                  (assoc acc k v)
                  (assoc acc k (f existing v)))))
            m1
            (seq m2))))

(defn merge-with
  "Returns a map that is the merge of the maps. For duplicate keys,
   f is called with the values from left and right to determine the result."
  [f & maps]
  (let [n (count maps)]
    (loop [i 0 result {}]
      (if (>= i n)
        result
        (recur (+ i 1) (-merge-with-map-into f result (nth maps i)))))))

(defn select-keys
  "Returns a map containing only those entries in m whose key is in keys."
  [m keyseq]
  (reduce (fn [acc k]
            (let [v (get m k)]
              (if (nil? v)
                acc
                (assoc acc k v))))
          {}
          keyseq))

(defn zipmap
  "Returns a map with the keys mapped to the corresponding vals."
  [keys vals]
  (loop [m {}
         ks (seq keys)
         vs (seq vals)]
    (if (and ks vs)
      (recur (assoc m (first ks) (first vs))
             (next ks)
             (next vs))
      m)))

;; ============================================================
;; Partitioning Functions
;; ============================================================

(defn split-at
  "Returns a vector of [(take n coll) (drop n coll)]."
  [n coll]
  [(take n coll) (drop n coll)])

(defn split-with
  "Returns a vector of [(take-while pred coll) (drop-while pred coll)]."
  [pred coll]
  [(take-while pred coll) (drop-while pred coll)])

(defn -take-n
  "Take up to n items from seq s, returning a vector."
  [n s]
  (loop [i 0 result [] xs s]
    (if (or (>= i n) (nil? xs))
      result
      (recur (+ i 1) (conj result (first xs)) (next xs)))))

(defn partition
  "Returns a lazy sequence of lists of n items each, at offsets step apart.
   If step is not supplied, defaults to n, i.e. partitions do not overlap.
   If a pad collection is supplied, uses its elements to complete the last
   partition up to n items. Only includes partitions with exactly n items."
  [n coll]
  (lazy-seq
    (let [s (seq coll)]
      (when s
        (let [p (-take-n n s)]
          (when (= (count p) n)
            (cons p (partition n (drop n s)))))))))

(defn partition-all
  "Returns a lazy sequence of lists of n items each, at offsets step apart.
   Unlike partition, includes incomplete partitions at the end."
  [n coll]
  (lazy-seq
    (let [s (seq coll)]
      (when s
        (let [p (-take-n n s)]
          (cons p (partition-all n (drop n s))))))))

(defn partition-by
  "Applies f to each value in coll, splitting it each time f returns a new value."
  [f coll]
  (lazy-seq
    (let [s (seq coll)]
      (when s
        (let [fst (first s)
              fv (f fst)]
          (loop [run [fst] xs (next s)]
            (if (nil? xs)
              (cons run nil)
              (let [x (first xs)]
                (if (= fv (f x))
                  (recur (conj run x) (next xs))
                  (cons run (partition-by f xs)))))))))))

;; ============================================================
;; Transformation Functions
;; ============================================================

(defn keep
  "Returns a lazy sequence of the non-nil results of (f item)."
  [f coll]
  (lazy-seq
    (let [s (seq coll)]
      (when s
        (let [x (f (first s))]
          (if (nil? x)
            (keep f (rest s))
            (cons x (keep f (rest s)))))))))

(defn -keep-indexed-helper
  "Helper for keep-indexed with index tracking."
  [f idx s]
  (lazy-seq
    (when s
      (let [x (f idx (first s))]
        (if (nil? x)
          (-keep-indexed-helper f (+ idx 1) (next s))
          (cons x (-keep-indexed-helper f (+ idx 1) (next s))))))))

(defn keep-indexed
  "Returns a lazy sequence of the non-nil results of (f index item)."
  [f coll]
  (-keep-indexed-helper f 0 (seq coll)))

(defn -map-indexed-helper
  "Helper for map-indexed with index tracking."
  [f idx s]
  (lazy-seq
    (when s
      (cons (f idx (first s))
            (-map-indexed-helper f (+ idx 1) (next s))))))

(defn map-indexed
  "Returns a lazy sequence of (f index item)."
  [f coll]
  (-map-indexed-helper f 0 (seq coll)))

(defn reductions
  "Returns a lazy seq of the intermediate values of the reduction."
  [f init coll]
  (lazy-seq
    (cons init
          (let [s (seq coll)]
            (when s
              (reductions f (f init (first s)) (rest s)))))))

(defn cycle
  "Returns a lazy infinite sequence of repetitions of coll items."
  [coll]
  (lazy-seq
    (let [s (seq coll)]
      (when s
        (concat2 s (cycle s))))))

(defn interleave
  "Returns a lazy seq of the first item in each coll, then the second, etc."
  [c1 c2]
  (lazy-seq
    (let [s1 (seq c1)
          s2 (seq c2)]
      (when (and s1 s2)
        (cons (first s1)
              (cons (first s2)
                    (interleave (rest s1) (rest s2))))))))

(defn interpose
  "Returns a lazy seq of the elements of coll separated by sep."
  [sep coll]
  (lazy-seq
    (let [s (seq coll)]
      (when s
        (cons (first s)
              (let [r (next s)]
                (when r
                  (cons sep (interpose sep r)))))))))

(defn -dedupe-step
  "Helper for dedupe - skips elements equal to prev."
  [prev s]
  (lazy-seq
    (when s
      (let [x (first s)]
        (if (= x prev)
          (-dedupe-step prev (next s))
          (cons x (-dedupe-step x (next s))))))))

(defn dedupe
  "Returns a lazy sequence removing consecutive duplicates."
  [coll]
  (lazy-seq
    (let [s (seq coll)]
      (when s
        (cons (first s) (-dedupe-step (first s) (next s)))))))

(defn nthrest
  "Returns the nth rest of coll."
  [coll n]
  (loop [i n s coll]
    (if (and (pos? i) (seq s))
      (recur (dec i) (rest s))
      s)))

(defn nthnext
  "Returns the nth next of coll, or nil."
  [coll n]
  (loop [i n s (seq coll)]
    (if (and (pos? i) s)
      (recur (dec i) (next s))
      s)))

(defn sequential?
  "Returns true if coll is sequential (vector, list, or seq)."
  [coll]
  (or (instance? PersistentVector coll)
      (instance? Cons coll)
      (instance? LazySeq coll)
      (instance? IndexedSeq coll)))

(defn flatten
  "Takes any nested combination of sequential things and returns their
   contents as a single, flat lazy sequence."
  [x]
  (lazy-seq
    (let [s (seq x)]
      (when s
        (let [fst (first s)]
          (if (sequential? fst)
            (concat2 (flatten fst) (flatten (rest s)))
            (cons fst (flatten (rest s)))))))))

;; ============================================================
;; Sort Functions
;; ============================================================

(defn compare
  "Comparator. Returns -1, 0, or 1 for less than, equal, or greater than."
  [x y]
  (cond
    (and (int? x) (int? y))
    (cond (< x y) -1 (> x y) 1 :else 0)

    (and (float? x) (float? y))
    (cond (< x y) -1 (> x y) 1 :else 0)

    (and (string? x) (string? y))
    (let [len-x (alength x)
          len-y (alength y)
          min-len (if (< len-x len-y) len-x len-y)]
      (loop [i 0]
        (if (>= i min-len)
          (cond (< len-x len-y) -1 (> len-x len-y) 1 :else 0)
          (let [cx (sget x i)
                cy (sget y i)]
            (cond
              (< cx cy) -1
              (> cx cy) 1
              :else (recur (+ i 1)))))))

    (and (keyword? x) (keyword? y))
    (compare (name x) (name y))

    :else 0))

(defn -median-of-three
  "Returns the median value of a, b, c using comparator comp."
  [comp a b c]
  (let [ab (comp a b)
        bc (comp b c)
        ac (comp a c)]
    (cond
      ;; a <= b
      (<= ab 0)
      (cond
        (<= bc 0) b      ;; a <= b <= c, median is b
        (<= ac 0) c      ;; a <= c < b, median is c
        :else a)         ;; c < a <= b, median is a
      ;; a > b
      :else
      (cond
        (>= bc 0) b      ;; c <= b < a, median is b
        (>= ac 0) c      ;; b < c <= a, median is c
        :else a))))      ;; b < a < c, median is a

(defn -quicksort
  "Quicksort implementation using median-of-three pivot selection."
  [comp coll]
  (let [v (vec coll)
        n (count v)]
    (cond
      (<= n 1) v
      (= n 2)
      (let [a (nth v 0) b (nth v 1)]
        (if (<= (comp a b) 0) [a b] [b a]))
      :else
      (let [first-elem (nth v 0)
            mid-elem (nth v (quot n 2))
            last-elem (nth v (- n 1))
            pivot (-median-of-three comp first-elem mid-elem last-elem)]
        (loop [i 0 less [] equal [] greater []]
          (if (>= i n)
            (vec (concat2 (concat2 (-quicksort comp less) equal)
                          (-quicksort comp greater)))
            (let [x (nth v i)
                  c (comp x pivot)]
              (cond
                (< c 0) (recur (+ i 1) (conj less x) equal greater)
                (> c 0) (recur (+ i 1) less equal (conj greater x))
                :else (recur (+ i 1) less (conj equal x) greater)))))))))

(defn sort
  "Returns a sorted sequence of the items in coll."
  [coll]
  (-quicksort compare coll))

(defn sort-by
  "Returns a sorted sequence of the items in coll, comparing (keyfn item)."
  [keyfn coll]
  (-quicksort (fn [x y] (compare (keyfn x) (keyfn y))) coll))

;; ============================================================
;; Documentation Functions
;; ============================================================

(defn doc
  "Returns the docstring of a Var. Use with (var symbol):
   (doc (var foo)) or (doc #'foo) with var-quote syntax."
  [v]
  (when-let [m (meta v)]
    (:doc m)))

;; ============================================================
;; Transient Collection Protocols
;;
;; Transients provide O(1) conversion to/from persistent collections
;; and enable efficient batch operations by allowing in-place mutation.
;; ============================================================

(defprotocol IEditableCollection
  "Protocol for collections which can be transformed to transients."
  (-as-transient [coll]))

(defprotocol ITransientCollection
  "Protocol for transient collections."
  (-conj! [tcoll val])
  (-persistent! [tcoll]))

(defprotocol ITransientAssociative
  "Protocol for transient associative collections."
  (-assoc! [tcoll key val]))

(defprotocol ITransientMap
  "Protocol for transient map operations."
  (-dissoc! [tcoll key]))

(defprotocol ITransientVector
  "Protocol for transient vector operations."
  (-assoc-n! [tcoll n val])
  (-pop! [tcoll]))

(defprotocol ITransientSet
  "Protocol for transient set operations."
  (-disjoin! [tcoll v]))

;; ============================================================
;; Transient Vector
;;
;; Mutable vector for batch construction. The tail array is mutable,
;; and tree nodes are copied lazily on first write.
;; edit-id is a unique token assigned at creation; -1 means invalidated.
;; ============================================================

(deftype TransientVector
  [^:mutable ^i32 tv-cnt
   ^:mutable ^i32 tv-shift
   ^:mutable tv-root
   ^:mutable tv-tail
   ^:mutable ^i32 tv-edit])

(defn -tv-ensure-editable
  "Ensure this transient is still valid for mutation."
  [tv]
  (when (= (.-tv-edit tv) -1)
    ;; In a real implementation, this would throw an exception
    ;; For now, we return nil to indicate error
    nil))

(defn -tv-push-tail!
  "Push tail into tree, mutating nodes when possible."
  [tv level parent tailnode]
  (let [subidx (bit-and (unsigned-bit-shift-right (- (.-tv-cnt tv) 1) level) 31)
        ret (aclone parent)]
    (if (= level 5)
      ;; At the deepest internal level - insert tailnode directly
      (do (aset ret subidx tailnode) ret)
      ;; Higher level - recurse down
      (let [child (aget parent subidx)]
        (if (nil? child)
          ;; No child exists - create new path
          (do (aset ret subidx (new-path (- level 5) tailnode)) ret)
          ;; Child exists - recurse into it
          (do (aset ret subidx (-tv-push-tail! tv (- level 5) child tailnode)) ret))))))

(extend-type TransientVector
  ITransientCollection
  (-conj! [tv val]
    (if (= (.-tv-edit tv) -1)
      nil  ;; Invalid - return nil to indicate error
      (let [cnt (.-tv-cnt tv)
            tail (.-tv-tail tv)
            tail-len (- cnt (tail-off cnt))]
        (if (< tail-len 32)
          ;; Space in tail - mutate in place
          (do (aset tail tail-len val)
              (set! (.-tv-cnt tv) (+ cnt 1))
              tv)
          ;; Tail full - push tail into tree
          (let [new-tail (make-array 32)
                shift (.-tv-shift tv)
                root (.-tv-root tv)]
            (aset new-tail 0 val)
            (if (> (unsigned-bit-shift-right cnt 5) (bit-shift-left 1 shift))
              ;; Root overflow - grow tree
              (let [new-root (make-array 32)]
                (aset new-root 0 root)
                (aset new-root 1 (new-path shift tail))
                (set! (.-tv-root tv) new-root)
                (set! (.-tv-shift tv) (+ shift 5))
                (set! (.-tv-tail tv) new-tail)
                (set! (.-tv-cnt tv) (+ cnt 1))
                tv)
              ;; No overflow
              (let [new-root (if (nil? root)
                               (new-path shift tail)
                               (-tv-push-tail! tv shift root tail))]
                (set! (.-tv-root tv) new-root)
                (set! (.-tv-tail tv) new-tail)
                (set! (.-tv-cnt tv) (+ cnt 1))
                tv)))))))

  (-persistent! [tv]
    (if (= (.-tv-edit tv) -1)
      nil  ;; Already persistent - error
      (let [cnt (.-tv-cnt tv)
            len (- cnt (tail-off cnt))
            trimmed-tail (make-array len)]
        (acopy trimmed-tail 0 (.-tv-tail tv) 0 len)
        (set! (.-tv-edit tv) -1)  ;; Invalidate transient
        (->PersistentVector cnt (.-tv-shift tv) (.-tv-root tv) trimmed-tail))))

  ICounted
  (-count [tv] (.-tv-cnt tv))

  IIndexed
  (-nth [tv n]
    (let [cnt (.-tv-cnt tv)]
      (if (or (< n 0) (>= n cnt))
        nil
        (if (>= n (tail-off cnt))
          (aget (.-tv-tail tv) (bit-and n 31))
          ;; In tree - traverse down
          (loop [node (.-tv-root tv)
                 level (.-tv-shift tv)]
            (if (> level 0)
              (recur (aget node (bit-and (unsigned-bit-shift-right n level) 31))
                     (- level 5))
              (aget node (bit-and n 31)))))))))

;; ============================================================
;; Transient Hash Map
;;
;; Mutable map for batch construction. The HAMT nodes are copied
;; lazily on first write within a transient session.
;; ============================================================

(deftype TransientHashMap
  [^:mutable ^i32 tm-cnt
   ^:mutable tm-root
   ^:mutable ^i32 tm-edit])

(extend-type TransientHashMap
  ITransientCollection
  (-conj! [tm entry]
    (-assoc! tm (key entry) (val entry)))

  (-persistent! [tm]
    (if (= (.-tm-edit tm) -1)
      nil  ;; Already persistent - error
      (do (set! (.-tm-edit tm) -1)
          (->PersistentMap (.-tm-cnt tm) (.-tm-root tm)))))

  ITransientAssociative
  (-assoc! [tm k v]
    (if (= (.-tm-edit tm) -1)
      nil  ;; Invalid - return nil
      (let [root (.-tm-root tm)
            h (hash k)]
        (if (nil? root)
          ;; Empty map - create first entry
          (let [arr (make-array 2)]
            (aset arr 0 k)
            (aset arr 1 v)
            (set! (.-tm-root tm) (->BitmapIndexedNode (hamt-bitpos h 0) arr))
            (set! (.-tm-cnt tm) 1)
            tm)
          ;; Check if key exists
          (let [sentinel (->NotFound)
                existing (inode-find root 0 h k sentinel)]
            (if (instance? NotFound existing)
              ;; New key - add and increment
              (do (set! (.-tm-root tm) (inode-assoc root 0 h k v))
                  (set! (.-tm-cnt tm) (+ (.-tm-cnt tm) 1))
                  tm)
              ;; Existing key - just update
              (do (set! (.-tm-root tm) (inode-assoc root 0 h k v))
                  tm)))))))

  ITransientMap
  (-dissoc! [tm k]
    (if (= (.-tm-edit tm) -1)
      nil
      (let [root (.-tm-root tm)
            h (hash k)]
        (if (nil? root)
          tm  ;; Empty map - nothing to remove
          (let [sentinel (->NotFound)
                existing (inode-find root 0 h k sentinel)]
            (if (instance? NotFound existing)
              tm  ;; Key not found
              (let [new-root (inode-dissoc root 0 h k)]
                (set! (.-tm-root tm) new-root)
                (set! (.-tm-cnt tm) (- (.-tm-cnt tm) 1))
                tm)))))))

  ICounted
  (-count [tm] (.-tm-cnt tm))

  ILookup
  (-lookup [tm k]
    (let [root (.-tm-root tm)]
      (if (nil? root)
        nil
        (let [sentinel (->NotFound)
              result (inode-find root 0 (hash k) k sentinel)]
          (if (instance? NotFound result)
            nil
            result))))))

;; ============================================================
;; Transient Hash Set
;;
;; Delegates to TransientHashMap for implementation.
;; ============================================================

(deftype TransientHashSet
  [^:mutable ts-map
   ^i32 _ts-marker])  ;; Structural distinction from TransientHashMap

(extend-type TransientHashSet
  ITransientCollection
  (-conj! [ts val]
    (set! (.-ts-map ts) (-assoc! (.-ts-map ts) val val))
    ts)

  (-persistent! [ts]
    (let [tm (.-ts-map ts)
          pm (-persistent! tm)]
      (if (nil? pm)
        nil
        (->PersistentSet (.-map-cnt pm) (.-map-root pm) 0))))

  ITransientSet
  (-disjoin! [ts val]
    (set! (.-ts-map ts) (-dissoc! (.-ts-map ts) val))
    ts)

  ICounted
  (-count [ts] (count (.-ts-map ts))))

;; ============================================================
;; Edit ID Counter
;;
;; Each transient gets a unique edit ID for ownership tracking.
;; Using a simple counter via mutable field in a def.
;; ============================================================

;; Note: This uses a zero-arg function to get next ID since we don't
;; have mutable globals yet. The function returns an incrementing value.
(def ^:private -edit-counter 0)

(defn -next-edit-id
  "Get the next unique edit ID for transient creation."
  []
  ;; Use a simple approach: return a fixed non-zero value
  ;; In a real implementation, this would be a thread-local counter
  ;; or use atomic operations. For now, just use 1 as a valid edit ID.
  1)

;; ============================================================
;; IEditableCollection Implementations
;; ============================================================

(extend-type PersistentVector
  IEditableCollection
  (-as-transient [v]
    ;; Create a 32-element tail and copy existing elements
    ;; This ensures we have room for conj! operations
    (let [old-tail (.-tail v)
          old-len (alength old-tail)
          new-tail (make-array 32)]
      (when (> old-len 0)
        (acopy new-tail 0 old-tail 0 old-len))
      (->TransientVector (.-cnt v)
                         (.-shift v)
                         (.-root v)
                         new-tail
                         (-next-edit-id)))))

(extend-type PersistentMap
  IEditableCollection
  (-as-transient [m]
    (->TransientHashMap (.-map-cnt m)
                        (.-map-root m)
                        (-next-edit-id))))

(extend-type PersistentSet
  IEditableCollection
  (-as-transient [s]
    (->TransientHashSet (-as-transient (->PersistentMap (.-set-cnt s)
                                                        (.-set-root s)))
                        0)))

;; ============================================================
;; Public Transient API Functions
;; ============================================================

(defn transient
  "Returns a new, transient version of the collection, in constant time."
  [coll]
  (-as-transient coll))

(defn persistent!
  "Returns a new, persistent version of the transient collection.
   The transient cannot be used after this call."
  [tcoll]
  (-persistent! tcoll))

(defn conj!
  "Adds val to the transient collection, returns tcoll.
   Note: Currently only supports (conj! coll val) form.
   Variadic form will be added when multi-arity + variadic is fixed."
  [tcoll val]
  (-conj! tcoll val))

(defn assoc!
  "Associates key with val in transient map/vector.
   Note: Currently only supports (assoc! coll key val) form."
  [tcoll key val]
  (-assoc! tcoll key val))

(defn dissoc!
  "Removes key from transient map.
   Note: Currently only supports (dissoc! coll key) form."
  [tcoll key]
  (-dissoc! tcoll key))

(defn pop!
  "Removes last item from transient vector."
  [tcoll]
  (-pop! tcoll))

(defn disj!
  "Removes val from transient set.
   Note: Currently only supports (disj! coll val) form."
  [tcoll val]
  (-disjoin! tcoll val))

;; ============================================================
;; Atoms (Mutable Reference Type)
;; ============================================================

(deftype Atom [^:mutable state ^:mutable validator ^:mutable watches])

(defn atom
  "Creates and returns an Atom with an initial value of x."
  [x]
  (->Atom x nil {}))

(defn deref
  "Returns the current value of the atom."
  [a]
  (.-state a))

(defn reset!
  "Sets the value of atom to newval without regard for the
   current value. Returns newval."
  [a newval]
  (let [v (.-validator a)]
    (when (not (nil? v))
      (when (not (v newval))
        nil))  ;; TODO: throw when we have exceptions
    (set! (.-state a) newval)
    newval))

(defn swap!
  "Atomically swaps the value of atom to be:
   (apply f current-value-of-atom args). Returns new value."
  [a f & args]
  (let [oldval (deref a)
        newval (apply f (reduce conj [oldval] args))]
    (reset! a newval)))

(defn compare-and-set!
  "Atomically sets the value of atom to newval if and only if
   the current value of the atom is identical to oldval.
   Returns true if set happened, else false."
  [a oldval newval]
  (if (= (deref a) oldval)
    (do (reset! a newval) true)
    false))

(defn add-watch
  "Adds a watch function to an atom. The watch fn must be a fn
   of 4 args: a key, the atom, its old-state, its new-state."
  [a key f]
  (set! (.-watches a) (assoc (.-watches a) key f))
  a)

(defn remove-watch
  "Removes a watch (set by add-watch) from an atom."
  [a key]
  (set! (.-watches a) (dissoc (.-watches a) key))
  a)

(defn set-validator!
  "Sets the validator-fn for an atom. validator-fn must be nil or a
   side-effect-free fn of one argument, which will be passed the
   intended new state on any state change."
  [a f]
  (set! (.-validator a) f)
  nil)
