;; Original M0-02 probe: cancel a pending endpoint read without writing its payload.
(component
  (type $stream (stream u8))
  (core module $memory (memory (export "memory") 1))
  (core instance $memory (instantiate $memory))
  (core func $read (canon stream.read $stream async
    (memory (core memory $memory "memory"))))
  (core func $drop (canon stream.drop-readable $stream))
  (core func $cancel (canon stream.cancel-read $stream async))
  (core func $return (canon task.return (result u32)))
  (core func $set.new (canon waitable-set.new))
  (core func $set.drop (canon waitable-set.drop))
  (core func $join (canon waitable.join))
  (core module $guest
    (import "host" "memory" (memory 1))
    (import "host" "read" (func $read (param i32 i32 i32) (result i32)))
    (import "host" "drop" (func $drop (param i32)))
    (import "host" "cancel" (func $cancel (param i32) (result i32)))
    (import "host" "return" (func $return (param i32)))
    (import "host" "set.new" (func $set.new (result i32)))
    (import "host" "set.drop" (func $set.drop (param i32)))
    (import "host" "join" (func $join (param i32 i32)))
    (global $set (mut i32) (i32.const 0))
    (global $stream (mut i32) (i32.const 0))
    (func (export "enter") (param $stream i32) (result i32)
      (global.set $stream (local.get $stream))
      (global.set $set (call $set.new))
      (i32.store (i32.const 0) (i32.const 305419896))
      (if (i32.ne (call $read (local.get $stream) (i32.const 0) (i32.const 1)) (i32.const -1))
        (then unreachable))
      (if (i32.ne (call $cancel (local.get $stream)) (i32.const -1))
        (then unreachable))
      (call $join (local.get $stream) (global.get $set))
      (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))
    (func (export "callback") (param $event i32) (param $handle i32)
          (param $status i32) (result i32)
      (if (i32.ne (local.get $event) (i32.const 2)) (then unreachable))
      (if (i32.ne (local.get $handle) (global.get $stream)) (then unreachable))
      (if (i32.ne (local.get $status) (i32.const 2)) (then unreachable))
      (call $drop (global.get $stream))
      (call $set.drop (global.get $set))
      (if (i32.ne (i32.load (i32.const 0)) (i32.const 305419896)) (then unreachable))
      (call $return (i32.const 99))
      (i32.const 0)))
  (core instance $host
    (export "memory" (memory $memory "memory"))
    (export "read" (func $read)) (export "drop" (func $drop))
    (export "cancel" (func $cancel))
    (export "return" (func $return)) (export "set.new" (func $set.new))
    (export "set.drop" (func $set.drop)) (export "join" (func $join)))
  (core instance $guest (instantiate $guest (with "host" (instance $host))))
  (func (export "read") async (param "value" $stream) (result u32)
    (canon lift (core func $guest "enter") async
      (callback (core func $guest "callback")))))
