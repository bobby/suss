;; Regenerate: wasm-tools parse canonical_event6_caller.wat -o canonical_event6_caller.wasm
;; The test replaces the empty callee component with the production-generated bytes.
(component
      (import "increment" (func $increment async (param "value" u32) (result u32)))
      (import "ready" (func $ready (result u32)))
      (import "ack" (func $ack))
      (import "event6-witness" (func $witness))
      (component $callee)
      (instance $callee (instantiate $callee (with "increment" (func $increment))
        (with "event6-witness" (func $witness))))
      (alias export $callee "run" (func $run))
      (export "observe" (func $run))
      (core module $memory (memory (export "memory") 1))
      (core instance $memory (instantiate $memory))
      (alias core export $memory "memory" (core memory $linear-memory))
      (core func $run (canon lower (func $run) async
        (memory $linear-memory)))
      (core func $ready (canon lower (func $ready)))
      (core func $ack (canon lower (func $ack)))
      (core func $return (canon task.return (result u32)))
      (core func $set.new (canon waitable-set.new))
      (core func $set.drop (canon waitable-set.drop))
      (core func $join (canon waitable.join))
      (core func $drop (canon subtask.drop))
      (core func $cancel (canon subtask.cancel async))
      (core module $caller
        (import "host" "run" (func $run (param i32 i32) (result i32)))
        (import "host" "ready" (func $ready (result i32)))
        (import "host" "ack" (func $ack))
        (import "host" "return" (func $return (param i32)))
        (import "host" "set.new" (func $set.new (result i32)))
        (import "host" "set.drop" (func $set.drop (param i32)))
        (import "host" "join" (func $join (param i32 i32)))
        (import "host" "drop" (func $drop (param i32)))
        (import "host" "cancel" (func $cancel (param i32) (result i32)))
        (global $set (mut i32) (i32.const 0))
        (global $task (mut i32) (i32.const 0))
        (global $phase (mut i32) (i32.const 0))
        (func (export "enter") (param $mode i32) (result i32)
          (local $receipt i32)
          (global.set $phase (i32.const 0))
          (global.set $set (call $set.new))
          (local.set $receipt (call $run (local.get $mode) (i32.const 0)))
          (if (i32.gt_u (i32.and (local.get $receipt) (i32.const 15)) (i32.const 1))
            (then unreachable))
          (global.set $task (i32.shr_u (local.get $receipt) (i32.const 4)))
          (i32.const 1)) ;; YIELD until the callee's real I/O was polled
        (func (export "callback") (param $event i32) (param $handle i32)
              (param $status i32) (result i32)
          (if (i32.eqz (global.get $phase))
            (then
              (if (local.get $event) (then unreachable))
              (if (i32.eqz (call $ready)) (then (return (i32.const 1))))
              ;; This sends event 6 to the GENERATED callee, not a Rust abort
              ;; and not a call to source cancel! on an imported completion.
              (if (i32.ne (call $cancel (global.get $task)) (i32.const -1))
                (then unreachable))
              (global.set $phase (i32.const 1))
              (call $join (global.get $task) (global.get $set))
              (return (i32.or (i32.const 2) (i32.shl (global.get $set) (i32.const 4))))))
          (if (i32.ne (local.get $event) (i32.const 1)) (then unreachable))
          (if (i32.ne (local.get $handle) (global.get $task)) (then unreachable))
          (if (i32.ne (local.get $status) (i32.const 4)) (then unreachable))
          ;; Observe resource disposal at the cancellation acknowledgment, while
          ;; both components and the Store are still alive.
          (call $ack)
          (call $drop (global.get $task))
          (call $set.drop (global.get $set))
          (call $return (i32.const 99))
          (i32.const 0)))
      (core instance $host
        (export "run" (func $run)) (export "ready" (func $ready))
        (export "ack" (func $ack)) (export "return" (func $return))
        (export "set.new" (func $set.new)) (export "set.drop" (func $set.drop))
        (export "join" (func $join)) (export "drop" (func $drop))
        (export "cancel" (func $cancel)))
      (core instance $caller (instantiate $caller (with "host" (instance $host))))
      (alias core export $caller "enter" (core func $enter))
      (alias core export $caller "callback" (core func $callback))
      (func (export "cancel-run") async (param "mode" u32) (result u32)
        (canon lift (core func $enter) async
          (callback $callback))))
