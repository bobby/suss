  (func $from_memory (param $ptr i32) (param $n i32) (result (ref $limbs))
    (local $r (ref null $limbs)) (local $i i32)
    (local.set $r (array.new_default $limbs (local.get $n)))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (array.set $limbs (local.get $r) (local.get $i)
        (i32.load (i32.add (local.get $ptr) (i32.shl (local.get $i) (i32.const 2)))))
