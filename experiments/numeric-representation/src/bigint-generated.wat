(func $bridge_mul (param $a (ref $limbs)) (param $b (ref $limbs)) (result (ref $limbs) i32)
      (local $la i32) (local $lb i32) (local $used i32) (local $bp i32) (local $out i32) (local $r (ref null $limbs))
