(module
  (type $f (struct (field f64)))
  (type $i (struct (field i64)))
  (global $sf (mut eqref) (ref.null eq))
  (global $si (mut eqref) (ref.null eq))
  (global $s31 (mut eqref) (ref.null eq))
  (global $s31t (mut eqref) (ref.null eq))

  ;; live heap: an array of k boxed longs, kept reachable for the whole run
  (type $arr (array (mut eqref)))
  (global $live (mut (ref null $arr)) (ref.null $arr))
  (func (export "retain") (param $k i32)
    (local $a (ref $arr))
    (local.set $a (array.new $arr (ref.null eq) (local.get $k)))
    (block $done (loop $l
      (br_if $done (i32.eqz (local.get $k)))
      (local.set $k (i32.sub (local.get $k) (i32.const 1)))
      (array.set $arr (local.get $a) (local.get $k)
        (struct.new $i (i64.extend_i32_u (local.get $k))))
      (br $l)))
    (global.set $live (local.get $a)))

  (func (export "setup")
    (global.set $sf (struct.new $f (f64.const 1)))
    (global.set $si (struct.new $i (i64.const 1)))
    (global.set $s31 (ref.i31 (i32.const 1)))
    (global.set $s31t (ref.i31 (i32.const 3))))

  ;; to-i64 for checking results
  (func $to_i64 (param $x eqref) (result i64)
    (if (ref.test (ref i31) (local.get $x))
      (then (return (i64.extend_i32_s (i31.get_s (ref.cast (ref i31) (local.get $x)))))))
    (if (ref.test (ref $i) (local.get $x))
      (then (return (struct.get $i 0 (ref.cast (ref $i) (local.get $x))))))
    (i64.trunc_f64_s (struct.get $f 0 (ref.cast (ref $f) (local.get $x)))))

  ;; a. boxed f64
  (func (export "a_f64box") (param $n i64) (param $start i64) (result i64)
    (local $acc eqref)
    (local.set $acc (struct.new $f (f64.convert_i64_s (local.get $start))))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $n)))
      (local.set $acc (struct.new $f (f64.add
        (struct.get $f 0 (ref.cast (ref $f) (local.get $acc)))
        (struct.get $f 0 (ref.cast (ref $f) (global.get $sf))))))
      (local.set $n (i64.sub (local.get $n) (i64.const 1)))
      (br $l)))
    (call $to_i64 (local.get $acc)))

  ;; b. boxed i64 with overflow check
  (func (export "b_i64box") (param $n i64) (param $start i64) (result i64)
    (local $acc eqref) (local $x i64) (local $y i64) (local $r i64)
    (local.set $acc (struct.new $i (local.get $start)))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $n)))
      (local.set $x (struct.get $i 0 (ref.cast (ref $i) (local.get $acc))))
      (local.set $y (struct.get $i 0 (ref.cast (ref $i) (global.get $si))))
      (local.set $r (i64.add (local.get $x) (local.get $y)))
      (if (i64.lt_s (i64.and (i64.xor (local.get $x) (local.get $r))
                             (i64.xor (local.get $y) (local.get $r))) (i64.const 0))
        (then unreachable))
      (local.set $acc (struct.new $i (local.get $r)))
      (local.set $n (i64.sub (local.get $n) (i64.const 1)))
      (br $l)))
    (call $to_i64 (local.get $acc)))

  ;; slow path shared by c: general i64 add of i31-or-i64box operands
  (func $long_of (param $v eqref) (result i64)
    (if (result i64) (ref.test (ref i31) (local.get $v))
      (then (i64.extend_i32_s (i31.get_s (ref.cast (ref i31) (local.get $v)))))
      (else (struct.get $i 0 (ref.cast (ref $i) (local.get $v))))))
  (func $box_long (param $r i64) (result eqref)
    ;; canonicalise: values in i31 range become i31
    (if (result eqref) (i64.eq (local.get $r)
                         (i64.shr_s (i64.shl (local.get $r) (i64.const 33)) (i64.const 33)))
      (then (ref.i31 (i32.wrap_i64 (local.get $r))))
      (else (struct.new $i (local.get $r)))))
  (func $add_slow (param $a eqref) (param $b eqref) (result eqref)
    (local $x i64) (local $y i64) (local $r i64)
    (local.set $x (call $long_of (local.get $a)))
    (local.set $y (call $long_of (local.get $b)))
    (local.set $r (i64.add (local.get $x) (local.get $y)))
    (if (i64.lt_s (i64.and (i64.xor (local.get $x) (local.get $r))
                           (i64.xor (local.get $y) (local.get $r))) (i64.const 0))
      (then unreachable))
    (call $box_long (local.get $r)))

  ;; c. i31 fast path inline, boxed i64 fallback (out-of-line call)
  (func (export "c_i31") (param $n i64) (param $start i64) (result i64)
    (local $acc eqref) (local $b eqref) (local $r i32)
    (local.set $acc (call $box_long (local.get $start)))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $n)))
      (local.set $b (global.get $s31))
      (block $slow
        (br_if $slow (i32.eqz (ref.test (ref i31) (local.get $acc))))
        (br_if $slow (i32.eqz (ref.test (ref i31) (local.get $b))))
        (local.set $r (i32.add (i31.get_s (ref.cast (ref i31) (local.get $acc)))
                               (i31.get_s (ref.cast (ref i31) (local.get $b)))))
        ;; fits in 31 bits?
        (br_if $slow (i32.ne (local.get $r)
                       (i32.shr_s (i32.shl (local.get $r) (i32.const 1)) (i32.const 1))))
        (local.set $acc (ref.i31 (local.get $r)))
        (local.set $n (i64.sub (local.get $n) (i64.const 1)))
        (br $l))
      (local.set $acc (call $add_slow (local.get $acc) (local.get $b)))
      (local.set $n (i64.sub (local.get $n) (i64.const 1)))
      (br $l)))
    (call $to_i64 (local.get $acc)))

  ;; d. unboxed i64, with and without overflow check
  (func (export "d_i64_checked") (param $n i64) (param $start i64) (result i64)
    (local $acc i64) (local $y i64) (local $r i64)
    (local.set $acc (local.get $start))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $n)))
      (local.set $y (struct.get $i 0 (ref.cast (ref $i) (global.get $si))))
      (local.set $r (i64.add (local.get $acc) (local.get $y)))
      (if (i64.lt_s (i64.and (i64.xor (local.get $acc) (local.get $r))
                             (i64.xor (local.get $y) (local.get $r))) (i64.const 0))
        (then unreachable))
      (local.set $acc (local.get $r))
      (local.set $n (i64.sub (local.get $n) (i64.const 1)))
      (br $l)))
    (local.get $acc))
  (global $ystep (mut i64) (i64.const 1))
  (func (export "d_i64_plain") (param $n i64) (param $start i64) (result i64)
    (local $acc i64)
    (local.set $acc (local.get $start))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $n)))
      (local.set $acc (i64.add (local.get $acc) (global.get $ystep)))
      (local.set $n (i64.sub (local.get $n) (i64.const 1)))
      (br $l)))
    (local.get $acc))

  ;; e. polymorphic + : out-of-line call, tests i31 / i64box / f64box
  (func $poly_add (param $a eqref) (param $b eqref) (result eqref)
    (local $r i32)
    (if (i32.and (ref.test (ref i31) (local.get $a)) (ref.test (ref i31) (local.get $b)))
      (then
        (local.set $r (i32.add (i31.get_s (ref.cast (ref i31) (local.get $a)))
                               (i31.get_s (ref.cast (ref i31) (local.get $b)))))
        (if (i32.eq (local.get $r)
              (i32.shr_s (i32.shl (local.get $r) (i32.const 1)) (i32.const 1)))
          (then (return (ref.i31 (local.get $r)))))))
    (if (i32.or (ref.test (ref $f) (local.get $a)) (ref.test (ref $f) (local.get $b)))
      (then (return (struct.new $f (f64.add (call $dbl_of (local.get $a))
                                            (call $dbl_of (local.get $b)))))))
    (call $add_slow (local.get $a) (local.get $b)))
  (func $dbl_of (param $v eqref) (result f64)
    (if (result f64) (ref.test (ref $f) (local.get $v))
      (then (struct.get $f 0 (ref.cast (ref $f) (local.get $v))))
      (else (f64.convert_i64_s (call $long_of (local.get $v))))))
  (func $poly_loop (param $n i64) (param $acc eqref) (param $step eqref) (result i64)
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $n)))
      (local.set $acc (call $poly_add (local.get $acc) (local.get $step)))
      (local.set $n (i64.sub (local.get $n) (i64.const 1)))
      (br $l)))
    (call $to_i64 (local.get $acc)))
  (func (export "e_poly_i31") (param $n i64) (param $start i64) (result i64)
    (call $poly_loop (local.get $n) (call $box_long (local.get $start)) (global.get $s31)))
  (func (export "e_poly_i64box") (param $n i64) (param $start i64) (result i64)
    (call $poly_loop (local.get $n) (call $box_long (local.get $start)) (global.get $si)))
  (func (export "e_poly_f64box") (param $n i64) (param $start i64) (result i64)
    (call $poly_loop (local.get $n) (struct.new $f (f64.convert_i64_s (local.get $start))) (global.get $sf)))
  ;; a as out-of-line call, to separate call overhead from dispatch
  (func $add_f (param $a eqref) (param $b eqref) (result eqref)
    (struct.new $f (f64.add (struct.get $f 0 (ref.cast (ref $f) (local.get $a)))
                            (struct.get $f 0 (ref.cast (ref $f) (local.get $b))))))
  (func (export "e_call_f64only") (param $n i64) (param $start i64) (result i64)
    (local $acc eqref)
    (local.set $acc (struct.new $f (f64.convert_i64_s (local.get $start))))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $n)))
      (local.set $acc (call $add_f (local.get $acc) (global.get $sf)))
      (local.set $n (i64.sub (local.get $n) (i64.const 1)))
      (br $l)))
    (call $to_i64 (local.get $acc)))
  ;; c'. tagged i31 (ADR-0003): a long v in 30 bits is i31 (v << 1) | 1; even
  ;; i31 values are sentinels. Leaving that range (not reached here) traps.
  (func (export "c_i31_tagged") (param $n i64) (param $start i64) (result i64)
    (local $acc eqref) (local $b eqref) (local $x i32) (local $y i32) (local $r i32)
    (local.set $acc (ref.i31 (i32.or (i32.shl (i32.wrap_i64 (local.get $start)) (i32.const 1))
                                     (i32.const 1))))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $n)))
      (local.set $b (global.get $s31t))
      (block $slow
        (br_if $slow (i32.eqz (ref.test (ref i31) (local.get $acc))))
        (br_if $slow (i32.eqz (ref.test (ref i31) (local.get $b))))
        (local.set $x (i31.get_s (ref.cast (ref i31) (local.get $acc))))
        (local.set $y (i31.get_s (ref.cast (ref i31) (local.get $b))))
        (br_if $slow (i32.eqz (i32.and (i32.and (local.get $x) (local.get $y)) (i32.const 1))))
        ;; (2a+1) + (2b+1) - 1 = 2(a+b) + 1
        (local.set $r (i32.sub (i32.add (local.get $x) (local.get $y)) (i32.const 1)))
        (br_if $slow (i32.ne (local.get $r)
                       (i32.shr_s (i32.shl (local.get $r) (i32.const 1)) (i32.const 1))))
        (local.set $acc (ref.i31 (local.get $r)))
        (local.set $n (i64.sub (local.get $n) (i64.const 1)))
        (br $l))
      unreachable))
    (i64.extend_i32_s (i32.shr_s (i31.get_s (ref.cast (ref i31) (local.get $acc))) (i32.const 1))))

  ;; ---- #335: sentinel designs, measured with real fallbacks ----
  ;; Design A (ADR-0003 as written): a long v in 30 bits is i31 (v << 1) | 1;
  ;; nil, false, true and undefined are the even i31 values 0, 2, 4 and 6.
  ;; Design B: every i31 is a 31-bit long; nil is ref.null, and false, true
  ;; and undefined are singleton structs.
  (type $sent (struct (field i32)))
  (global $bfalse (mut eqref) (ref.null eq))
  (global $btrue (mut eqref) (ref.null eq))
  (global $bundef (mut eqref) (ref.null eq))
  ;; Design C: as B, with nil a singleton struct too, so values are never null.
  (global $bnil (mut eqref) (ref.null eq))
  (global $mixC (mut (ref null $arr)) (ref.null $arr))
  (global $mixA (mut (ref null $arr)) (ref.null $arr))
  (global $mixB (mut (ref null $arr)) (ref.null $arr))
  (global $oneA (mut eqref) (ref.null eq))
  (global $oneB (mut eqref) (ref.null eq))

  (func $longA (param $v eqref) (result i64)
    (if (result i64) (ref.test (ref i31) (local.get $v))
      (then (i64.extend_i32_s (i32.shr_s (i31.get_s (ref.cast (ref i31) (local.get $v))) (i32.const 1))))
      (else (struct.get $i 0 (ref.cast (ref $i) (local.get $v))))))
  (func $boxA (param $r i64) (result eqref)
    (if (result eqref) (i64.eq (local.get $r)
                         (i64.shr_s (i64.shl (local.get $r) (i64.const 34)) (i64.const 34)))
      (then (ref.i31 (i32.or (i32.shl (i32.wrap_i64 (local.get $r)) (i32.const 1)) (i32.const 1))))
      (else (struct.new $i (local.get $r)))))
  (func $add_slowA (param $a eqref) (param $b eqref) (result eqref)
    (local $x i64) (local $y i64) (local $r i64)
    (local.set $x (call $longA (local.get $a)))
    (local.set $y (call $longA (local.get $b)))
    (local.set $r (i64.add (local.get $x) (local.get $y)))
    (if (i64.lt_s (i64.and (i64.xor (local.get $x) (local.get $r))
                           (i64.xor (local.get $y) (local.get $r))) (i64.const 0))
      (then unreachable))
    (call $boxA (local.get $r)))
  (func $to_i64A (param $x eqref) (result i64) (call $longA (local.get $x)))

  (func (export "setup2")
    (local $k i32) (local $a (ref $arr)) (local $b (ref $arr)) (local $m i32)
    (global.set $bfalse (struct.new $sent (i32.const 0)))
    (global.set $btrue (struct.new $sent (i32.const 1)))
    (global.set $bundef (struct.new $sent (i32.const 2)))
    (global.set $bnil (struct.new $sent (i32.const 3)))
    (global.set $oneA (ref.i31 (i32.const 3)))
    (global.set $oneB (ref.i31 (i32.const 1)))
    ;; 1024 values: per 8, five numbers (i31 and boxed), nil, false, true
    (local.set $a (array.new $arr (ref.null eq) (i32.const 1024)))
    (local.set $b (array.new $arr (ref.null eq) (i32.const 1024)))
    (block $done (loop $l
      (br_if $done (i32.eq (local.get $k) (i32.const 1024)))
      (local.set $m (i32.and (local.get $k) (i32.const 7)))
      (if (i32.eq (local.get $m) (i32.const 5))
        (then (array.set $arr (local.get $a) (local.get $k) (ref.i31 (i32.const 0)))
              (array.set $arr (local.get $b) (local.get $k) (ref.null eq)))
      (else (if (i32.eq (local.get $m) (i32.const 6))
        (then (array.set $arr (local.get $a) (local.get $k) (ref.i31 (i32.const 2)))
              (array.set $arr (local.get $b) (local.get $k) (global.get $bfalse)))
      (else (if (i32.eq (local.get $m) (i32.const 7))
        (then (array.set $arr (local.get $a) (local.get $k) (ref.i31 (i32.const 4)))
              (array.set $arr (local.get $b) (local.get $k) (global.get $btrue)))
      (else (if (i32.eq (local.get $m) (i32.const 4))
        (then (array.set $arr (local.get $a) (local.get $k) (struct.new $i (i64.const 1)))
              (array.set $arr (local.get $b) (local.get $k) (struct.new $i (i64.const 1))))
      (else
        (array.set $arr (local.get $a) (local.get $k)
          (ref.i31 (i32.or (i32.shl (local.get $k) (i32.const 1)) (i32.const 1))))
        (array.set $arr (local.get $b) (local.get $k) (ref.i31 (local.get $k)))))))))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $l)))
    (global.set $mixA (local.get $a))
    (global.set $mixB (local.get $b))
    ;; C is B with every null replaced by the nil struct
    (local.set $a (array.new $arr (ref.null eq) (i32.const 1024)))
    (local.set $k (i32.const 0))
    (block $done (loop $l
      (br_if $done (i32.eq (local.get $k) (i32.const 1024)))
      (array.set $arr (local.get $a) (local.get $k)
        (if (result eqref) (ref.is_null (array.get $arr (local.get $b) (local.get $k)))
          (then (global.get $bnil))
          (else (array.get $arr (local.get $b) (local.get $k)))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $l)))
    (global.set $mixC (local.get $a)))
  (func (export "g_truthyC") (param $n i64) (param $start i64) (result i64)
    (local $a (ref $arr)) (local $v eqref) (local $i i32) (local $c i64) (local $k i64)
    (local.set $a (ref.as_non_null (global.get $mixC)))
    (local.set $k (local.get $n))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $k)))
      (local.set $v (array.get $arr (local.get $a) (i32.and (local.get $i) (i32.const 1023))))
      (if (i32.eqz (i32.or (i32.or
              (ref.eq (local.get $v) (global.get $bnil))
              (ref.eq (local.get $v) (global.get $bfalse)))
              (ref.eq (local.get $v) (global.get $bundef))))
        (then (local.set $c (i64.add (local.get $c) (i64.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (local.set $k (i64.sub (local.get $k) (i64.const 1)))
      (br $l)))
    (global.set $count (local.get $c))
    (i64.add (local.get $start) (local.get $n)))

  ;; Arithmetic with a real out-of-line fallback. A: tagged; B: untagged.
  (func (export "f_addA") (param $n i64) (param $start i64) (result i64)
    (local $acc eqref) (local $b eqref) (local $x i32) (local $y i32) (local $r i32)
    (local.set $acc (call $boxA (local.get $start)))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $n)))
      (local.set $b (global.get $oneA))
      (block $slow
        (br_if $slow (i32.eqz (ref.test (ref i31) (local.get $acc))))
        (br_if $slow (i32.eqz (ref.test (ref i31) (local.get $b))))
        (local.set $x (i31.get_s (ref.cast (ref i31) (local.get $acc))))
        (local.set $y (i31.get_s (ref.cast (ref i31) (local.get $b))))
        (br_if $slow (i32.eqz (i32.and (i32.and (local.get $x) (local.get $y)) (i32.const 1))))
        (local.set $r (i32.sub (i32.add (local.get $x) (local.get $y)) (i32.const 1)))
        (br_if $slow (i32.ne (local.get $r)
                       (i32.shr_s (i32.shl (local.get $r) (i32.const 1)) (i32.const 1))))
        (local.set $acc (ref.i31 (local.get $r)))
        (local.set $n (i64.sub (local.get $n) (i64.const 1)))
        (br $l))
      (local.set $acc (call $add_slowA (local.get $acc) (local.get $b)))
      (local.set $n (i64.sub (local.get $n) (i64.const 1)))
      (br $l)))
    (call $to_i64A (local.get $acc)))
  (func (export "f_addB") (param $n i64) (param $start i64) (result i64)
    (local $acc eqref) (local $b eqref) (local $r i32)
    (local.set $acc (call $box_long (local.get $start)))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $n)))
      (local.set $b (global.get $oneB))
      (block $slow
        (br_if $slow (i32.eqz (ref.test (ref i31) (local.get $acc))))
        (br_if $slow (i32.eqz (ref.test (ref i31) (local.get $b))))
        (local.set $r (i32.add (i31.get_s (ref.cast (ref i31) (local.get $acc)))
                               (i31.get_s (ref.cast (ref i31) (local.get $b)))))
        (br_if $slow (i32.ne (local.get $r)
                       (i32.shr_s (i32.shl (local.get $r) (i32.const 1)) (i32.const 1))))
        (local.set $acc (ref.i31 (local.get $r)))
        (local.set $n (i64.sub (local.get $n) (i64.const 1)))
        (br $l))
      (local.set $acc (call $add_slow (local.get $acc) (local.get $b)))
      (local.set $n (i64.sub (local.get $n) (i64.const 1)))
      (br $l)))
    (call $to_i64 (local.get $acc)))

  ;; Truthiness over the mixed array, as compiled `if` tests it: falsy when
  ;; nil, false or undefined. Returns start + n so main's check holds; the
  ;; truthy count goes to a global that keeps the work live.
  (global $count (mut i64) (i64.const 0))
  (func (export "g_truthyA") (param $n i64) (param $start i64) (result i64)
    (local $a (ref $arr)) (local $v eqref) (local $i i32) (local $c i64) (local $k i64)
    (local.set $a (ref.as_non_null (global.get $mixA)))
    (local.set $k (local.get $n))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $k)))
      (local.set $v (array.get $arr (local.get $a) (i32.and (local.get $i) (i32.const 1023))))
      (if (i32.eqz (i32.or (i32.or
              (ref.eq (local.get $v) (ref.i31 (i32.const 0)))
              (ref.eq (local.get $v) (ref.i31 (i32.const 2))))
              (ref.eq (local.get $v) (ref.i31 (i32.const 6)))))
        (then (local.set $c (i64.add (local.get $c) (i64.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (local.set $k (i64.sub (local.get $k) (i64.const 1)))
      (br $l)))
    (global.set $count (local.get $c))
    (i64.add (local.get $start) (local.get $n)))
  (func (export "g_truthyB") (param $n i64) (param $start i64) (result i64)
    (local $a (ref $arr)) (local $v eqref) (local $i i32) (local $c i64) (local $k i64)
    (local.set $a (ref.as_non_null (global.get $mixB)))
    (local.set $k (local.get $n))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $k)))
      (local.set $v (array.get $arr (local.get $a) (i32.and (local.get $i) (i32.const 1023))))
      (if (i32.eqz (i32.or (i32.or
              (ref.is_null (local.get $v))
              (ref.eq (local.get $v) (global.get $bfalse)))
              (ref.eq (local.get $v) (global.get $bundef))))
        (then (local.set $c (i64.add (local.get $c) (i64.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (local.set $k (i64.sub (local.get $k) (i64.const 1)))
      (br $l)))
    (global.set $count (local.get $c))
    (i64.add (local.get $start) (local.get $n)))

  ;; number? over the mixed array. A: an odd i31 or a box; B: any i31 or a box.
  (func (export "h_numberA") (param $n i64) (param $start i64) (result i64)
    (local $a (ref $arr)) (local $v eqref) (local $i i32) (local $c i64) (local $k i64)
    (local.set $a (ref.as_non_null (global.get $mixA)))
    (local.set $k (local.get $n))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $k)))
      (local.set $v (array.get $arr (local.get $a) (i32.and (local.get $i) (i32.const 1023))))
      (if (if (result i32) (ref.test (ref i31) (local.get $v))
            (then (i32.and (i31.get_s (ref.cast (ref i31) (local.get $v))) (i32.const 1)))
            (else (ref.test (ref $i) (local.get $v))))
        (then (local.set $c (i64.add (local.get $c) (i64.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (local.set $k (i64.sub (local.get $k) (i64.const 1)))
      (br $l)))
    (global.set $count (local.get $c))
    (i64.add (local.get $start) (local.get $n)))
  (func (export "h_numberB") (param $n i64) (param $start i64) (result i64)
    (local $a (ref $arr)) (local $v eqref) (local $i i32) (local $c i64) (local $k i64)
    (local.set $a (ref.as_non_null (global.get $mixB)))
    (local.set $k (local.get $n))
    (block $done (loop $l
      (br_if $done (i64.eqz (local.get $k)))
      (local.set $v (array.get $arr (local.get $a) (i32.and (local.get $i) (i32.const 1023))))
      (if (i32.or (ref.test (ref i31) (local.get $v)) (ref.test (ref $i) (local.get $v)))
        (then (local.set $c (i64.add (local.get $c) (i64.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (local.set $k (i64.sub (local.get $k) (i64.const 1)))
      (br $l)))
    (global.set $count (local.get $c))
    (i64.add (local.get $start) (local.get $n)))

  ;; A counting loop through out-of-line polymorphic < and inc, the way
  ;; uninferred code runs (loop [i 0] (if (< i n) (recur (inc i)) i)):
  ;; < returns a boolean sentinel that if tests for truthiness.
  (func $ltA (param $a eqref) (param $b eqref) (result eqref)
    (if (result eqref) (i32.and (ref.test (ref i31) (local.get $a)) (ref.test (ref i31) (local.get $b)))
      (then (if (result eqref)
              (i32.and (i32.and (i31.get_s (ref.cast (ref i31) (local.get $a)))
                                (i31.get_s (ref.cast (ref i31) (local.get $b)))) (i32.const 1))
              (then (ref.i31 (i32.add (i32.shl (i32.lt_s (i31.get_s (ref.cast (ref i31) (local.get $a)))
                                                         (i31.get_s (ref.cast (ref i31) (local.get $b))))
                                               (i32.const 1)) (i32.const 2))))
              (else unreachable)))
      (else (ref.i31 (i32.add (i32.shl (i64.lt_s (call $longA (local.get $a)) (call $longA (local.get $b)))
                                       (i32.const 1)) (i32.const 2))))))
  (func $incA (param $a eqref) (result eqref)
    (local $x i32)
    (if (ref.test (ref i31) (local.get $a))
      (then (local.set $x (i31.get_s (ref.cast (ref i31) (local.get $a))))
            (if (i32.and (i32.and (local.get $x) (i32.const 1))
                         (i32.ne (local.get $x) (i32.const 0x3fffffff)))
              (then (return (ref.i31 (i32.add (local.get $x) (i32.const 2))))))))
    (call $add_slowA (local.get $a) (global.get $oneA)))
  (func $ltB (param $a eqref) (param $b eqref) (result eqref)
    (if (result eqref) (i32.and (ref.test (ref i31) (local.get $a)) (ref.test (ref i31) (local.get $b)))
      (then (select (result eqref) (global.get $btrue) (global.get $bfalse)
              (i32.lt_s (i31.get_s (ref.cast (ref i31) (local.get $a)))
                        (i31.get_s (ref.cast (ref i31) (local.get $b))))))
      (else (select (result eqref) (global.get $btrue) (global.get $bfalse)
              (i64.lt_s (call $long_of (local.get $a)) (call $long_of (local.get $b)))))))
  (func $incB (param $a eqref) (result eqref)
    (local $x i32)
    (if (ref.test (ref i31) (local.get $a))
      (then (local.set $x (i31.get_s (ref.cast (ref i31) (local.get $a))))
            (if (i32.ne (local.get $x) (i32.const 0x3fffffff))
              (then (return (ref.i31 (i32.add (local.get $x) (i32.const 1))))))))
    (call $add_slow (local.get $a) (global.get $oneB)))
  (func (export "k_loopA") (param $n i64) (param $start i64) (result i64)
    (local $i eqref) (local $end eqref) (local $t eqref)
    (local.set $i (call $boxA (local.get $start)))
    (local.set $end (call $boxA (i64.add (local.get $start) (local.get $n))))
    (block $done (loop $l
      (local.set $t (call $ltA (local.get $i) (local.get $end)))
      (br_if $done (i32.or (i32.or (ref.eq (local.get $t) (ref.i31 (i32.const 0)))
                                   (ref.eq (local.get $t) (ref.i31 (i32.const 2))))
                           (ref.eq (local.get $t) (ref.i31 (i32.const 6)))))
      (local.set $i (call $incA (local.get $i)))
      (br $l)))
    (call $to_i64A (local.get $i)))
  (func (export "k_loopB") (param $n i64) (param $start i64) (result i64)
    (local $i eqref) (local $end eqref) (local $t eqref)
    (local.set $i (call $box_long (local.get $start)))
    (local.set $end (call $box_long (i64.add (local.get $start) (local.get $n))))
    (block $done (loop $l
      (local.set $t (call $ltB (local.get $i) (local.get $end)))
      (br_if $done (i32.or (i32.or (ref.is_null (local.get $t))
                                   (ref.eq (local.get $t) (global.get $bfalse)))
                           (ref.eq (local.get $t) (global.get $bundef))))
      (local.set $i (call $incB (local.get $i)))
      (br $l)))
    (call $to_i64 (local.get $i)))
)
