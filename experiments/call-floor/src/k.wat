(module
  (type $fn (func (param eqref) (result eqref)))
  (rec
    (type $base (sub (struct (field $code (ref $fn)))))
    (type $sub (sub final $base (struct (field $code (ref $fn)) (field $x i32)))))
  (type $final (struct (field $code (ref $fn))))
  (table $t 1 funcref)
  (elem (table $t) (i32.const 0) func $id)
  (global $g (ref $fn) (ref.func $id))
  (global $obj_sub (mut eqref) (ref.null eq))
  (global $obj_final (mut eqref) (ref.null eq))
  (elem declare func $id)
  (func $id (type $fn) (local.get 0))
  (func (export "setup")
    (global.set $obj_sub (struct.new $sub (ref.func $id) (i32.const 1)))
    (global.set $obj_final (struct.new $final (ref.func $id))))
  (func (export "control") (param $n i32) (result i32) (local $i i32) (local $c i32)
    (block $d (loop $l (br_if $d (i32.ge_u (local.get $i) (local.get $n)))
      (if (ref.is_null (global.get $obj_sub)) (then (local.set $c (i32.add (local.get $c) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))) (local.get $c))
  (func (export "cast_final") (param $n i32) (result i32) (local $i i32) (local $c i32)
    (block $d (loop $l (br_if $d (i32.ge_u (local.get $i) (local.get $n)))
      (if (ref.test (ref $final) (global.get $obj_final)) (then (local.set $c (i32.add (local.get $c) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))) (local.get $c))
  (func (export "cast_super") (param $n i32) (result i32) (local $i i32) (local $c i32)
    (block $d (loop $l (br_if $d (i32.ge_u (local.get $i) (local.get $n)))
      (if (ref.test (ref $base) (global.get $obj_sub)) (then (local.set $c (i32.add (local.get $c) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))) (local.get $c))
  (func (export "callref_global") (param $n i32) (result i32) (local $i i32) (local $c i32)
    (block $d (loop $l (br_if $d (i32.ge_u (local.get $i) (local.get $n)))
      (if (i32.eqz (ref.is_null (call_ref $fn (global.get $obj_sub) (global.get $g)))) (then (local.set $c (i32.add (local.get $c) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))) (local.get $c))
  (func (export "callref_struct") (param $n i32) (result i32) (local $i i32) (local $c i32)
    (block $d (loop $l (br_if $d (i32.ge_u (local.get $i) (local.get $n)))
      (if (i32.eqz (ref.is_null (call_ref $fn (global.get $obj_final)
            (struct.get $final $code (ref.cast (ref $final) (global.get $obj_final)))))) (then (local.set $c (i32.add (local.get $c) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))) (local.get $c))
  (func (export "call_indirect") (param $n i32) (result i32) (local $i i32) (local $c i32)
    (block $d (loop $l (br_if $d (i32.ge_u (local.get $i) (local.get $n)))
      (if (i32.eqz (ref.is_null (call_indirect $t (type $fn) (global.get $obj_final) (i32.const 0)))) (then (local.set $c (i32.add (local.get $c) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))) (local.get $c))
)
