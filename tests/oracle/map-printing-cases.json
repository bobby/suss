    {
      "id": "map-lift-custom-cursor-order",
      "source": "(do\n (deftype LiftTraceEntry [trace]\n   IIndexed\n   (-nth [_ i]\n     (swap! trace conj (if (= i 0) \"nth0\" \"nth1\"))\n     (if (= i 0) :alpha/x 1))\n   (-nth [_ i not-found]\n     (swap! trace conj (if (= i 0) \"nth0\" \"nth1\"))\n     (if (= i 0) :alpha/x 1)))\n (deftype LiftTraceCursor [entries trace]\n   ISeqable\n   (-seq [this] (swap! trace conj \"seq\") this)\n   ISeq\n   (-first [_] (swap! trace conj \"first\") (first entries))\n   (-rest [_] (rest entries))\n   INext\n   (-next [_]\n     (swap! trace conj \"next\")\n     (let [tail (next entries)]\n       (when tail (LiftTraceCursor. tail trace)))))\n (deftype LiftTraceMap [cursor trace]\n   IMap (-dissoc [this _] this)\n   ISeqable (-seq [_] (swap! trace conj \"map-seq\") cursor))\n (binding [*print-namespace-maps* true]\n   (let [trace (atom [])\n         cursor (LiftTraceCursor. [(LiftTraceEntry. trace)] trace)\n         result (cljs.core/lift-ns (LiftTraceMap. cursor trace))]\n     [(aget result 0) @trace])))",
