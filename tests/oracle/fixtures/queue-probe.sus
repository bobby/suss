(def q0 (.-EMPTY PersistentQueue))
(def q1 (conj q0 1))
(def q3 (conj (conj q1 2) 3))
(def qm (with-meta q3 {:marker 17}))
(def qp (pop qm))
(def qr (conj qp 4))
(def qnf (with-meta (conj (conj (conj q0 nil) false) 0) {:nil-marker nil :false-marker false}))
(def q65 (loop [i 0 q q0] (if (< i 65) (recur (inc i) (conj q i)) q)))
(def q33 (loop [i 0 q q65] (if (< i 33) (recur (inc i) (pop q)) q)))
(def last-steps 0)
(def clone-steps 0)
