;; Retained standalone upstream forms: canonical singleton and nil count extension.
(set! (.-EMPTY List) (EmptyList. nil))

(extend-type nil
  ICounted
  (-count [_] 0))

(extend-type number
  IEquiv
  (-equiv [x o] (identical? x o)))

(extend-type default
  IEquiv
  (-equiv [x o] (identical? x o)))

(extend-type default
  IHash
  (-hash [o]
    (if (identical? o (root-obj))
      0
      (suss.bootstrap/identity-uid o))))

(set! (.-EMPTY_NODE PersistentVector) (VectorNode. nil (make-array 32)))

(set! (.-EMPTY PersistentVector)
  (PersistentVector. nil 0 5 (.-EMPTY_NODE PersistentVector) (array) empty-ordered-hash))

(set! (.-fromArray PersistentVector)
  (fn [xs ^boolean no-clone]
    (let [l (alength xs)
          xs (if no-clone xs (aclone xs))]
      (if (< l 32)
        (PersistentVector. nil l 5 (.-EMPTY_NODE PersistentVector) xs nil)
        (let [node (.slice xs 0 32)
              v (PersistentVector. nil 32 5 (.-EMPTY_NODE PersistentVector) node nil)]
          (loop [i 32 out (-as-transient v)]
            (if (< i l)
              (recur (inc i) (conj! out (aget xs i)))
              (persistent! out))))))))

(set! (.-EMPTY PersistentArrayMap) (PersistentArrayMap. nil 0 (array) empty-unordered-hash))

(set! (.-HASHMAP_THRESHOLD PersistentArrayMap) 8)

(set! (.-createAsIfByAssoc PersistentArrayMap)
  (fn [init]
    ;; check trailing element
    (let [len           (alength init)
          has-trailing? (== 1 (bit-and len 1))]
      (if-not (or has-trailing? (pam-dupes? init))
        (PersistentArrayMap. nil (/ len 2) init nil)
        (.createAsIfByAssocComplexPath PersistentArrayMap init has-trailing?)))))

(set! (.-createAsIfByAssocComplexPath PersistentArrayMap)
  (fn [init ^boolean has-trailing?]
    (let [init (if has-trailing?
                 (pam-grow-seed-array init
                   ;; into {} in case the final element is not a map but something conj-able
                   ;; for parity with Clojure implementation of CLJ-2603
                   (into {} (aget init (dec (alength init)))))
                 init)
          n    (pam-new-size init)
          len  (alength init)]
      (if (< n len)
        (let [nodups (make-array n)]
          (loop [i 0 m 0]
            (if (< i len)
              (let [dupe? (loop [j 0]
                            (if (< j m)
                              (or
                                (key-test (aget init i) (aget init j))
                                (recur (+ 2 j)))
                              false))]
                (if-not dupe?
                  (let [j (loop [j (- len 2)]
                            (if (>= j i)
                              (if (key-test (aget init i) (aget init j))
                                j
                                (recur (- j 2)))
                              j))]
                    (aset nodups m (aget init i))
                    (aset nodups (inc m) (aget init (inc j)))
                    (recur (+ 2 i) (+ 2 m)))
                  (recur (+ 2 i) m)))))
          (PersistentArrayMap. nil (/ (alength nodups) 2) nodups nil))
        (PersistentArrayMap. nil (/ (alength init) 2) init nil)))))

(set! (.-EMPTY BitmapIndexedNode) (BitmapIndexedNode. nil 0 (make-array 0)))

(set! (.-EMPTY PersistentHashMap) (PersistentHashMap. nil 0 nil false nil empty-unordered-hash))

(set! (.-fromArray PersistentHashMap)
  (fn [arr ^boolean no-clone]
    (let [arr (if no-clone arr (aclone arr))
          len (alength arr)]
      (loop [i 0 ret (transient (.-EMPTY PersistentHashMap))]
        (if (< i len)
          (recur (+ i 2)
            (-assoc! ret (aget arr i) (aget arr (inc i))))
          (-persistent! ret))))))

(set! (.-fromArrays PersistentHashMap)
  (fn [ks vs]
    (let [len (alength ks)]
      (loop [i 0 ^not-native out (transient (.-EMPTY PersistentHashMap))]
        (if (< i len)
          (if (<= (alength vs) i)
            (throw (suss.bootstrap/error (str_ "No value supplied for key: " (aget ks i))))
            (recur (inc i) (-assoc! out (aget ks i) (aget vs i))))
          (persistent! out))))))

(set! (.-createWithCheck PersistentHashMap)
  (fn [arr]
    (let [len (alength arr)
          ret (transient (.-EMPTY PersistentHashMap))]
      (loop [i 0]
        (when (< i len)
          (-assoc! ret (aget arr i) (aget arr (inc i)))
          (if (not= (-count ret) (inc (/ i 2)))
            (throw (suss.bootstrap/error (str_ "Duplicate key: " (aget arr i))))
            (recur (+ i 2)))))
      (-persistent! ret))))

;; Pinned core.cljs PersistentHashSet static initializers, EPL-1.0.
;; Explicit dotimes/Error/threshold adapters; all branches retained.
(set! (.-EMPTY PersistentHashSet)
  (PersistentHashSet. nil (.-EMPTY PersistentArrayMap) empty-unordered-hash))

(set! (.-fromArray PersistentHashSet)
  (fn [items ^boolean no-clone]
    (let [len (alength items)]
      (if (<= len (.-HASHMAP_THRESHOLD PersistentArrayMap))
        (let [arr (if no-clone items (aclone items))]
          (loop [i 0
                 out (transient (.-EMPTY PersistentArrayMap))]
            (if (< i len)
              (recur (inc i) (-assoc! out (aget items i) nil))
              (PersistentHashSet. nil (-persistent! out) nil))))
       (loop [i 0
              out (transient (.-EMPTY PersistentHashSet))]
         (if (< i len)
           (recur (inc i) (-conj! out (aget items i)))
           (-persistent! out)))))))

(set! (.-createWithCheck PersistentHashSet)
      (fn [items]
        (let [len (alength items)
              t (-as-transient (.-EMPTY PersistentHashSet))]
          (loop [i 0]
            (when (< i len)
              (-conj! t (aget items i))
              (when-not (= (count t) (inc i))
                (throw (suss.bootstrap/error (str_ "Duplicate key: " (aget items i)))))
              (recur (inc i))))
          (-persistent! t))))

(set! (.-createAsIfByAssoc PersistentHashSet)
      (fn [items]
        (let [len (alength items)
              t (-as-transient (.-EMPTY PersistentHashSet))]
          (loop [i 0] (when (< i len) (-conj! t (aget items i)) (recur (inc i))))
          (-persistent! t))))

(do
(extend-type LazySeq IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "(" " " ")" opts coll)))

(extend-type IndexedSeq IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "(" " " ")" opts coll)))

(extend-type RSeq IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "(" " " ")" opts coll)))

(extend-type PersistentQueue IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "#queue [" " " "]" opts (seq coll))))

(extend-type PersistentQueueSeq IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "(" " " ")" opts coll)))

(extend-type NodeSeq IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "(" " " ")" opts coll)))

(extend-type ArrayNodeSeq IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "(" " " ")" opts coll)))

(extend-type List IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "(" " " ")" opts coll)))

(extend-type Cons IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "(" " " ")" opts coll)))

(extend-type EmptyList IPrintWithWriter
  (-pr-writer [coll writer opts] (-write writer "()")))

(extend-type PersistentVector IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "[" " " "]" opts coll)))

(extend-type ChunkedCons IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "(" " " ")" opts coll)))

(extend-type ChunkedSeq IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "(" " " ")" opts coll)))

(extend-type Subvec IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "[" " " "]" opts coll)))

(extend-type MapEntry IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "[" " " "]" opts coll)))

(extend-type KeySeq IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "(" " " ")" opts coll)))

(extend-type PersistentArrayMapSeq IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "(" " " ")" opts coll)))

(extend-type PersistentArrayMap IPrintWithWriter
  (-pr-writer [coll writer opts]
    (print-map coll pr-writer writer opts)))

(extend-type PersistentHashMap IPrintWithWriter
  (-pr-writer [coll writer opts]
    (print-map coll pr-writer writer opts)))

(extend-type PersistentHashSet IPrintWithWriter
  (-pr-writer [coll writer opts] (pr-sequential-writer writer pr-writer "#{" " " "}" opts coll)))

(extend-type Atom IPrintWithWriter
  (-pr-writer [a writer opts]
    (-write writer "#object[cljs.core.Atom ")
    (pr-writer {:val (.-state a)} writer opts)
    (-write writer "]")))

(extend-type Var IPrintWithWriter
  (-pr-writer [a writer opts]
    (-write writer "#'")
    (pr-writer (.-sym a) writer opts))))

(set! (.-EMPTY PersistentQueue) (PersistentQueue. nil 0 nil (.-EMPTY PersistentVector) empty-ordered-hash))
;; Original Suss WIT integer foundations, not extracted upstream source.
;; Exact storage uses two unsigned 32-bit words in the existing nominal ABI.
;; Decimal parsing never converts the complete integer through binary64.
(deftype WitSigned64 [high low])
(deftype WitUnsigned64 [high low])
(def wit-valid-word?
  (let [number? number?]
    (fn [word]
    (if (number? word)
      (if (<= 0 word)
        (if (<= word 4294967295)
          (== word (suss.bootstrap/f64-floor word)) false) false) false))))
(def wit-checked-words
  (let [signed-class WitSigned64 unsigned-class WitUnsigned64 valid-word wit-valid-word?]
    (fn [value]
      (if (if (instance? signed-class value) true (instance? unsigned-class value))
        (let [high (.-high value) low (.-low value)]
          (if (if (valid-word high) (valid-word low) false)
            (array high low)
            (throw (suss.bootstrap/error "Invalid exact integer 64-bit word storage"))))
        (throw (suss.bootstrap/error "Expected exact integer 64-bit wrapper"))))))
(def wit-parse-words
  (fn [text signed]
    (if (string? text)
      (let [length (count text)]
        (if (zero? length)
          (throw (suss.bootstrap/error "Expected decimal string for exact integer 64-bit constructor"))
          (let [negative (== (.charCodeAt text 0) 45)
                first (if negative 1 0)]
            (if (if negative (if signed false true) false)
              (throw (suss.bootstrap/error "Unsigned 64-bit constructor rejects negative input"))
              (if (== first length)
                (throw (suss.bootstrap/error "Expected decimal digits for exact integer 64-bit constructor"))
                (loop [index first high 0 low 0]
                  (if (< index length)
                    (let [digit (- (.charCodeAt text index) 48)]
                      (if (if (<= 0 digit) (<= digit 9) false)
                        (let [wide-low (+ (* low 10) digit)
                              carry (suss.bootstrap/f64-floor (/ wide-low 4294967296))
                              next-low (- wide-low (* carry 4294967296))
                              next-high (+ (* high 10) carry)]
                          (if (> next-high 4294967295)
                            (throw (suss.bootstrap/error "Exact integer 64-bit decimal input out of range"))
                            (recur (inc index) next-high next-low)))
                        (throw (suss.bootstrap/error "Invalid decimal digit for exact integer 64-bit constructor"))))
                    (if signed
                      (if negative
                        (if (if (< high 2147483648) true
                              (if (== high 2147483648) (zero? low) false))
                          (if (if (zero? high) (zero? low) false)
                            (array 0 0)
                            (if (zero? low)
                              (array (- 4294967296 high) 0)
                              (array (- 4294967295 high) (- 4294967296 low))))
                          (throw (suss.bootstrap/error "Signed 64-bit decimal input out of range")))
                        (if (< high 2147483648) (array high low)
                          (throw (suss.bootstrap/error "Signed 64-bit decimal input out of range"))))
                      (array high low)))))))))
      (throw (suss.bootstrap/error "Expected decimal string for exact integer 64-bit constructor")))))
(def wit-s64
  (let [class WitSigned64 parse wit-parse-words get aget]
    (fn [text]
      (let [words (parse text true)]
        (new class (get words 0) (get words 1))))))
(def wit-u64
  (let [class WitUnsigned64 parse wit-parse-words get aget]
    (fn [text]
      (let [words (parse text false)]
        (new class (get words 0) (get words 1))))))
(def wit-s64? (let [class WitSigned64] (fn [value] (instance? class value))))
(def wit-u64? (let [class WitUnsigned64] (fn [value] (instance? class value))))
(def wit-to-number
  (let [signed-class WitSigned64 checked wit-checked-words get aget]
    (fn [value]
      (let [words (checked value) high (get words 0) low (get words 1)
            negative (if (instance? signed-class value) (>= high 2147483648) false)
            magnitude-high (if negative
                             (if (zero? low) (- 4294967296 high) (- 4294967295 high)) high)
            magnitude-low (if negative (if (zero? low) 0 (- 4294967296 low)) low)]
        (if (< magnitude-high 2097152)
          (let [number (+ (* magnitude-high 4294967296) magnitude-low)]
            (if negative (- number) number))
          (throw (suss.bootstrap/error "Exact integer 64-bit wit-to-number exceeds safe binary64 integer range")))))))

;; Original Suss UTF-16 storage helper for keyword's fixed slash split only.
;; Every empty/trailing part is retained. This is not general JS String.split.
(def ^:private keyword-name-parts
  (fn [text]
    (let [parts (array) length (count text)]
      (loop [index 0 start 0]
        (if (< index length)
          (if (== (.charCodeAt text index) 47)
            (do (.push parts (suss.bootstrap/string-slice text start index))
                (recur (inc index) (inc index)))
            (recur (inc index) start))
          (do (.push parts (suss.bootstrap/string-slice text start length)) parts))))))

;; Original Suss adaptation: read the source closure's owned UTF16 label.
(def ^:private pr-function-name (fn [function] (suss.bootstrap/function-name function)))

;; Copyright The Closure Library Authors.
;; SPDX-License-Identifier: Apache-2.0
;; Adapted from the complete goog/string/stringbuffer.js retained beside this
;; file. Native owned storage replaces the Closure prototype buffer slot.
;; All constructor and method branches remain; this is not JS prototype interop.
(def bootstrap-buffer-to-array to-array)
(deftype BootstrapStringBuffer [^:mutable buffer_]
  Object
  (set [this & values]
    (let [args (bootstrap-buffer-to-array values) s (aget args 0)]
      (set! buffer_ (suss.bootstrap/value-add "" s))
      (aget (array) 0)))
  (append [this & values]
    (let [args (bootstrap-buffer-to-array values)
          old buffer_
          first-value (aget args 0)
          converted (suss.bootstrap/coerce-string first-value)]
      (set! buffer_ (suss.bootstrap/value-add old converted))
      (if (suss.bootstrap/nil? (aget args 1))
        nil
        (loop [i 1]
          (if (< i (alength args))
            (let [old buffer_ value (aget args i)]
              (set! buffer_ (suss.bootstrap/value-add old value))
              (recur (inc i)))
            nil)))
      this))
  (clear [this & ignored]
    (set! buffer_ "")
    (aget (array) 0))
  (getLength [this & ignored] (.-length buffer_))
  (toString [this & ignored] buffer_))
(def bootstrap-string-buffer
  (fn [& values]
    (let [args (bootstrap-buffer-to-array values) sb (BootstrapStringBuffer. "")]
      (if (suss.bootstrap/nil? (aget args 0))
        nil
        (.apply (.-append sb) sb args))
      sb)))
