;; Binary Tree Traversals
;; Using maps to represent tree nodes

;; -----------------------------------------------------------------------------
;; Tree Construction
;; -----------------------------------------------------------------------------

(defn make-tree [value left right]
  {:value value :left left :right right})

(defn leaf [value]
  {:value value :left nil :right nil})

;; -----------------------------------------------------------------------------
;; Traversals
;; -----------------------------------------------------------------------------

;; In-order: left, root, right (gives sorted order for BST)
(defn inorder [tree]
  (if (nil? tree)
    []
    (concat (inorder (:left tree))
            [(:value tree)]
            (inorder (:right tree)))))

;; Pre-order: root, left, right (useful for copying trees)
(defn preorder [tree]
  (if (nil? tree)
    []
    (concat [(:value tree)]
            (preorder (:left tree))
            (preorder (:right tree)))))

;; Post-order: left, right, root (useful for deletion)
(defn postorder [tree]
  (if (nil? tree)
    []
    (concat (postorder (:left tree))
            (postorder (:right tree))
            [(:value tree)])))

;; -----------------------------------------------------------------------------
;; Tree Properties
;; -----------------------------------------------------------------------------

(defn tree-height [tree]
  (if (nil? tree)
    0
    (inc (max (tree-height (:left tree))
              (tree-height (:right tree))))))

(defn tree-size [tree]
  (if (nil? tree)
    0
    (+ 1
       (tree-size (:left tree))
       (tree-size (:right tree)))))

;; -----------------------------------------------------------------------------
;; Example Tree
;;        4
;;       / \
;;      2   6
;;     / \ / \
;;    1  3 5  7
;; -----------------------------------------------------------------------------

(def sample-tree
  (make-tree 4
    (make-tree 2 (leaf 1) (leaf 3))
    (make-tree 6 (leaf 5) (leaf 7))))

;; -----------------------------------------------------------------------------
;; Examples
;; -----------------------------------------------------------------------------
;; (inorder sample-tree)    ; => [1 2 3 4 5 6 7]
;; (preorder sample-tree)   ; => [4 2 1 3 6 5 7]
;; (postorder sample-tree)  ; => [1 3 2 5 7 6 4]
;; (tree-height sample-tree); => 3
;; (tree-size sample-tree)  ; => 7
