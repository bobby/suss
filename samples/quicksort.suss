;; Quicksort
;; Functional implementation of the classic sorting algorithm

;; -----------------------------------------------------------------------------
;; Basic Quicksort
;; Uses filter to partition around pivot
;; -----------------------------------------------------------------------------
(defn quicksort [coll]
  (if (< (count coll) 2)
    coll
    (let [pivot (first coll)
          smaller (filter (fn [x] (< x pivot)) (rest coll))
          larger (filter (fn [x] (>= x pivot)) (rest coll))]
      (concat (quicksort smaller) [pivot] (quicksort larger)))))

;; -----------------------------------------------------------------------------
;; Quicksort with explicit three-way partition
;; Handles duplicates more efficiently
;; -----------------------------------------------------------------------------
(defn quicksort-3way [coll]
  (if (< (count coll) 2)
    coll
    (let [pivot (first coll)
          smaller (filter (fn [x] (< x pivot)) (rest coll))
          equal (filter (fn [x] (= x pivot)) coll)
          larger (filter (fn [x] (> x pivot)) (rest coll))]
      (concat (quicksort-3way smaller) equal (quicksort-3way larger)))))

;; -----------------------------------------------------------------------------
;; Examples
;; -----------------------------------------------------------------------------
;; (quicksort [])              ; => []
;; (quicksort [1])             ; => [1]
;; (quicksort [3 1 4 1 5 9 2 6]); => [1 1 2 3 4 5 6 9]
;; (quicksort [5 4 3 2 1])     ; => [1 2 3 4 5]
