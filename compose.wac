package suss:composed;

// Instantiate the reader component with WASI imports passed through
let reader = new suss:reader { ... };

// Instantiate the evaluator component with reader's exports and WASI passed through
let evaluator = new suss:eval {
  "suss:lang/types": reader["suss:lang/types"],
  "suss:lang/reader": reader["suss:lang/reader"],
  ...
};

// Instantiate the CLI component with both reader and evaluator exports
let cli = new suss:cli {
  "suss:lang/types": reader["suss:lang/types"],
  "suss:lang/reader": reader["suss:lang/reader"],
  "suss:lang/evaluator": evaluator["suss:lang/evaluator"],
  ...
};

// Export everything from CLI (it's a WASI command)
export cli...;
