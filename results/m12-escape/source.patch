+        "(let [f (fn [x] (try (if x (throw :bad) 1) (catch :default e 2) (finally nil)))] [(f false) (f true)])",
+        "[1 2]",
+    ),
+    (
+        "(let [events (atom []) f (fn [] (swap! events conj :body) 7)] [(try (do (f) (throw :bad)) (catch :default e (f))) @events])",
