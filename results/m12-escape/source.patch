+    (
+        "(let [x 3000000000 f (fn [] x) out [f]] ((nth out 0)))",
+        "3000000000",
+    ),
+    (
+        "(let [x 3000000000 f (fn [] x)] (loop [i 0 acc 0] (if (< i 4) (recur (inc i) (+ acc (f))) acc)))",
+        "12000000000",
