(ns bench)
(def sentinel -1)
(def la (long-array (range 1024)))
(def da (double-array (range 1024)))
(def ia (int-array (range 1024)))
(def oa (to-array (range 1024)))
(def v (vec (range 1024)))
(def vl (into (vector-of :long) (range 1024)))
(def m (zipmap (range 1024) (range 1024)))
(def km {:a 1 :b 2 :c 3 :d 4})
(def s (set (range 1024)))
(def words (vec (map (fn [i] (keyword (str "w" (mod i 37)))) (range 1024))))
(defn f0 [] 1)
(defn f1 [x] x)
(defn f2 [x y] x)
(defn f3 [x y z] x)
(defn typed-long ^long [^long x] (* x 2))
(defn typed-double ^double [^double x] (* x 0.5))
(defn fv [x & more] x)
(def ^:dynamic *d* 0)
(defprotocol Ident (ident [x]))
(deftype Box [] Ident (ident [_] 1))
(def b (->Box))
(defmulti area :shape)
(defmethod area :square [x] 1)
(def sq {:shape :square})
(defn fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(def range-1024 (vec (range 1024)))
(def range-10240 (vec (range 10240)))
(def fixed-1024 (vec (repeat 1024 "x")))
(def fixed-10240 (vec (repeat 10240 "x")))
(def case-warm (fn [n] (loop [i 0 c 0] (if (< i n) (let [r i] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
(def case-range-1024 (fn [n] (loop [i 0 c 0] (if (< i n) (let [r (apply str (map str range-1024))] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
(def case-range-10240 (fn [n] (loop [i 0 c 0] (if (< i n) (let [r (apply str (map str range-10240))] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
(def case-fixed-1024 (fn [n] (loop [i 0 c 0] (if (< i n) (let [r (apply str (map str fixed-1024))] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
(def case-fixed-10240 (fn [n] (loop [i 0 c 0] (if (< i n) (let [r (apply str (map str fixed-10240))] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
