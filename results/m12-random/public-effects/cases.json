[
  {
    "name": "default-and-bound-return-types",
    "expression": "[(double? (rand)) (double? (rand 5)) (integer? (rand-int 5))]",
    "expected": "[true true true]"
  },
  {
    "name": "zero-bound",
    "expression": "[(rand 0) (rand-int 0)]",
    "expected": "[0.0 0]"
  },
  {
    "name": "negative-and-fractional-bounds",
    "expression": "(let [a (rand -5) b (rand 5.5) c (rand-int -5) d (rand-int 5.5)] [(< -5 a) (<= a 0) (<= 0 b) (< b 5.5) (<= -4 c) (<= c 0) (<= 0 d) (<= d 5)])",
    "expected": "[true true true true true true true true]"
  },
  {
    "name": "exact-number-bounds",
    "expression": "(let [a (rand 5N) b (rand 1/3) c (rand 1.25M)] [(double? a) (double? b) (double? c) (<= 0 a) (< a 5) (<= 0 b) (< b 1/3) (<= 0 c) (< c 1.25M)])",
    "expected": "[true true true true true true true true true]"
  },
  {
    "name": "rand-bound-once",
    "expression": "(let [trace (atom []) value (rand (do (swap! trace conj :bound) 0))] [value @trace])",
    "expected": "[0.0 [:bound]]"
  },
  {
    "name": "rand-int-bound-once",
    "expression": "(let [trace (atom []) value (rand-int (do (swap! trace conj :bound) 0))] [value @trace])",
    "expected": "[0 [:bound]]"
  },
  {
    "name": "invalid-rand-bound-effects",
    "expression": "(let [trace (atom []) result (try (rand (do (swap! trace conj :bound) :invalid)) (catch Throwable e :error))] [result @trace])",
    "expected": "[:error [:bound]]"
  },
  {
    "name": "invalid-rand-int-bound-effects",
    "expression": "(let [trace (atom []) result (try (rand-int (do (swap! trace conj :bound) :invalid)) (catch Throwable e :error))] [result @trace])",
    "expected": "[:error [:bound]]"
  },
  {
    "name": "rand-invalid-arity-argument-order",
    "expression": "(let [trace (atom []) result (try (rand (do (swap! trace conj :left) 0) (do (swap! trace conj :right) 0)) (catch Throwable e :error))] [result @trace])",
    "expected": "[:error [:left :right]]"
  },
  {
    "name": "rand-int-zero-arity",
    "expression": "(try (rand-int) (catch Throwable e :error))",
    "expected": ":error"
  },
  {
    "name": "rand-int-invalid-arity-argument-order",
    "expression": "(let [trace (atom []) result (try (rand-int (do (swap! trace conj :left) 0) (do (swap! trace conj :right) 0)) (catch Throwable e :error))] [result @trace])",
    "expected": "[:error [:left :right]]"
  },
  {
    "name": "first-class-functions",
    "expression": "(let [f rand g rand-int] [(double? (f)) (f 0) (g 0)])",
    "expected": "[true 0.0 0]"
  },
  {
    "name": "apply-functions",
    "expression": "[(double? (apply rand [])) (apply rand [0]) (apply rand-int [0])]",
    "expected": "[true 0.0 0]"
  },
  {
    "name": "normal-stream-has-distinct-values",
    "expression": "(let [xs [(rand) (rand) (rand) (rand) (rand) (rand) (rand) (rand) (rand) (rand) (rand) (rand) (rand) (rand) (rand) (rand)]] [(every? #(and (double? %) (<= 0 %) (< % 1)) xs) (> (count (set xs)) 1)])",
    "expected": "[true true]"
  },
  {
    "name": "negative-zero-bound",
    "expression": "[(pr-str (rand -0.0)) (rand-int -0.0)]",
    "expected": "[\"-0.0\" 0]"
  },
  {
    "name": "recovery-after-error",
    "expression": "[(try (rand :invalid) (catch Throwable e :error)) (rand 0) (rand-int 0)]",
    "expected": "[:error 0.0 0]"
  }
]
