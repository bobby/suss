    "expression": "(let [f (fn [] #\"a\") g (fn [] #\"a\")] (= (f) (g)))"
  },
  {
    "name": "loop-site-retention",
    "expression": "(loop [i 0 before nil result true] (if (= i 3) result (let [r #\"a\"] (recur (inc i) r (and result (or (nil? before) (identical? before r)))))))"
  },
  {
    "name": "eval-pattern-self",
    "expression": "(let [r #\"a\"] (identical? r (eval r)))"
  },
  {
