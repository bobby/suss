  [
    "(do (def str-effects []) (let [r (with-redefs [str (fn [& xs] \"replacement\")] (str (do (def str-effects (conj str-effects :a)) \"a\") (do (def str-effects (conj str-effects :b)) \"b\")))] [r str-effects]))",
    "[\"replacement\" [:a :b]]"
  ]
