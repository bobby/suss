;; Clojure 1.12.6 clojure.core/case adaptation. Copyright (c) Rich Hickey.
;; All rights reserved. Eclipse Public License 1.0; retain this notice.
;; See runtime/core-import/LICENSE and clojure-case-primary-source.json.
;; Original portable hash dispatch replaces JVM case* and Util.hash interop.
;; A balanced decision tree over signed32-bit literal hashes follows the JVM's
;; sparse lookup path. Only genuine collision buckets call live public equality.
(defmacro case [e & clauses]
  (let [ge (gensym "case_value__")
        gh (gensym "case_hash__")
        default (if (odd? (count clauses))
                  (last clauses)
                  `(throw (suss.bootstrap/error
                            (suss.core/str "No matching clause: " ~ge))))]
    (if (< (count clauses) 2)
      `(let [~ge ~e] ~default)
      (let [assoc-test (fn [m test expr]
                         (if (contains? m test)
                           (throw (ex-info (str "Duplicate case test constant: " test) {}))
                           (assoc m test expr)))
            pairs (reduce
                    (fn [m pair]
                      (let [test (first pair) expr (second pair)]
                        (if (seq? test)
                          (reduce (fn [m test] (assoc-test m test expr)) m test)
                          (assoc-test m test expr))))
                    {} (partition 2 clauses))
            tests (keys pairs)
            ints? (every? (fn [x] (and (integer? x) (<= -2147483648 x 2147483647))) tests)
            keywords? (every? keyword? tests)
            buckets (reduce
                      (fn [m entry]
                        (let [test (key entry)
                              h (if ints? (suss.bootstrap/int-value test) (case-hash-code test))]
                          (assoc m h (conj (get m h []) [test (val entry)]))))
                      {} pairs)
            ordered (vec (sort (fn [a b] (< (key a) (key b))) (seq buckets)))]
        (if (empty? tests)
          (throw (ex-info "Wrong number of args (0) passed to: clojure.core/max" {}))
          nil)
        (letfn [(collision [entries]
                  (let [pred (gensym "case_pred__")
                        body (reduce
                               (fn [body entry]
                                 `(if (~pred ~(list 'quote (first entry)) ~ge)
                                    ~(second entry) ~body))
                               default (reverse entries))]
                    `(let [~pred suss.core/=] ~body)))
                (checked [entries]
                  (if (= (count entries) 1)
                    (let [entry (first entries) test (list 'quote (first entry))]
                      `(if (~(if keywords? 'suss.bootstrap/case-identical 'suss.bootstrap/case-equiv)
                             ~ge ~test)
                         ~(second entry) ~default))
                    (collision entries)))
                (tree [lo hi]
                  (if (= (inc lo) hi)
                    (let [entry (nth ordered lo)]
                      `(if (suss.bootstrap/case-hash= ~gh ~(key entry))
                         ~(checked (val entry)) ~default))
                    (let [mid (quot (+ lo hi) 2)
                          pivot (key (nth ordered mid))]
                      `(if (suss.bootstrap/case-hash< ~gh ~pivot)
                         ~(tree lo mid) ~(tree mid hi)))))]
          `(let [~ge ~e]
             ~(if ints?
                `(if (suss.bootstrap/number? ~ge)
                   (let [~gh (suss.bootstrap/int-value ~ge)]
                     ~(tree 0 (count ordered)))
                   ~default)
                `(let [~gh (suss.bootstrap/case-hash-code ~ge)]
                   ~(tree 0 (count ordered))))))))))
