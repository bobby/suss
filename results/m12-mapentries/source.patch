@@ -59,3 +59,21 @@ fn escaping_or_unknown_vector_projections_retain_materialization() {
         assert_eq!(guards(&lower(source)), 0, "{source}");
     }
 }
+
+#[test]
+fn map_entry_public_guards_and_constant_projections_get_scalar_storage() {
+    for source in [
+        "(let [e (MapEntry. 3000000000 1.5 nil) a (nth e 0 nil) b (nth e 1 nil)] (+ a b))",
+        "(fn [] (let [e (MapEntry. 3000000000 1.5 nil) a (nth e 0 nil)] a))",
+        "(loop [i 0 acc 0.0] (if (< i 4) (let [e (MapEntry. 3000000000 1.5 nil) a (nth e 0 nil) b (nth e 1 nil)] (recur (+ i 1) (+ acc (+ a b)))) acc))",
+    ] {
+        assert_eq!(guards(&lower(source)), 1, "{source}");
+    }
+    for source in [
+        "(let [e (MapEntry. 3000000000 1.5 nil)] e)",
+        "(fn [i] (let [e (MapEntry. 3000000000 1.5 nil)] (nth e i nil)))",
+        "(let [e (MapEntry. 3000000000 1.5 nil)] (nth e 2 nil))",
+    ] {
+        assert_eq!(guards(&lower(source)), 0, "{source}");
+    }
+}
