+    /// Cache only potentially repeated materializations. Inline numeric
+    /// operations' throwing paths do not justify bookkeeping on their hot
+    /// path, and a single return cannot reuse a box. A use in a cycle can
+    /// repeat without redefining its value even when it is the only use.
+    fn cache_candidates(&self, function: &Function) -> Vec<bool> {
+        use super::ir::Terminator;
+        let mut definitions = vec![0; self.repr.len()];
+        let mut uses = vec![Vec::new(); self.repr.len()];
+        let mut remember = |value: ValueId, block: usize, site: usize| {
+            if self.of(value).definite().numeric() && uses[value.0].last() != Some(&(block, site)) {
+                uses[value.0].push((block, site));
+            }
+        };
+        for (block_id, block) in function.blocks.iter().enumerate() {
+            for value in &block.parameters { definitions[value.0] = block_id; }
+            for (site, instruction) in block.instructions.iter().enumerate() {
+                definitions[instruction.result.0] = block_id;
+                if !inline(self, instruction) {
+                    for value in super::ir::operands(&instruction.operation) { remember(*value, block_id, site); }
+                }
+            }
+            let site = block.instructions.len();
+            match &block.terminator {
+                Terminator::Throw(value) | Terminator::Return(value) => remember(*value, block_id, site),
+                Terminator::Branch { condition, .. } if self.of(*condition) != Repr::Flag => remember(*condition, block_id, site),
+                Terminator::Jump { target, arguments } => {
