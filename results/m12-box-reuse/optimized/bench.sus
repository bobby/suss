(ns boxreuse)
(def observed (fn [x] x))
(def worker-double-raw (fn [f n] (let [n (long n) x (+ 1.25 0.5)] (loop [i 0 c 0] (if (< i n) (let [r (f x)] (recur (inc i) (if (== (double r) (double x)) (inc c) c))) c)))))
(def double-raw (fn [n] (worker-double-raw observed n)))
(def worker-double-boxed (fn [f n] (let [n (long n) x (identity 1.75)] (loop [i 0 c 0] (if (< i n) (let [r (f x)] (recur (inc i) (if (== (double r) (double x)) (inc c) c))) c)))))
(def double-boxed (fn [n] (worker-double-boxed observed n)))
(def worker-long-raw (fn [f n] (let [n (long n) x (+ 3000000000 5)] (loop [i 0 c 0] (if (< i n) (let [r (f x)] (recur (inc i) (if (== (long r) (long x)) (inc c) c))) c)))))
(def long-raw (fn [n] (worker-long-raw observed n)))
(def worker-long-boxed (fn [f n] (let [n (long n) x (identity 3000000005)] (loop [i 0 c 0] (if (< i n) (let [r (f x)] (recur (inc i) (if (== (long r) (long x)) (inc c) c))) c)))))
(def long-boxed (fn [n] (worker-long-boxed observed n)))
