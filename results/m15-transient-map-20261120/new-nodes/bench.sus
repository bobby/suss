(ns bench)
(def sentinel -1)
(def la (long-array (range 1024)))
(def da (double-array (range 1024)))
(def ia (int-array (range 1024)))
(def oa (to-array (range 1024)))
(def v (vec (range 1024)))
(def vl (into (vector-of :long) (range 1024)))
(def m (zipmap (range 1024) (range 1024)))
(def km {:a 1 :b 2 :c 3 :d 4})
(def s (set (range 1024)))
(def words (vec (map (fn [i] (keyword (str "w" (mod i 37)))) (range 1024))))
(defn f0 [] 1)
(defn f1 [x] x)
(defn f2 [x y] x)
(defn f3 [x y z] x)
(defn typed-long ^long [^long x] (* x 2))
(defn typed-double ^double [^double x] (* x 0.5))
(defn fv [x & more] x)
(def ^:dynamic *d* 0)
(defprotocol Ident (ident [x]))
(deftype Box [] Ident (ident [_] 1))
(def b (->Box))
(defmulti area :shape)
(defmethod area :square [x] 1)
(def sq {:shape :square})
(defn fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(def case-warm (fn [n] (loop [i 0 c 0] (if (< i n) (let [r i] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
(def case-fib (fn [n] (loop [i 0 c 0] (if (< i n) (let [r (fib 20)] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
(def case-word-frequencies (fn [n] (loop [i 0 c 0] (if (< i n) (let [r (reduce (fn [acc w] (assoc acc w (inc (get acc w 0)))) {} words)] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
(def case-transduce (fn [n] (loop [i 0 c 0] (if (< i n) (let [r (transduce (comp (map inc) (filter even?)) + 0 v)] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
(def case-lazy-pipeline (fn [n] (loop [i 0 c 0] (if (< i n) (let [r (reduce + (map inc (filter even? v)))] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
(def case-into-vector (fn [n] (loop [i 0 c 0] (if (< i n) (let [r (into [] (map inc) v)] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
(def case-into-map (fn [n] (loop [i 0 c 0] (if (< i n) (let [r (into {} (map (fn [x] [x x])) v)] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
(def case-string-build (fn [n] (loop [i 0 c 0] (if (< i n) (let [r (apply str (map str v))] (recur (inc i) (if (identical? r sentinel) (inc c) c))) c))))
