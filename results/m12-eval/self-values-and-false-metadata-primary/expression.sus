[
(let [a (atom 7)] (identical? a (eval a)))
(let [d (delay 7)] (identical? d (eval d)))
(let [a (atom 7)] (identical? a (eval (eval a))))
(let [trace (atom []) a (atom 7)] [(identical? a (eval (do (swap! trace conj :argument) a))) @trace])
(let [trace (atom 0) d (delay (swap! trace inc))] [(identical? d (eval d)) @trace (realized? d)])
(let [e (ex-info "held" {:x 1})] (identical? e (eval e)))
(let [n (the-ns 'user)] (identical? n (eval n)))
(let [a (atom 7)] (try (eval [a]) :accepted (catch :default e :rejected)))
(let [a (atom 7)] (try (eval (list 'quote a)) :accepted (catch :default e :rejected)))
(let [v (eval '(def ^{:macro false} metadata-false 42))] [(contains? (meta v) :macro) (:macro (meta v)) (.isMacro v) @v (identical? v (eval '(var metadata-false)))])
(let [v (eval '(def ^{:macro nil} metadata-nil 43))] [(contains? (meta v) :macro) (:macro (meta v)) (.isMacro v) @v (identical? v (eval '(var metadata-nil)))])
(let [v (eval '(def ^{:macro false} metadata-false-stable 44)) m (meta v)] [(identical? m (meta v)) (identical? m (meta (eval '(var metadata-false-stable)))) (:macro m) (.isMacro v)])
(let [v (eval '(def ^{:macro nil} metadata-nil-stable 45)) m (meta v)] [(identical? m (meta v)) (identical? m (meta (eval '(var metadata-nil-stable)))) (contains? m :macro) (:macro m) (.isMacro v)])
]
