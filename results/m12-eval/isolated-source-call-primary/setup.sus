(defmacro isolated-pass [x] x)
(defmacro isolated-call [f] (list 'quote (f)))
(defmacro isolated-read-var [v] (list 'quote [(var? v) @v (.isMacro v) (:macro (meta v))]))
(defmacro isolated-vars [a b] (list 'quote [(identical? a b) (identical? (meta a) (meta b)) (symbol a)]))
(defmacro isolated-fn-meta [f] (list 'quote [(fn? f) (:tag (meta f)) (f)]))
(defmacro isolated-catch [f] (list 'quote (try (f) (catch :default e [(:tag (ex-data e)) (ex-message e)]))))
(defmacro isolated-precision [f] (with-precision 3 (list 'quote (f))))
(defmacro isolated-change-var [v f] (let [before @v] (f) (list 'quote [before @v (identical? (meta v) (meta v))])))
(defmacro isolated-clear-var [v f] (let [before (.isMacro v)] (f) (list 'quote [before (.isMacro v) (contains? (meta v) :macro)])))
(defmacro isolated-fns [a b] (list 'quote [(identical? a b) (fn? a) (= {:tag :kept} (meta a))]))
(defmacro isolated-form [f] (list 'quote [(identical? (second &form) f) (nil? &env)]))
(defmacro isolated-var-namespace [v] (let [ns (:ns (meta v))] (list 'quote [(ns-name ns) (identical? ns (:ns (meta v))) (contains? (ns-interns ns) 'isolated-ns-value)])))
(defmacro isolated-var-alias [v] (binding [*ns* (:ns (meta v))] (alias 'isolated-forwarded 'user)) (list 'quote :aliased))
(defmacro isolated-remember [f] (eval (list 'def 'isolated-held f)) nil)
(defmacro isolated-recall [] (list 'quote ((eval 'isolated-held))))
