[
(let [f (fn [] 42)] ((eval (list 'when-let ['x f] 'x))))
(let [v #'identity] (identical? v (eval (list 'when-let ['x v] 'x))))
(let [f (fn [] 42)] ((eval (list 'isolated-pass f))))
(let [v #'identity] (identical? v (eval (list 'isolated-pass v))))
(let [trace (atom []) n 41 f (fn [] (swap! trace conj :called) (+ n 1))] [(eval (list 'isolated-call f)) @trace])
(do (declare ^:dynamic isolated-dynamic) (eval '(def ^:dynamic isolated-dynamic 11)) (binding [isolated-dynamic 42] (eval (list 'isolated-read-var #'isolated-dynamic))))
(let [v #'identity] (eval (list 'isolated-vars v v)))
(let [f (with-meta (fn [] 42) {:tag :kept})] (eval (list 'isolated-fn-meta f)))
(let [cell (atom 42) f (fn [] @cell)] (identical? f (eval (list 'isolated-pass f))))
(let [cell (atom 42) f (fn [] @cell)] (try (eval (list 'when-let ['x f] 'x)) :accepted (catch :default e :rejected)))
(let [f (fn [] (eval '(+ 1 41)))] (eval (list 'isolated-call f)))
(let [f (fn [] (throw (ex-info "bridge" {:tag :owned})))] (eval (list 'isolated-catch f)))
(let [f (fn [] (/ 1M 3M))] (eval (list 'isolated-precision f)))
(do (eval '(def isolated-mutable 40)) (let [f (fn [] (eval '(def isolated-mutable 41)))] [(eval (list 'isolated-change-var (eval '(var isolated-mutable)) f)) (eval 'isolated-mutable)]))
(do (eval '(defmacro isolated-cleared [] 1)) (let [f (fn [] (eval '(def isolated-cleared (fn [] 42))))] (eval (list 'isolated-clear-var (eval '(var isolated-cleared)) f))))
(let [f (with-meta (fn [] 42) {:tag :kept})] (eval (list 'isolated-fns f f)))
(let [f (fn [] 42)] (eval (list 'isolated-form f)))
(do (eval '(def isolated-ns-value 42)) (eval (list 'isolated-var-namespace (eval '(var isolated-ns-value)))))
(do (eval (list 'isolated-var-alias (eval '(var isolated-ns-value)))) (contains? (ns-aliases *ns*) 'isolated-forwarded))
(let [f (fn [] 42)] (eval (list 'isolated-remember f)) (eval '(isolated-recall)))
]
