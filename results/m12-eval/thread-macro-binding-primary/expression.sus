[(do (declare thread-macro-a) (let [v (eval '(defmacro ^:dynamic thread-macro-a [] 1))] [(binding [thread-macro-a (fn [& xs] 42)] [(.isMacro v) (eval '(thread-macro-a))]) (eval '(thread-macro-a))]))
(do (declare thread-macro-b) (eval '(defmacro ^:dynamic thread-macro-b [] 1)) (let [events (atom []) f (fn [& xs] (swap! events conj :expanded) (list '+ 40 2))] [(binding [thread-macro-b f] (eval '(thread-macro-b))) @events]))
(do (declare thread-macro-c) (eval '(defmacro ^:dynamic thread-macro-c [] 1)) (binding [thread-macro-c (fn [form env x] (list 'quote [(first form) (contains? env 'lexical-control) x]))] (eval '(let [lexical-control 9] (thread-macro-c (+ 1 2))))))
(do (declare thread-macro-d) (eval '(defmacro ^:dynamic thread-macro-d [] 1)) (binding [thread-macro-d (fn [& xs] (eval '(+ 40 2)))] (eval '(thread-macro-d))))
(do (declare thread-macro-e thread-macro-other) (eval '(defmacro ^:dynamic thread-macro-e [] 1)) (eval '(defmacro thread-macro-other [] 2)) (binding [thread-macro-e @(var thread-macro-other)] (eval '(thread-macro-e))))
(do (declare thread-macro-f) (eval '(defmacro ^:dynamic thread-macro-f [] 1)) (binding [thread-macro-f (fn [& xs] (set! thread-macro-f (fn [& ys] 43)) 42)] (eval '[(thread-macro-f) (thread-macro-f)])))
(do (declare thread-macro-g) (eval '(defmacro ^:dynamic thread-macro-g [] 1)) (let [f (fn [x] x)] (binding [thread-macro-g (fn [& xs] f)] (identical? f (eval '(thread-macro-g))))))
(do (declare thread-macro-h) (eval '(defmacro ^:dynamic thread-macro-h [] 1)) (def thread-value 42) (let [v (var thread-value)] (binding [thread-macro-h (fn [& xs] v)] (identical? v (eval '(thread-macro-h))))))
(do (declare thread-macro-i) (eval '(defmacro ^:dynamic thread-macro-i [] 1)) (let [events (atom [])] [(try (binding [thread-macro-i (fn [& xs] (swap! events conj :before) (throw (ex-info "stop" {})))] (eval '(thread-macro-i))) (catch :default e :error)) @events (eval '(thread-macro-i))]))]
