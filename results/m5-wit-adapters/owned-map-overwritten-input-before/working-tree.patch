+
+#[test]
+fn duplicate_map_keys_release_overwritten_incoming_owners_before_source_receives_the_map() {
+    use wasmtime::component::{ResourceAny, Val};
+    let component = component_with(
+        r#"package test:borrow-boundary@1.0.0;
+        interface store { resource counter { constructor(value: u64); read: func() -> u64; } consume: func(handle: own<counter>) -> u64; }
+        world api { import store; use store.{counter};
+            type table = map<string, own<counter>>;
+            export run: func(entries: table) -> u64;
+        }"#,
+        r#"(ns app)
+        (defn run [entries]
+          (when-not (= 1 (count entries)) (throw "duplicate key was not coalesced"))
+          (let [handle (get entries "same") value (host/read handle)]
+            (suss.resource/close! handle)
+            value))"#,
+        &[("run", "app/run")],
+    );
+    let mut store = Store::new(engine(), State::default());
+    store.set_fuel(100_000_000).unwrap();
+    let live = store.data().live.clone();
+    let instance = linker().instantiate(&mut store, &component).unwrap();
+    let run = instance.get_func(&mut store, "run").unwrap();
+    let mut entries = Vec::new();
+    for value in [1, 9007199254740993] {
+        live.fetch_add(1, Ordering::SeqCst);
+        let owner = store
+            .data_mut()
+            .table
+            .push(Counter {
+                value,
+                live: live.clone(),
+            })
+            .unwrap();
+        let handle = ResourceAny::try_from_resource(owner, &mut store).unwrap();
+        entries.push((Val::String("same".into()), Val::Resource(handle)));
+    }
+    let mut output = [Val::Bool(false)];
+    run.call(&mut store, &[Val::Map(entries)], &mut output)
+        .unwrap();
+    assert_eq!(output, [Val::U64(9007199254740993)]);
+    store.gc(None).unwrap();
+    assert_eq!(
+        live.load(Ordering::SeqCst),
+        0,
+        "the overwritten owner was transferred to the guest but never exposed to Source"
+    );
+    assert_eq!(store.data().canonical_drops, 2);
+    assert_eq!(store.data().reads, 1);
+}
