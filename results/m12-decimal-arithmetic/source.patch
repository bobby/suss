+(defmacro with-precision [precision & body]
+  (let [explicit? (= (first body) :rounding)
+        modes {'UP 0 'DOWN 1 'CEILING 2 'FLOOR 3 'HALF_UP 4
+               'HALF_DOWN 5 'HALF_EVEN 6 'UNNECESSARY 7}
