(ns letfnbench)
(def case-group (fn [n]
  (loop [i 0 acc 0.0]
    (if (< i n)
      (let [x (+ (double i) 0.25)]
        (letfn [(f [k] (if (zero? k) (+ x 1.0) (g (dec k))))
                (g [k] (f k))]
          (recur (inc i) (+ acc (f 1)))))
      acc))))
(def case-direct (fn [n]
  (loop [i 0 acc 0.0]
    (if (< i n)
      (let [x (+ (double i) 0.25)]
        (recur (inc i) (+ acc (+ x 1.0))))
      acc))))
