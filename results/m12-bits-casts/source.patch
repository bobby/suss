+    ("[(byte -127.5) (short -32767.75) (int -2147483647.5) (unchecked-byte 255.5) (unchecked-short 65535.5) (unchecked-int 2147483648.0)]", "[-127 -32767 -2147483647 -1 -1 2147483647]"),
