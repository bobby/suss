+    ("(let [^long x (identity 5.5)] [(bit-not x) (bit-and-not x 1) (bit-shift-left x 1) (try (bit-set x 1) (catch :default e :error)) (try (bit-test x 1) (catch :default e :error))])", "[-6 4 10 :error :error]"),
