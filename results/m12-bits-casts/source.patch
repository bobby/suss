+    ("[(try (bit-not 1.0) (catch :default e :error)) (try (bit-shift-left 1 1.0) (catch :default e :error)) (try (bit-clear 1.0 0) (catch :default e :error)) (try (bit-set 1 1.0) (catch :default e :error))]", "[:error :error :error :error]"),
