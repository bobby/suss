(ns castrebind)
(def ^{:redef true :arglists '(^long [])} cast-long (fn ^long [] (identity 4)))
(def ^{:redef true :arglists '(^double [])} cast-double (fn ^double [] (identity 4.0)))
(def run-long-casts (fn [] [(try (byte (cast-long)) (catch :default e :error)) (try (int (cast-long)) (catch :default e :error)) (try (double (float (cast-long))) (catch :default e :error)) (try (double (unchecked-float (cast-long))) (catch :default e :error))]))
(def run-double-casts (fn [] [(try (byte (cast-double)) (catch :default e :error)) (try (int (cast-double)) (catch :default e :error)) (try (double (float (cast-double))) (catch :default e :error)) (try (double (unchecked-float (cast-double))) (catch :default e :error))]))
(def case0 (fn [] (if (= (pr-str (with-redefs [cast-long (fn [] (identity 1.2))] (run-long-casts))) "[1 1 1.2000000476837158 1.2000000476837158]") 1 0)))
(def case1 (fn [] (if (= (pr-str (with-redefs [cast-long (fn [] nil)] (run-long-casts))) "[:error :error :error :error]") 1 0)))
(def case2 (fn [] (if (= (pr-str (with-redefs [cast-long (fn [] (identity 1.0E300))] (run-long-casts))) "[:error :error :error ##Inf]") 1 0)))
(def case3 (fn [] (if (= (pr-str (with-redefs [cast-double (fn [] (identity 18014399583223809))] (let [xs (run-double-casts)] [(nth xs 0) (nth xs 1) (== (nth xs 2) 1.8014398509481984E16) (== (nth xs 3) 1.8014400656965632E16)]))) "[:error :error true true]") 1 0)))
